#!/usr/bin/env python3
"""
hv - Hive Mind CLI

Institutional memory for multiple AI agents.
"""

import argparse
import json
import sqlite3
import sys
from datetime import datetime
from pathlib import Path
import os

HIVE_HOME = Path(os.environ.get("HIVE_HOME", Path.home() / "projects" / "hive-mind"))
DB_PATH = HIVE_HOME / "store.db"
JOURNAL_DIR = HIVE_HOME / "journal"

def init_db():
    """Initialize database schema"""
    HIVE_HOME.mkdir(parents=True, exist_ok=True)
    JOURNAL_DIR.mkdir(exist_ok=True)
    
    conn = sqlite3.connect(DB_PATH)
    conn.executescript("""
    CREATE TABLE IF NOT EXISTS facts (
        id INTEGER PRIMARY KEY,
        content TEXT NOT NULL,
        tags TEXT,
        importance REAL DEFAULT 0.5,
        source_agent TEXT NOT NULL,
        source_session TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        trust_score REAL DEFAULT 1.0,
        last_accessed TIMESTAMP,
        access_count INTEGER DEFAULT 0
    );
    
    CREATE TABLE IF NOT EXISTS decisions (
        id INTEGER PRIMARY KEY,
        content TEXT NOT NULL,
        rationale TEXT,
        superseded_by INTEGER REFERENCES decisions(id),
        source_agent TEXT NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    );
    
    CREATE INDEX IF NOT EXISTS idx_facts_tags ON facts(tags);
    CREATE INDEX IF NOT EXISTS idx_facts_source ON facts(source_agent, created_at);
    CREATE INDEX IF NOT EXISTS idx_facts_trust ON facts(trust_score);
    CREATE INDEX IF NOT EXISTS idx_decisions_active ON decisions(id) WHERE superseded_by IS NULL;

    CREATE TABLE IF NOT EXISTS entities (
        id INTEGER PRIMARY KEY,
        name TEXT NOT NULL UNIQUE,
        type TEXT, -- person, project, concept
        attributes TEXT, -- JSON
        first_seen TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        last_updated TIMESTAMP
    );

    CREATE TABLE IF NOT EXISTS entity_facts (
        entity_id INTEGER REFERENCES entities(id),
        fact_id INTEGER REFERENCES facts(id),
        confidence REAL DEFAULT 1.0,
        PRIMARY KEY (entity_id, fact_id)
    );

    CREATE INDEX IF NOT EXISTS idx_entities_name ON entities(name);
    CREATE INDEX IF NOT EXISTS idx_entities_type ON entities(type);
    """)
    conn.commit()
    conn.close()

def write_journal(operation, data):
    """Append to today's journal"""
    today = datetime.now().strftime("%Y-%m-%d")
    journal_path = JOURNAL_DIR / f"{today}.jsonl"
    
    entry = {
        "ts": datetime.now().isoformat(),
        "agent": os.environ.get("HERMES_AGENT", "manual"),
        "op": operation,
        "data": data
    }
    
    with open(journal_path, "a") as f:
        f.write(json.dumps(entry) + "\n")

def remember(args):
    """Store a fact (with dedup — boosts trust if identical content exists)"""
    data = {
        "content": args.content,
        "tags": args.tags.split(",") if args.tags else [],
        "importance": args.importance,
        "source": args.source or os.environ.get("HERMES_AGENT", "manual")
    }

    write_journal("remember", data)

    # Immediately write to DB (in real system, this would be async)
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    # Dedup: check for existing fact with identical content
    cursor.execute("SELECT id, trust_score, access_count FROM facts WHERE content = ?",
                   (data["content"],))
    existing = cursor.fetchone()

    if existing:
        # Boost trust instead of duplicating
        new_trust = min(existing[1] + 0.1, 2.0)
        cursor.execute(
            "UPDATE facts SET trust_score = ?, access_count = access_count + 1, last_accessed = ? WHERE id = ?",
            (new_trust, datetime.now().isoformat(), existing[0])
        )
        conn.commit()
        conn.close()
        print(f"Already known (fact #{existing[0]}), trust boosted to {new_trust:.2f}")
    else:
        cursor.execute("""
            INSERT INTO facts (content, tags, importance, source_agent)
            VALUES (?, ?, ?, ?)
        """, (data["content"], json.dumps(data["tags"]), data["importance"], data["source"]))
        conn.commit()
        fact_id = cursor.lastrowid
        conn.close()
        print(f"Remembered as fact #{fact_id}")

def search(args):
    """Search facts"""
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    
    # Simple substring search for MVP
    query = f"%{args.query}%"
    results = conn.execute("""
        SELECT id, content, tags, trust_score, source_agent, created_at
        FROM facts
        WHERE content LIKE ?
        ORDER BY trust_score DESC, created_at DESC
        LIMIT 10
    """, (query,)).fetchall()
    
    if args.format == "json":
        data = [dict(r) for r in results]
        print(json.dumps(data, indent=2))
    else:
        for r in results:
            tags = json.loads(r["tags"]) if r["tags"] else []
            print(f"[{r['id']}] {r['content']}")
            print(f"     Tags: {', '.join(tags)}  Trust: {r['trust_score']:.2f}  From: {r['source_agent']}")
            print()
    
    conn.close()

def decide(args):
    """Record a decision"""
    data = {
        "content": args.content,
        "rationale": args.rationale,
        "supersedes": args.supersedes,
        "source": os.environ.get("HERMES_AGENT", "manual")
    }
    
    write_journal("decide", data)

    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    # Mark old decision as superseded
    if args.supersedes:
        cursor.execute("UPDATE decisions SET superseded_by = ? WHERE id = ?",
                    (args.supersedes, args.supersedes))

    cursor.execute("""
        INSERT INTO decisions (content, rationale, source_agent)
        VALUES (?, ?, ?)
    """, (data["content"], data["rationale"], data["source"]))
    conn.commit()
    decision_id = cursor.lastrowid
    conn.close()
    
    print(f"Decided as decision #{decision_id}")

def sync_push(args):
    """Push local changes to remote hive"""
    import requests
    
    # Get recent entries from journal
    journal_path = JOURNAL_DIR / f"{datetime.now().strftime('%Y-%m-%d')}.jsonl"
    if not journal_path.exists():
        print("No entries to sync today")
        return
    
    with open(journal_path, 'r') as f:
        entries = [json.loads(line) for line in f]
    
    # Send to remote
    try:
        response = requests.post(f"{args.remote}/api/sync/receive", json={"entries": entries})
        if response.status_code == 200:
            print(f"Synced {len(entries)} entries to {args.remote}")
        else:
            print(f"Sync failed: {response.status_code}")
    except Exception as e:
        print(f"Sync error: {e}")

def sync_pull(args):
    """Pull remote changes to local hive"""
    import requests
    
    try:
        response = requests.get(f"{args.remote}/api/sync/entries")
        if response.status_code == 200:
            remote_entries = response.json().get("entries", [])
            
            # Process each entry
            for entry in remote_entries:
                if entry["op"] == "remember":
                    data = entry["data"]
                    # Store in local DB if newer
                    conn = sqlite3.connect(DB_PATH)
                    conn.execute("""
                        INSERT OR REPLACE INTO facts (content, tags, importance, source_agent, created_at)
                        VALUES (?, ?, ?, ?, ?)
                    """, (data["content"], json.dumps(data["tags"]), data["importance"], 
                          data["source"], entry["ts"]))
                    conn.commit()
                    conn.close()
            
            print(f"Pulled {len(remote_entries)} entries from {args.remote}")
        else:
            print(f"Pull failed: {response.status_code}")
    except Exception as e:
        print(f"Pull error: {e}")

def entity(args):
    """Register or query an entity"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    if args.action == "add":
        attrs = json.dumps(json.loads(args.attr)) if args.attr else "{}"
        cursor.execute("""
            INSERT INTO entities (name, type, attributes)
            VALUES (?, ?, ?)
            ON CONFLICT(name) DO UPDATE SET type=excluded.type, attributes=excluded.attributes, last_updated=CURRENT_TIMESTAMP
        """, (args.name, args.type or "unknown", attrs))
        conn.commit()
        eid = cursor.lastrowid or cursor.execute(
            "SELECT id FROM entities WHERE name = ?", (args.name,)).fetchone()[0]
        conn.close()
        print(f"Entity #{eid}: {args.name} ({args.type or 'unknown'})")

    elif args.action == "list":
        rows = conn.execute("SELECT id, name, type, attributes, first_seen FROM entities ORDER BY name").fetchall()
        if not rows:
            print("No entities registered.")
        for r in rows:
            print(f"  [{r[0]}] {r[1]} ({r[2]})  since {r[4]}")
        conn.close()

    elif args.action == "show":
        cursor.execute("SELECT id, name, type, attributes, first_seen, last_updated FROM entities WHERE name = ?", (args.name,))
        row = cursor.fetchone()
        if not row:
            print(f"No entity named '{args.name}'")
            conn.close()
            return
        print(f"Entity #{row[0]}: {row[1]} ({row[2]})")
        print(f"  Attributes: {row[3]}")
        print(f"  First seen: {row[4]}  Last updated: {row[5]}")
        # Show linked facts
        cursor.execute("""
            SELECT f.id, f.content, ef.confidence
            FROM entity_facts ef JOIN facts f ON f.id = ef.fact_id
            WHERE ef.entity_id = ? ORDER BY ef.confidence DESC
        """, (row[0],))
        linked = cursor.fetchall()
        if linked:
            print(f"  Linked facts ({len(linked)}):")
            for lf in linked:
                print(f"    [{lf[0]}] {lf[1][:60]} (conf={lf[2]:.2f})")
        conn.close()

    elif args.action == "link":
        # Link a fact to this entity: hv entity link --name X --fact-id N
        cursor.execute("SELECT id FROM entities WHERE name = ?", (args.name,))
        erow = cursor.fetchone()
        if not erow:
            print(f"No entity named '{args.name}'")
            conn.close()
            return
        cursor.execute("""
            INSERT OR REPLACE INTO entity_facts (entity_id, fact_id, confidence)
            VALUES (?, ?, ?)
        """, (erow[0], args.fact_id, args.confidence or 1.0))
        conn.commit()
        conn.close()
        print(f"Linked fact #{args.fact_id} → entity '{args.name}'")


def stats(args):
    """Show memory usage stats"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    facts = cursor.execute("SELECT count(*) FROM facts").fetchone()[0]
    decisions = cursor.execute("SELECT count(*) FROM decisions").fetchone()[0]
    active_decisions = cursor.execute("SELECT count(*) FROM decisions WHERE superseded_by IS NULL").fetchone()[0]

    # entities table may not exist yet (pre-migration)
    try:
        entities = cursor.execute("SELECT count(*) FROM entities").fetchone()[0]
    except sqlite3.OperationalError:
        entities = 0

    try:
        links = cursor.execute("SELECT count(*) FROM entity_facts").fetchone()[0]
    except sqlite3.OperationalError:
        links = 0

    avg_trust = cursor.execute("SELECT round(avg(trust_score), 2) FROM facts").fetchone()[0] or 0
    top_tags = cursor.execute("""
        SELECT tags, count(*) as cnt FROM facts WHERE tags IS NOT NULL GROUP BY tags ORDER BY cnt DESC LIMIT 5
    """).fetchall()

    # Journal stats
    journal_files = sorted(JOURNAL_DIR.glob("*.jsonl")) if JOURNAL_DIR.exists() else []
    total_entries = 0
    for jf in journal_files:
        total_entries += sum(1 for _ in open(jf))

    conn.close()

    print(f"Hive Mind Stats — {HIVE_HOME}")
    print(f"  Facts:              {facts}  (avg trust: {avg_trust})")
    print(f"  Decisions:          {decisions}  ({active_decisions} active)")
    print(f"  Entities:           {entities}  ({links} fact-links)")
    print(f"  Journal entries:    {total_entries} across {len(journal_files)} days")
    if top_tags:
        print(f"  Top tag groups:")
        for t in top_tags:
            print(f"    ({t[0]}) x {t[1]}")


def main():
    parser = argparse.ArgumentParser(description="Hive Mind CLI")
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # remember command
    remember_parser = subparsers.add_parser("remember", help="Store a fact")
    remember_parser.add_argument("content", help="Fact content")
    remember_parser.add_argument("--tags", help="Comma-separated tags")
    remember_parser.add_argument("--importance", type=float, default=0.5)
    remember_parser.add_argument("--source", help="Source agent")

    # search command
    search_parser = subparsers.add_parser("search", help="Search facts")
    search_parser.add_argument("query", help="Search query")
    search_parser.add_argument("--format", choices=["text", "json"], default="text")

    # decide command
    decide_parser = subparsers.add_parser("decide", help="Record a decision")
    decide_parser.add_argument("content", help="Decision content")
    decide_parser.add_argument("--rationale", help="Why this decision")
    decide_parser.add_argument("--supersedes", type=int, help="ID of decision this replaces")

    # entity command
    entity_parser = subparsers.add_parser("entity", help="Manage entities")
    entity_parser.add_argument("action", choices=["add", "list", "show", "link"], help="Sub-command")
    entity_parser.add_argument("--name", help="Entity name")
    entity_parser.add_argument("--type", help="Entity type (person, project, concept)")
    entity_parser.add_argument("--attr", help="JSON attributes")
    entity_parser.add_argument("--fact-id", type=int, help="Fact ID to link")
    entity_parser.add_argument("--confidence", type=float, help="Link confidence")

    # stats command
    subparsers.add_parser("stats", help="Show memory usage stats")

    # sync commands
    sync_parser = subparsers.add_parser("sync", help="Sync with remote hive")
    sync_subparsers = sync_parser.add_subparsers(dest="sync_action")

    push_parser = sync_subparsers.add_parser("push", help="Push to remote")
    push_parser.add_argument("remote", help="Remote hive URL (e.g., http://100.64.1.2:8000)")

    pull_parser = sync_subparsers.add_parser("pull", help="Pull from remote")
    pull_parser.add_argument("remote", help="Remote hive URL (e.g., http://100.64.1.2:8000)")

    args = parser.parse_args()

    # Always run init_db — CREATE TABLE IF NOT EXISTS is idempotent,
    # and it auto-migrates older DBs that are missing entities/entity_facts.
    init_db()

    # Dispatch command
    if args.command == "remember":
        remember(args)
    elif args.command == "search":
        search(args)
    elif args.command == "decide":
        decide(args)
    elif args.command == "entity":
        entity(args)
    elif args.command == "stats":
        stats(args)
    elif args.command == "sync":
        if args.sync_action == "push":
            sync_push(args)
        elif args.sync_action == "pull":
            sync_pull(args)
        else:
            sync_parser.print_help()
    else:
        parser.print_help()

if __name__ == "__main__":
    main()