def api_peers(probe=True):
    """Admitted devices for the dashboard Hive tab: name, device, principal, address, last-seen,
    status. Names/addresses/sync-status are resolved by a bounded concurrent live probe (so a
    directly-admitted peer like gregorius still shows a real name/address); unreachable peers fall
    back to their join-request label/URL and last-seen staleness. Read-only; never mutates."""
    entries = merkle.read_all_entries(JOURNAL_DIR)
    gov = _governance_state(entries)
    last_seen = {}
    for e in entries:
        d, ts = e.get("node_id"), e.get("timestamp", "")
        if d and ts > last_seen.get(d, ""):
            last_seen[d] = ts
    probed = _probe_peer_map_cached() if probe else {}
    out = []
    for d in sorted(gov.get("admitted") or set()):
        prin = gov["principals"].get(d) or "?"
        seen = (last_seen.get(d, "")[:10]) or "—"
        age = _age_days(last_seen.get(d, ""))
        short = (d[:11] + "…") if len(d) > 12 else d
        if d == NODE_ID:
            name, addr, status = NODE_LABEL, (_self_address() or "—"), "self"
        elif d in probed:
            paddr, pst, plbl = probed[d]
            name = plbl or _join_request_label(d) or short
            addr, status = paddr, pst
        else:
            name = _join_request_label(d) or short
            url = _join_request_url(d)
            addr = url.rstrip("/").replace("http://", "").replace("https://", "") if url else "—"
            status = "stale" if (age is not None and age > 14) else "offline"
        out.append({"name": name, "device": d, "principal": prin,
                    "addr": addr, "seen": seen, "status": status, "self": d == NODE_ID})
    return out


def dash(args):
    """Print the read-only web dashboard URL(s) the sync daemon serves, and (unless --print) try to
    open a browser. The daemon serves the SPA + /api/* on its sync port, so the dashboard is reachable
    wherever sync is — localhost always, plus the tailnet IP for viewing from another device."""
    port = _self_sync_port()
    local = f"http://127.0.0.1:{port}/"
    ip = _self_tailnet_ip()
    tnet = f"http://{ip}:{port}/" if ip else ""
    up = False
    try:
        import urllib.request
        urllib.request.urlopen(f"http://127.0.0.1:{port}/sync/hello", timeout=2)
        up = True
    except Exception:
        up = False
    print("HiveMind dashboard")
    print(f"  Local:    {local}")
    if tnet:
        print(f"  Tailnet:  {tnet}  (open on any device on your tailnet)")
    if not up:
        print("\n  ⚠ The sync daemon isn't answering on this port — the dashboard won't load yet.")
        print("    Check it with `hive-mind status`, then retry `hv dash`.")
        return
    if getattr(args, "print_only", False):
        return
    import shutil
    opener = next(([c] for c in ("termux-open-url", "xdg-open", "open") if shutil.which(c)), None)
    if opener:
        try:
            subprocess.Popen(opener + [local], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print("\n  Opening in your browser…")
            return
        except Exception:
            pass
    print("\n  (Couldn't auto-open a browser — open the Local URL above.)")


def entity(args):
    """Register or query an entity."""
    if args.action == "add":
        attrs = json.loads(args.attr) if args.attr else {}
        payload = {"name": args.name, "type": args.type or "unknown", "attributes": attrs}
        entry = append_journal("entity", payload)
        conn = get_conn()
        res = persist_entity(conn, entry)
        conn.commit()
        conn.close()
        print(f"Entity #{res['id']}: {res['name']} ({res['type']})")
        return

    if args.action == "link":
        # Link a fact to this entity: hv entity link --name X --fact-id N
        conn = get_conn()
        erow = conn.execute("SELECT id FROM entities WHERE name = ?", (args.name,)).fetchone()
        if not erow:
            print(f"No entity named '{args.name}'")
            conn.close()
            return
        entity_ref = _index_lookup(conn, "entity", erow["id"])
        fact_ref = _index_lookup(conn, "fact", args.fact_id)
        if fact_ref is None:
            print(f"No fact #{args.fact_id}")
            conn.close()
            return
        payload = {
            "entity_ref": entity_ref,
            "fact_ref": fact_ref,
            "confidence": args.confidence if args.confidence is not None else 1.0,
        }
        entry = append_journal("entity_fact", payload)
        resolve_entity_fact(conn, entry)
        conn.commit()
        conn.close()
        print(f"Linked fact #{args.fact_id} → entity '{args.name}'")
        return

    # Read-only actions
    conn = get_conn()
    if args.action == "list":
        rows = conn.execute(
            "SELECT id, name, type, attributes, first_seen FROM entities ORDER BY name"
        ).fetchall()
        if not rows:
            print("No entities registered.")
        for r in rows:
            print(f"  [{r['id']}] {r['name']} ({r['type']})  since {r['first_seen']}")
        conn.close()

    elif args.action == "show":
        row = conn.execute(
            "SELECT id, name, type, attributes, first_seen, last_updated FROM entities WHERE name = ?",
            (args.name,),
        ).fetchone()
        if not row:
            print(f"No entity named '{args.name}'")
            conn.close()
            return
        print(f"Entity #{row['id']}: {row['name']} ({row['type']})")
        print(f"  Attributes: {row['attributes']}")
        print(f"  First seen: {row['first_seen']}  Last updated: {row['last_updated']}")
        linked = conn.execute("""
            SELECT f.id, f.content, ef.confidence
            FROM entity_facts ef JOIN facts f ON f.id = ef.fact_id
            WHERE ef.entity_id = ? ORDER BY ef.confidence DESC
        """, (row["id"],)).fetchall()
        if linked:
            print(f"  Linked facts ({len(linked)}):")
            for lf in linked:
                print(f"    [{lf['id']}] {lf['content'][:60]} (conf={lf['confidence']:.2f})")
        conn.close()


def rebuild_db():
    """Rebuild SQLite entirely from the journal. Two-pass so cross-row links
    resolve regardless of journal order. Returns a counts dict."""
    init_db()
    conn = get_conn()
    # Drop the FTS index + triggers first: deleting every content row through
    # the external-content delete triggers can desync FTS5 ("disk image is
    # malformed"). We recreate and backfill the index after replay instead.
    conn.executescript("""
        DROP TRIGGER IF EXISTS facts_ai;
        DROP TRIGGER IF EXISTS facts_ad;
        DROP TRIGGER IF EXISTS facts_au;
        DROP TABLE IF EXISTS facts_fts;
        DELETE FROM entity_facts;
        DELETE FROM facts;
        DELETE FROM decisions;
        DELETE FROM entities;
        DELETE FROM journal_index;
    """)
    conn.commit()

    entries = merkle.read_all_entries(JOURNAL_DIR)
    # Pass 1: row-producing entries (records journal_index).
    for entry in entries:
        if entry["type"] in _PASS1:
            persist_entry(conn, entry)
    conn.commit()
    # Pass 2: cross-row links.
    for entry in entries:
        if entry["type"] == "entity_fact":
            resolve_entity_fact(conn, entry)
        elif entry["type"] == "decision" and (
            entry["payload"].get("supersedes_ref") or entry["payload"].get("supersedes")
        ):
            resolve_supersedes(conn, entry)
        elif entry["type"] == "fact" and entry["payload"].get("resolves_ref"):
            resolve_resolves(conn, entry)
    conn.commit()

    # Phase A: confidence is a derived projection over the journal — recompute it
    # here so every node converges to identical values over the same journal.
    _recompute_confidence(conn, entries)
    conn.commit()

    _init_fts(conn)  # recreate FTS table + triggers and backfill from facts
    conn.commit()

    counts = {
        "entries": len(entries),
        "facts": conn.execute("SELECT count(*) FROM facts").fetchone()[0],
        "decisions": conn.execute("SELECT count(*) FROM decisions").fetchone()[0],
        "entities": conn.execute("SELECT count(*) FROM entities").fetchone()[0],
        "links": conn.execute("SELECT count(*) FROM entity_facts").fetchone()[0],
    }
    conn.close()
    return counts


def rebuild(args):
    c = rebuild_db()
    print(f"Rebuilt from {c['entries']} journal entries:")
    print(f"  Facts: {c['facts']}  Decisions: {c['decisions']}  "
          f"Entities: {c['entities']}  Links: {c['links']}")


