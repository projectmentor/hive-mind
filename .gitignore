# Runtime data (per-machine, not versioned). store.db-* covers SQLite's side files
# (store.db-wal and store.db-shm in WAL mode, store.db-journal otherwise): they hold hive content.
store.db
store.db-*
journal/*.jsonl

# Migration / pre-Phase-1 backups (per-machine, not versioned)
journal.bak.*/
store.db.bak.*

# Peer registry is per-node, not versioned (use config/.peers.json.example as a template)
.peers.json
# Where the daemon verified each peer's device from (#7): per-node, never synced; names devices and IPs.
.peer_candidates.json
# The temp file an atomic rewrite of either goes through, should a crash leave one behind.
.peers.json.*.tmp
.peer_candidates.json.*.tmp

# Device identity (per-node Ed25519 key). The seed is SECRET — never commit or sync it.
.device-key
.device-id

# Governance owner key (Ed25519 root of trust). SECRET — never commit or sync it.
.owner-key
# Exported owner-key backups (`hv owner export`, default name hive-owner-<id>.key). SECRET.
hive-owner-*.key

# Genesis pin (hive-mind-private #14): the one `owner` act this node accepted. Per-node, like the
# device key — never committed, never synced, never in the signed source manifest.
.genesis-pin

# Nudge config + per-session debounce state (per-node; use config/nudge.env.example as a template)
nudge.env
.nudge_state/

# Telemetry is a LOCAL-ONLY observability lane (per-node; never synced, never in the corpus)
.telemetry/

# Local, non-journaled bus log ($HIVE_HOME/.bus/introspect.log: idea-arrived lines today). Per-node and
# never synced, but it names hive entries and devices. *.log catches any other log written into the
# checkout (daemon output redirected here, a future trace sink).
.bus/
*.log

# Cells are per-node wiring runbooks that can carry PRIVATE infra details (account/site ids, internal
# refs). Keep live cells out of the (public) repo; only the dummy example-*.json reference is tracked.
# Distribute real cells through the journal (`hv wire --add`), not source control.
cells/*.json
!cells/example-*.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.env
.pytest_cache/

# Editor swap/backup files
*.swp
*.swo
*~
.*.swp
