# Hive Mind nudge/audit config. Copy to nudge.env (gitignored) and tune per node.
# Read by `hv nudge` and `hv audit`. All keys optional; defaults shown.
# Same-named environment variables OVERRIDE this file.

# --- save-nudge (fires on UserPromptSubmit, debounced) ---
SAVE_EVERY=12          # nudge to consider saving every N user turns (0 = off)
MIN_GAP=6              # hard floor: never emit two save-nudges within N turns
SAVE_ON_PHRASE=1       # 1 = a matched phrase may trigger a save-nudge (still gated by MIN_GAP)

# --- audit-nudge (fires on PreCompact / SessionEnd) ---
AUDIT_ON=precompact,sessionend   # events that emit an audit-nudge (csv); empty = off
AUDIT_DEPTH=light                # light | normal | deep (caps results + FTS fan-out)

# --- volatile (time-varying) facts ---
# Tag operational/state facts that can flip — "service running", "host reachable" — with
# `volatile` (optionally `ttl:<n>h` or `ttl:<n>d` for a custom window). `hv audit` surfaces
# them in a RECHECK bucket once past their freshness window, so you re-verify just those —
# not the whole corpus. Re-verifying a volatile fact refreshes it (never flagged redundant).
VOLATILE_TTL_HOURS=24            # default freshness window for `volatile` facts (hours)

# --- watch phrases (comma-separated, case-insensitive substring match) ---
# Seeds BOOTSTRAPPED from real session history via scripts/infer-phrases.py
# (re-run it anytime to refresh from your latest sessions).
HIVE_NUDGE_PHRASES=we need,we should,i want,idea,wait,before we,keep,remember,decision,the issue,lesson,wrong

# Seed bank — real-but-lower-frequency; promote into the line above as they prove useful:
# important,the problem,turns out,verify,confirm,private,genuinely,real,actual,i like,i prefer,
# one more thing,last thing,we definitely,make sure,note that,heads up,good catch
#
# NOTE: explicit save commands ("save", "save state", "hive it", "keep that") mean the agent
# should just SAVE — they don't belong here as mere nudge triggers.
