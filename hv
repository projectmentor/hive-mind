# Device identity (Phase D-identity). A node is identified by an Ed25519 DEVICE KEY, not a
# self-declared hostname. device_id = "k1:" + first 16 hex of sha256(pubkey); the 32-byte seed
# lives at HIVE_HOME/.device-key (0600, never synced, never in the source manifest), and the
# derived fingerprint is cached at .device-id so resolving NODE_ID stays a cheap file read.
# Journal entries are signed by the device key and verified on ingest, so a peer cannot forge
# another node's identity to launder corroboration. A key is minted only by `hv key init` or the
# migration — importing hv NEVER creates one, so a legacy hostname node keeps its identity until
# it is deliberately migrated. HIVE_NODE_ID still overrides (tests / two instances on one box).
NODE_LABEL = os.environ.get("HIVE_NODE_LABEL", socket.gethostname())
DEVICE_KEY_PATH = HIVE_HOME / ".device-key"
DEVICE_ID_PATH = HIVE_HOME / ".device-id"


def _device_seed():
    """The 32-byte device seed if this device has a key, else None. Read-only; never creates."""
    try:
        if _ed25519 is None or not DEVICE_KEY_PATH.exists():
            return None
        seed = base64.b64decode(DEVICE_KEY_PATH.read_text().strip())
        return seed if len(seed) == 32 else None
    except Exception:
        return None


def _device_id_for_pub(pub):
    """Stable, collision-safe device fingerprint: 'k1:' + first 16 hex of sha256(pubkey)."""
    return "k1:" + hashlib.sha256(pub).hexdigest()[:16]


def _resolve_node_id():
    """HIVE_NODE_ID override, else the cached device fingerprint (or one derived from the seed),
    else the hostname (legacy, pre-migration)."""
    env = os.environ.get("HIVE_NODE_ID")
    if env:
        return env
    try:
        if DEVICE_ID_PATH.exists():
            did = DEVICE_ID_PATH.read_text().strip()
            if did:
                return did
    except Exception:
        pass
    seed = _device_seed()
    if seed is not None:
        return _device_id_for_pub(_ed25519.pub_from_seed(seed))
    return socket.gethostname()


NODE_ID = _resolve_node_id()


# Owner identity (governance root). A separate Ed25519 key, distinct from the device key, is the
# root of trust for governance: it admits devices, tags their principal, and sets tunable confidence
# parameters. Those declarations are JOURNALED as owner-signed `governance` entries, so every node
# derives the same admitted set / principal map / config and confidence stays identical across nodes
# (the convergence invariant). Minted only by `hv owner init`; importing hv never creates it.
OWNER_KEY_PATH = HIVE_HOME / ".owner-key"


def _owner_seed():
    """The 32-byte owner seed if this device holds the owner key, else None. Read-only; never creates."""
    try:
        if _ed25519 is None or not OWNER_KEY_PATH.exists():
            return None
        seed = base64.b64decode(OWNER_KEY_PATH.read_text().strip())
        return seed if len(seed) == 32 else None
    except Exception:
        return None


def _owner_id_for_pub(pub):
    """Owner fingerprint: 'o1:' + first 16 hex of sha256(pubkey)."""
    return "o1:" + hashlib.sha256(pub).hexdigest()[:16]


def _canon_pub(b64):
    """Canonical base64 of a 32-byte ed25519 public key, or None if it isn't one. Used so a
    nomination's `successor_owner_pub` and a claim's embedded `owner_pub` compare as strings
    regardless of base64 whitespace/padding differences."""
    try:
        raw = base64.b64decode(b64)
        return base64.b64encode(raw).decode() if len(raw) == 32 else None
    except Exception:
        return None


def _kdf_keystream(key, nbytes):
    """SHA-256 CTR keystream: block_i = sha256(key || be64(counter)). Stdlib-only stream cipher."""
    out = bytearray()
    counter = 0
    while len(out) < nbytes:
        out += hashlib.sha256(key + counter.to_bytes(8, "big")).digest()
        counter += 1
    return bytes(out[:nbytes])


def _owner_seal(seed, passphrase):
    """Encrypt the 32-byte owner seed under a passphrase: scrypt KDF → SHA-256-CTR keystream,
    encrypt-then-MAC (HMAC-SHA256). No block cipher needed (none in stdlib). Returns the envelope."""
    salt = os.urandom(16)
    n, r, p = 1 << 15, 8, 1
    dk = hashlib.scrypt(passphrase.encode(), salt=salt, n=n, r=r, p=p, dklen=64, maxmem=128 * 1024 * 1024)
    kenc, kmac = dk[:32], dk[32:]
    ct = bytes(a ^ b for a, b in zip(seed, _kdf_keystream(kenc, len(seed))))
    tag = hmac.new(kmac, salt + ct, hashlib.sha256).digest()
    return {"enc": "scrypt-ctr-hmac-v1", "n": n, "r": r, "p": p,
            "salt": base64.b64encode(salt).decode(),
            "ct": base64.b64encode(ct).decode(),
            "tag": base64.b64encode(tag).decode()}


def _owner_unseal(env, passphrase):
    """Decrypt an owner-seed envelope; verify the HMAC tag (constant-time) before releasing the
    seed. Raises ValueError on a wrong passphrase / tampering."""
    salt, ct, tag = (base64.b64decode(env[k]) for k in ("salt", "ct", "tag"))
    dk = hashlib.scrypt(passphrase.encode(), salt=salt, n=int(env["n"]), r=int(env["r"]),
                        p=int(env["p"]), dklen=64, maxmem=128 * 1024 * 1024)
    kenc, kmac = dk[:32], dk[32:]
    if not hmac.compare_digest(tag, hmac.new(kmac, salt + ct, hashlib.sha256).digest()):
        raise ValueError("wrong passphrase or corrupted file")
    return bytes(a ^ b for a, b in zip(ct, _kdf_keystream(kenc, len(ct))))


def _read_passphrase(prompt, confirm=False):
    """Read a passphrase from $HIVE_OWNER_PASSPHRASE if set (automation/tests; empty = cancel), else
    prompt on the tty. Returns the passphrase, or None to CANCEL — a blank line, Ctrl-C, Ctrl-D, or a
    confirmation mismatch all bail out (so the user can change their mind at the prompt)."""
    env = os.environ.get("HIVE_OWNER_PASSPHRASE")
    if env is not None:
        return env or None           # set => use it; empty => cancel
    import getpass
    try:
        pw = getpass.getpass(prompt)
        if not pw:                   # blank line = bail out
            return None
        if confirm and pw != getpass.getpass("Confirm passphrase: "):
            print("Passphrases do not match.")
            return None
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    return pw


def _stash_owner_key(seed):
    """Best-effort backup of the owner seed to the stable identity stash (survives uninstall; same
    location as the installer's keep_identity_save). Returns the path written, or None."""
    try:
        d = Path(os.environ.get("HIVE_IDENTITY_STASH", Path.home() / ".config" / "hive-mind" / "identity"))
        d.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(d, 0o700)
        except Exception:
            pass
        f = d / ".owner-key"
        f.write_text(base64.b64encode(seed).decode() + "\n")
        try:
            os.chmod(f, 0o600)
        except Exception:
            pass
        return str(f)
    except Exception:
        return None

