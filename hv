def _now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def _canonical(obj):
    """Stable bytes for hashing — must match merkle._canonical."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":")).encode()


def compute_hash(entry):
    return "sha256:" + hashlib.sha256(_canonical(entry)).hexdigest()


def _entry_signing_bytes(entry):
    """Canonical bytes a device signature covers: the whole entry except the signature itself.
    `pub` IS covered, so the signing key is bound into what's signed. The hash chain
    (compute_hash) commits to the full entry including `sig`."""
    return _canonical({k: v for k, v in entry.items() if k != "sig"})


def _sign_entry(entry, seed, pub):
    """Attach `pub` (b64 signer key) then `sig` (b64 signature over the entry sans sig)."""
    entry["pub"] = base64.b64encode(pub).decode()
    entry["sig"] = base64.b64encode(_ed25519.sign(_entry_signing_bytes(entry), seed)).decode()
    return entry


def _verify_entry(entry):
    """A SIGNED entry is valid iff its node_id is the fingerprint of its embedded pub and the
    signature checks out — so no one can attribute an entry to a device_id they don't hold the
    key for. UNSIGNED entries return True (grandfathered: pre-migration history, legacy peers)."""
    if "sig" not in entry:
        return True
    if _ed25519 is None:
        return True   # a stripped build can't verify; don't reject on that alone
    try:
        pub = base64.b64decode(entry.get("pub", ""))
        sig = base64.b64decode(entry["sig"])
        if len(pub) != 32 or entry.get("node_id") != _device_id_for_pub(pub):
            return False
        return _ed25519.verify(_entry_signing_bytes(entry), sig, pub)
    except Exception:
        return False


def _sign_governance_payload(payload, owner_seed, owner_pub):
    """Attach `owner_pub` then `owner_sig` (the owner's signature over the payload sans owner_sig).
    This authorizes the governance ACTION independently of which device appends the entry."""
    payload = dict(payload)
    payload["owner_pub"] = base64.b64encode(owner_pub).decode()
    body = _canonical({k: v for k, v in payload.items() if k != "owner_sig"})
    payload["owner_sig"] = base64.b64encode(_ed25519.sign(body, owner_seed)).decode()
    return payload


def _verify_governance(payload):
    """Return the owner_id that signed this governance payload (verified), or None if the owner
    signature is missing/invalid. The signer is the fingerprint of the embedded owner_pub, so an
    action can only be attributed to an owner key it was actually signed with."""
    if _ed25519 is None:
        return None
    try:
        owner_pub = base64.b64decode(payload.get("owner_pub", ""))
        owner_sig = base64.b64decode(payload.get("owner_sig", ""))
        if len(owner_pub) != 32:
            return None
        body = _canonical({k: v for k, v in payload.items() if k != "owner_sig"})
        if not _ed25519.verify(body, owner_sig, owner_pub):
            return None
        return _owner_id_for_pub(owner_pub)
    except Exception:
        return None


def _next_seq_and_prev(node_id):
    """Next per-node monotonic seq and the hash of this device's latest entry.
    Derived from the journal itself (stateless, correct after a fresh start)."""
    mine = [e for e in merkle.read_all_entries(JOURNAL_DIR) if e.get("node_id") == node_id]
    if not mine:
        return 1, "sha256:genesis"
    last = max(mine, key=lambda e: e["seq"])
    return last["seq"] + 1, compute_hash(last)


def _journal_path_for(timestamp):
    return JOURNAL_DIR / f"{timestamp[:10]}.jsonl"


try:
    import fcntl as _fcntl
except Exception:                       # non-POSIX (e.g. Windows) — no flock available
    _fcntl = None


def _append_line(path, line):
    """Append one serialized JSON line to a daily journal file under an EXCLUSIVE advisory lock, so a
    concurrent daemon+CLI write (normal operation) can't interleave mid-line and corrupt the .jsonl.
    A line can exceed PIPE_BUF (4096B), so O_APPEND alone is NOT atomic for our records — the lock is.
    Released on close. flock is POSIX-only; without it we fall back to a plain append (single-writer
    is the common case there, and the best-effort corrupt-line skip in merkle.read_all_entries remains
    the second line of defense)."""
    with open(path, "a") as f:
        if _fcntl is not None:
            try:
                _fcntl.flock(f.fileno(), _fcntl.LOCK_EX)
            except Exception:
                pass
        f.write(line + "\n")


def append_journal(entry_type, payload, timestamp=None):
    """Mint and append a LOCAL journal entry. This is the core append API —
    every local write goes through here. Returns the full entry dict."""
    timestamp = timestamp or _now_iso()
    seq, prev_hash = _next_seq_and_prev(NODE_ID)
    entry = {
        "node_id": NODE_ID,
        "seq": seq,
        "type": entry_type,          # fact | decision | entity | entity_fact
        "timestamp": timestamp,
        "payload": payload,
        "prev_hash": prev_hash,
    }
    seed = _device_seed()
    if seed is not None:
        _sign_entry(entry, seed, _ed25519.pub_from_seed(seed))
    _append_line(_journal_path_for(timestamp), json.dumps(entry))
    return entry


def journal_keys():
    """Set of (node_id, seq) present in the journal — the G-Set membership."""
    return {
        (e["node_id"], e["seq"])
        for e in merkle.read_all_entries(JOURNAL_DIR)
        if e.get("node_id") is not None and e.get("seq") is not None
    }


def append_foreign_entries(entries):
    """Append FOREIGN journal entries verbatim (preserving node_id/seq) with G-Set dedup by
    (node_id, seq). Two membership gates keep the shared journal sound (D0-v2 two-tier membership):

      • GOVERNANCE: an authority-BEARING act (owner / admit / set-config) must carry a valid OWNER
        signature. An authority-LESS `join-request` is accepted on its device signature alone — it
        grants nothing (`_governance_state` ignores any governance lacking an owner sig), it is only
        a pending ask. Accepting it is what lets the owner's session-start tickle surface the joiner.
      • CONTENT: once an owner is established, content (fact/decision/entity/entity_fact) is accepted
        only from ADMITTED devices. A synced-but-unadmitted device is a READ-ONLY member — it reads
        the whole hive and may tickle to join, but its content does not land in (pollute) the shared
        journal until the owner admits it. A pre-owner (bootstrap) hive accepts everything so the
        genesis owner declaration can propagate.

    Governance is processed first so an admit that arrives in the same batch takes effect before that
    device's content is gated. Does NOT persist to SQLite — the caller runs rebuild() once afterwards
    if accepted > 0. Returns (accepted, duplicates)."""
    existing = journal_keys()
    accepted = duplicates = rejected = 0

    def _persist(e):
        _append_line(_journal_path_for(e.get("timestamp", _now_iso())), json.dumps(e))

    # ── Pass 1: governance (owner-signed acts + authority-less join-requests) ────────────────────
    for e in entries:
        if e.get("type") != "governance":
            continue
        nid, seq = e.get("node_id"), e.get("seq")
        if nid is None or seq is None:
            continue
        if (nid, seq) in existing:
            duplicates += 1
            continue
        if not _verify_entry(e):
            rejected += 1               # forged/corrupt device signature
            continue
        if (e.get("payload", {}).get("action") not in ("join-request", "propose-election", "vote-election")
                and _verify_governance(e.get("payload", {})) is None):
            # An authority-bearing governance act with no valid owner signature is forged. Rejection
            # is deterministic, so every honest node drops the same ones and journals stay converged.
            # `join-request` and election proposals/votes are authority-LESS device-signed acts (already
            # verified above by _verify_entry); their weight is decided in `_governance_state`.
            rejected += 1
            continue
        existing.add((nid, seq))
        _persist(e)
        accepted += 1

    # Recompute governance AFTER pass 1 so admits that just landed populate the admitted set.
    gov = _governance_state(merkle.read_all_entries(JOURNAL_DIR))
    has_owner, admitted = gov["owner_id"] is not None, gov["admitted"]

    # ── Pass 2: content, admission-gated once an owner exists ────────────────────────────────────
    for e in entries:
        if e.get("type") == "governance":
            continue
        nid, seq = e.get("node_id"), e.get("seq")
        if nid is None or seq is None:
            continue
        if (nid, seq) in existing:
            duplicates += 1
            continue
        if not _verify_entry(e):
            rejected += 1
            continue
        if has_owner and (nid not in admitted or nid in gov["purged"]):
            # Read-only member: its content does not land until the owner admits the device.
            # A purged device is tombstoned — its new writes are rejected even if later re-admitted.
            rejected += 1
            continue
        existing.add((nid, seq))
        _persist(e)
        accepted += 1

    if rejected:
        print(f"append_foreign_entries: rejected {rejected} entr"
              f"{'y' if rejected == 1 else 'ies'} (bad signature, unauthorized governance, or "
              f"content from an unadmitted device)", file=sys.stderr)
    return accepted, duplicates


# --------------------------------------------------------------------------
# Persistence — derive SQLite state from journal entries.
#
# Two phases (used by rebuild and, inline, by the live commands):
#   pass 1: persist_* insert/upsert rows for fact|decision|entity and record
#           (node_id, seq) -> local_id in journal_index.
#   pass 2: resolve_* wire up cross-row links (entity_fact, decision supersedes)
#           by mapping their (node_id, seq) references through journal_index.
# Splitting the passes means a link can reference a row created later in the
# journal (or on another node) without ordering/FK surprises.
# --------------------------------------------------------------------------

def _record_index(conn, entry, kind, local_id):
    conn.execute(
        "INSERT OR REPLACE INTO journal_index(node_id, seq, kind, local_id) VALUES (?,?,?,?)",
        (entry.get("node_id"), entry.get("seq"), kind, local_id),
    )


def persist_fact(conn, entry):
    payload = entry["payload"]
    ts = entry.get("timestamp", _now_iso())
    cur = conn.cursor()
    content = payload["content"]
    cur.execute("SELECT id FROM facts WHERE content = ?", (content,))
    row = cur.fetchone()
    if row:
        # Known content: this entry is CORROBORATION, not a new fact. Map its
        # journal identity onto the existing row (so distinct sources stay
        # countable) and bump access_count as telemetry only. Confidence is NOT
        # mutated here — it is a pure projection recomputed by
        # _recompute_confidence() over the set of distinct sources, so repetition
        # can never launder confidence upward.
        cur.execute(
            "UPDATE facts SET access_count = access_count + 1, last_accessed = ? WHERE id = ?",
            (ts, row["id"]),
        )
        _record_index(conn, entry, "fact", row["id"])
        return {"id": row["id"], "inserted": False}
    cur.execute("""
        INSERT INTO facts (content, tags, importance, source_agent, source_session,
                           created_at, trust_score, access_count, confidence)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        content,
        json.dumps(payload.get("tags", [])),
        payload.get("importance", 0.5),
        payload.get("source", "manual"),
        payload.get("source_session"),
        payload.get("created_at", ts),
        payload.get("trust_score", 1.0),   # legacy column, retained but unused for ranking
        payload.get("access_count", 0),
        0.0,                                # confidence placeholder — set by _recompute_confidence()
    ))
    fid = cur.lastrowid
    _record_index(conn, entry, "fact", fid)
    return {"id": fid, "inserted": True}


# --- Confidence projection (Phase A + D0 identity) ----------------------------
# Confidence is a PURE, DETERMINISTIC projection over the immutable journal,
# recomputed on every rebuild — never a mutable counter. It is a function of the
# distinct INDEPENDENT IDENTITIES that asserted the exact content, with diminishing
# returns and a hard cap below "certain". Repetition from one identity is
# idempotent, so it cannot launder confidence upward. The G-Set journal converges
# across nodes, so this yields identical values everywhere.
#
# D0: the corroborating identity is (node_id, app, instance) parsed from the source
# string — NOT the raw source string. Structured agents (e.g. Hermes) vary their
# source per session ("hermes:<ctx>/<agent>/<session8>"); counting the raw string
# would treat one agent's two sessions as two corroborators. Session is excluded;
# each identity is weighted by its context-class (primary/subagent/cron).
# Deferred (D0-v2): same-node independence discount; principal + CAP_self.
CONF_BASE = 0.5    # each new independent identity halves the remaining gap to CAP
CONF_CAP = 0.90    # never "certain" without external/human verification
SRC_CLASS_WEIGHT = {"primary": 1.0, "subagent": 0.5, "cron": 0.3}
# D0-v2 defaults (owner-overridable via journaled `set-config`, so they stay identical on every node).
CONF_SAME_DEVICE_LAMBDA = 0.5   # weight of EACH additional identity on the same device (1.0 = no discount)
CONF_CAP_SELF = 0.70            # ceiling when all corroboration traces to ONE principal (self-reinforcement)
# Quorum-election defaults (owner-overridable via journaled `set-config`, identical on every node).
# quorum_m=0 keeps elections OFF, so a hive with no election config/entries resolves to exactly the
# chain owner (back-compat). See Stage C in `_governance_state`.
GOV_QUORUM_M = 0                # admitted voter-units needed to elect a new owner (0 = elections OFF)
GOV_QUORUM_BY = "device"       # count quorum by "device" or by "principal"
GOV_DEAD_MAN_DAYS = 30.0       # owner inactivity (no owner-signed act, incl. heartbeat) before an election can install
GOV_ELECTION_SKEW_DAYS = 1.0 / 24.0   # max a proposal's basis_ts may lead its OWN entry timestamp (clock-skew
                               # allowance); a further-future basis_ts is a forged inactivity anchor → rejected


def _parse_source(source):
    """Parse a source identity into (app, context_class, instance, session).
    Structured: '<app>:<context_class>/<instance>/<session8>'.
    Flat/legacy/CLI (e.g. 'manual', 'claude-code'): app=instance=string,
    context_class='primary', session=None."""
    s = source or "manual"
    if ":" in s:
        app, _, rest = s.partition(":")
        parts = rest.split("/")
        ctx = parts[0] if parts and parts[0] else "primary"
        instance = parts[1] if len(parts) > 1 and parts[1] else (app or "manual")
        session = parts[2] if len(parts) > 2 and parts[2] else None
        return (app or "manual", ctx, instance, session)
    return (s, "primary", s, None)


def _identity_weight(node_id, source):
    """The corroborating-identity key (node_id, app, instance) and its source-class
    weight. Session is deliberately excluded so one agent across sessions = one identity."""
    app, ctx, instance, _sess = _parse_source(source)
    return (node_id, app, instance), SRC_CLASS_WEIGHT.get(ctx, 1.0)


OWNER_APPS = {"owner"}    # governance source-class → decisive forget (FORGET_FLOOR)
FORGET_FLOOR = -1.0       # owner-forget sits below the epistemic range [-CAP, +CAP]


def _confidence_for(net):
    """Signed, saturating projection of NET evidence (n_pos - n_neg, weighted floats):
    CAP*(1 - BASE**|net|) with net's sign. +1->0.45 +2->0.675 0->0 -1->-0.45 -2->-0.675;
    bounded [-CAP, +CAP]."""
    if net == 0:
        return 0.0
    mag = round(CONF_CAP * (1 - CONF_BASE ** abs(net)), 6)
    return mag if net > 0 else -mag


HALFLIFE_DAYS = 180.0     # Phase C: confidence half-life when not refreshed by new evidence


def _projection_latest(entries, want_type, authz=None):
    """Pure, deterministic projection over content entries of `want_type` → {name: latest payload}.
    Mirrors `_governance_state`'s discipline: read only the journal (which converges via the G-Set),
    skip entries that fail their device signature, and break ties identically on every node, so all
    nodes derive the same view. "Latest" = highest `version`, then (timestamp, node_id, seq) — a total
    order, deterministic across nodes. Admission is already enforced at ingest (`append_foreign_entries`
    Pass 2 rejects content from non-admitted devices), so the projection just folds what landed.

    `authz`, when given, is a pure callable `(signer_node_id, (ts, node_id, seq), payload) -> bool`:
    an entry whose signer is not authorized to WRITE this content type is skipped from the fold
    exactly like a bad-signature entry. The entry still LANDS in every journal (convergence/Merkle
    untouched) — every node just deterministically declines to honor it. The caller attaches `authz`
    only once an owner exists and crypto is available, so an unsigned content entry (no verifiable
    signer) is declined post-owner; pre-owner and crypto-less (stripped) folds stay permissive
    (`authz=None`). See `_is_authorized_writer` and hive decisions #58/#61."""
    rows = []
    for e in entries:
        if e.get("type") != want_type:
            continue
        if "sig" in e and not _verify_entry(e):
            continue
        p = e.get("payload", {}) or {}
        name = p.get("name")
        if not name:
            continue
        if authz is not None:
            # The device signer is trustworthy only on a SIGNED entry (`_verify_entry` above bound its
            # node_id to the embedded pub); an unsigned entry has no verifiable device signer. The
            # predicate decides per policy (fertile → device admission; owner → the payload's owner
            # signature), so we hand it both and let it decline.
            signer = e.get("node_id") if "sig" in e else None
            pos = (e.get("timestamp", ""), str(e.get("node_id", "")), e.get("seq", 0))
            if not authz(signer, pos, p):
                continue
        rows.append((int(p.get("version", 0) or 0), e.get("timestamp", ""),
                     str(e.get("node_id", "")), e.get("seq", 0), name, p))
    rows.sort(key=lambda r: (r[0], r[1], r[2], r[3]))   # earliest→latest; last write per name wins
    out = {}
    for _v, _ts, _nid, _seq, name, p in rows:
        out[name] = p
    return out


def _cell_state(entries):
    """name → latest `cell` payload. A cell is an executable unit with a `kind` (`tool`|`agent`)."""
    return _projection_latest(entries, "cell")


def _comb_state(entries):
    """name → latest `comb` payload. A comb is a named, ordered collection of cell names."""
    return _projection_latest(entries, "comb")


def _capsule_state(entries, gov=None):
    """name → latest `capsule` payload (an encrypt-to-device sealed secret). Latest version wins, so
    a rotation supersedes an old seal and a tombstone (alg='tombstone-v1') supersedes the secret.

    Honors only entries whose signer was the AUTHORIZED writer under the hive's `capsule_putters`
    policy — judged POINT-IN-TIME for the owner policy (hive decision #58), so a compromised admitted
    device can no longer supersede or tombstone a capsule by appending a journal entry that bypasses
    the CLI-only `capsule_putters` gate. Pre-owner, or a crypto-less (stripped) build, folds
    permissively (decision #61). Pass `gov` to reuse an already-computed governance projection."""
    if gov is None:
        gov = _governance_state(entries)
    authz = None
    if gov.get("owner_id") and _ed25519 is not None:
        policy = gov.get("config", {}).get("capsule_putters", "owner")
        authz = lambda signer, pos, p: _is_authorized_writer(signer, pos, p, gov, policy)
    return _projection_latest(entries, "capsule", authz=authz)


def _owner_at(owner_timeline, pos):
    """The owner_id legitimately in authority AS OF journal position `pos` (a (ts, node_id, seq)
    tuple) per the settled owner-succession timeline, or None if `pos` precedes the genesis owner.
    Pure/deterministic: the timeline and `pos` share the journal's single total order, so every node
    resolves the same owner-at-T with no wall-clock."""
    owner = None
    for tts, tnid, tseq, oid in owner_timeline:        # ascending by position
        if (tts, tnid, tseq) <= pos:
            owner = oid
        else:
            break
    return owner


def _is_authorized_writer(signer, pos, payload, gov, policy):
    """True if this content entry — device-signed by `signer`, carrying `payload`, at journal position
    `pos` — may write an authority-bearing content type under `policy` ('owner'|'fertile').

    OWNER policy: the writer must PROVE owner-key possession via an owner signature on the payload
    (verified by `_verify_governance`, exactly as a governance act proves authority — a capsule is
    device-signed, so the device node_id alone cannot establish owner authorship), AND that owner must
    have been the legitimate owner AS OF `pos`. POINT-IN-TIME (hive #58): a prior owner's seals survive
    a later transfer/succession/election; a position before the genesis owner resolves to None and is
    declined (closing a backdate-before-genesis bypass).

    FERTILE policy: any currently admitted, non-purged device — authority is the device's own
    signature + hive membership (the asymmetric tombstone/seal refinement is deferred until fertile is
    adopted, hive #59). Caller invokes this only once an owner exists and crypto is available."""
    if policy == "fertile":
        return signer is not None and signer in gov.get("admitted", set()) and signer not in gov.get("purged", set())
    oid = _verify_governance(payload)
    return oid is not None and oid == _owner_at(gov.get("owner_timeline") or [], pos)


def _capsule_version_conflicts(entries):
    """Capsule names where the SAME version was sealed by MORE THAN ONE device — a concurrent
    put/rotate that happened before the writers synced. The projection still resolves deterministically
    by (version, timestamp, node_id, seq), so the hive stays converged, but it means one writer's value
    silently lost the tie. Returns sorted [name] so `hv doctor` can surface it (version is a local
    increment, not owner-signed — this is the visibility the design otherwise lacks)."""
    seen = {}      # (name, version) -> set(node_id)
    for e in entries:
        if e.get("type") != "capsule":
            continue
        p = e.get("payload", {}) or {}
        name, ver = p.get("name"), p.get("version")
        if name is None or ver is None:
            continue
        seen.setdefault((name, ver), set()).add(e.get("node_id"))
    return sorted({name for (name, _ver), nodes in seen.items() if len(nodes) > 1})


def _capsule_unauthorized(entries, gov):
    """Capsule entries the projection now DECLINES to honor because their signer was not the
    authorized writer (the owner AS OF the write position, or an admitted device under `fertile`) —
    surfaced by `hv doctor` so an operator sees what an upgrade changes rather than silently dropping
    depended-on state (hive decisions #58/#61). Returns ['name vN by node_id', ...]; empty when authz
    is inactive (pre-owner or a crypto-less build, where the fold stays permissive)."""
    if not gov.get("owner_id") or _ed25519 is None:
        return []
    policy = gov.get("config", {}).get("capsule_putters", "owner")
    out = []
    for e in entries:
        if e.get("type") != "capsule":
            continue
        if "sig" in e and not _verify_entry(e):
            continue
        p = e.get("payload", {}) or {}
        if not p.get("name"):
            continue
        signer = e.get("node_id") if "sig" in e else None
        pos = (e.get("timestamp", ""), str(e.get("node_id", "")), e.get("seq", 0))
        if not _is_authorized_writer(signer, pos, p, gov, policy):
            out.append(f"{p['name']} v{p.get('version', '?')} by {e.get('node_id', '?')}")
    return out


_GOV_CACHE = {}     # signature(governance entries) -> projected gov dict (master copy, never handed out)


def _governance_state(entries):
    """Memoized wrapper over the (pure, deterministic) governance projection. The projection reads
    ONLY governance entries, so the cache key is a content signature of just those — a plain `fact`
    write (the common case) does not bust it, and the heavy work (sort + multi-stage election walk +
    per-entry Ed25519 verification) is skipped on the long-lived daemon's repeated calls. The cached
    value is the master; every caller gets a deep COPY so a caller mutating its result can never
    corrupt the cache. Output is byte-identical to the uncached projection for the same journal."""
    govs_raw = [e for e in entries if e.get("type") == "governance"]
    sig = hashlib.sha256(
        "\x01".join(
            json.dumps([e.get("node_id"), e.get("seq"), e.get("timestamp"),
                        e.get("sig"), e.get("payload")], sort_keys=True, separators=(",", ":"))
            for e in govs_raw).encode()
    ).hexdigest()
    master = _GOV_CACHE.get(sig)
    if master is None:
        master = _governance_state_uncached(entries)
        _GOV_CACHE.clear()              # journal grows monotonically; only the latest sig is ever reused
        _GOV_CACHE[sig] = master
    return copy.deepcopy(master)


def _governance_state_uncached(entries):
    """Pure, deterministic projection over owner-signed `governance` entries → the established owner,
    the admitted device set, the principal map, and tunable config. Because it reads only the journal
    (which converges via the G-Set), every node derives the same governance state, so confidence stays
    identical everywhere. No owner declared yet → empty admitted set + default config (gate off)."""
    gov = {"owner_id": None, "owner_pub": None, "owner_ts": "", "hive_id": "", "admitted": set(),
           "denied": set(), "purged": set(), "standbys": set(),
           "nominations": set(), "escrows": [], "elections": [], "owner_term": 0,
           "principals": {}, "config": {"same_device_lambda": CONF_SAME_DEVICE_LAMBDA, "cap_self": CONF_CAP_SELF,
                                        "quorum_m": GOV_QUORUM_M, "quorum_by": GOV_QUORUM_BY,
                                        "dead_man_days": GOV_DEAD_MAN_DAYS}}
    govs = []
    for e in entries:
        if e.get("type") != "governance":
            continue
        p = e.get("payload", {})
        action = p.get("action")
        if action in ("propose-election", "vote-election"):
            # DEVICE-signed (not owner-signed): authority is the signer's hive membership, not the
            # owner key. Require a real device signature (these acts are new in 1.9 — nothing legacy
            # to grandfather); admission is enforced later in the walk. `signer=None` marks them.
            if "sig" in e and _verify_entry(e):
                govs.append((e.get("timestamp", ""), str(e.get("node_id", "")), e.get("seq", 0), p, None))
            continue
        signer = _verify_governance(p)
        if signer is None:
            continue   # unsigned or forged governance is ignored
        govs.append((e.get("timestamp", ""), str(e.get("node_id", "")), e.get("seq", 0), p, signer))
    govs.sort(key=lambda x: (x[0], x[1], x[2]))   # deterministic order across nodes

    # 1) Establish the owner: the first valid self-signed `owner` declaration wins (TOFU).
    gen_pos = None
    for _ts, _nid, _seq, p, signer in govs:
        if p.get("action") == "owner" and signer == p.get("owner_id"):
            gov["owner_id"], gov["owner_pub"], gov["owner_ts"] = p.get("owner_id"), p.get("owner_pub"), _ts
            gov["hive_id"] = p.get("hive_id", "")
            gen_pos = (_ts, str(_nid), _seq)          # genesis (term-0) position for the owner timeline
            break
    if gov["owner_id"] is None:
        return gov

    # 2) Single deterministic walk: the OWNER SUCCESSION CHAIN (Stage B) and the QUORUM ELECTION
    #    OVERRIDE (Stage C) interleaved with the membership/config/escrow acts. `current` is the owner
    #    AT THIS POINT in the log — succession advances it, and every other act is honored only when
    #    signed by the current owner. So a handed-off owner's later acts drop, and a live owner is
    #    never unseated (only their own signed nominate/transfer, a nominee's claim against an OPEN
    #    nomination, OR — when the owner has gone dark past dead_man_days — a quorum election advances
    #    it). Because the election installs its winner mid-walk like a transfer, the new owner's later
    #    acts are honored from that point and any heartbeat by a live owner keeps the dead-man shut.
    current = gov["owner_id"]
    owner_pubs = {current: gov["owner_pub"]}
    owner_timeline = [(gen_pos[0], gen_pos[1], gen_pos[2], current)]   # [(ts,node_id,seq,owner_id)] —
    #   each entry marks the journal position from which `owner_id` holds authority; consumed by
    #   `_owner_at` for POINT-IN-TIME content authorization (hive #58). Appended on every succession.
    nominations = set()                       # open successor pubs (canonical b64)
    escrows = []                              # [{ref:(nid,seq), ts, nid, seq, env, revoked}]
    owner_act = {current: gov["owner_ts"]}    # owner_id -> latest ts of an owner-signed act (liveness)
    proposals = {}                            # Stage C: election_id -> {new_pub, new_oid, basis_ts, voters, installed}
    pending_votes = {}                        # election_id -> {voter_units} seen BEFORE the proposal (clock skew)
    for _ts, _nid, _seq, p, signer in govs:
        action = p.get("action")

        # --- Stage C: device-signed quorum election (signer is None — authority is membership) ---
        if signer is None and action in ("propose-election", "vote-election"):
            quorum_m = int(gov["config"].get("quorum_m", 0) or 0)
            if quorum_m <= 0 or _nid not in gov["admitted"] or _nid in gov["purged"]:
                continue                       # elections off, or a non-admitted/purged signer
            pid = p.get("proposal_id")
            if not pid:
                continue
            by_principal = gov["config"].get("quorum_by", GOV_QUORUM_BY) == "principal"
            vunit = ("p", gov["principals"].get(_nid, _nid)) if by_principal else ("d", _nid)
            if action == "propose-election":
                new_pub = _canon_pub(p.get("new_owner_pub", ""))
                basis_ts = p.get("basis_ts", "")
                if not new_pub or not basis_ts or pid != _election_id(new_pub, basis_ts):
                    continue                   # malformed or not content-addressed to its body
                # Deterministic clock-skew bound: basis_ts anchors the owner-inactivity measurement,
                # so a FUTURE-dated basis_ts pre-arms the dead-man switch. It cannot legitimately lead
                # the proposal's OWN entry timestamp (_ts) — both are stamped at propose time — so
                # reject one that does, beyond a small skew allowance. Entry-time vs entry-time only:
                # every node decides identically and the journal stays convergent (no wall-clock).
                if _days_between(_ts, basis_ts) > GOV_ELECTION_SKEW_DAYS:
                    continue
                pr = proposals.get(pid)
                if pr is None:
                    try:
                        new_oid = _owner_id_for_pub(base64.b64decode(new_pub))
                    except Exception:
                        continue
                    pr = proposals[pid] = {"new_pub": new_pub, "new_oid": new_oid,
                                           "basis_ts": basis_ts,
                                           "voters": pending_votes.pop(pid, set()), "installed": False}
            else:                              # vote-election
                pr = proposals.get(pid)
                if pr is None:                 # a vote that sorts before its proposal — hold it
                    pending_votes.setdefault(pid, set()).add(vunit)
                    continue
            pr["voters"].add(vunit)
            # Install the elected owner the instant a proposal reaches quorum AND the dead-man is
            # armed for the owner current HERE — like a transfer at this log position. The earliest
            # such crossing wins: once it installs, `current` becomes the new owner with fresh
            # activity (owner_act below), so a racing election can no longer arm against it.
            if not pr["installed"] and len(pr["voters"]) >= quorum_m:
                la = owner_act.get(current, "")
                dead_man_days = float(gov["config"].get("dead_man_days", GOV_DEAD_MAN_DAYS) or 0)
                if la and pr["basis_ts"] > la and _days_between(la, pr["basis_ts"]) >= dead_man_days:
                    pr["installed"] = True
                    current = pr["new_oid"]
                    owner_pubs[current] = pr["new_pub"]
                    owner_act[current] = _ts
                    owner_timeline.append((_ts, str(_nid), _seq, current))
                    nominations.clear()
                    gov["owner_term"] += 1
            continue

        owner_act[signer] = max(owner_act.get(signer, ""), _ts)   # any owner-signed act = liveness

        # --- Stage B: advance the owner chain (evaluated BEFORE the current-owner gate) ---
        if action == "nominate-successor":
            cp = _canon_pub(p.get("successor_owner_pub", "")) if signer == current else None
            if cp:
                nominations.add(cp)
            continue
        if action == "revoke-nomination":
            if signer == current:
                cp = _canon_pub(p.get("successor_owner_pub", ""))
                nominations.discard(cp)
            continue
        if action == "claim-succession":
            # Self-signed by the successor's NEW owner key (like genesis): the embedded owner_pub is
            # what signed it. Valid only against an open matching nomination.
            cp = _canon_pub(p.get("owner_pub", ""))
            if signer == p.get("owner_id") and cp and cp in nominations:
                current = p["owner_id"]
                owner_pubs[current] = p.get("owner_pub")
                owner_timeline.append((_ts, str(_nid), _seq, current))
                nominations.clear()           # nominations close on succession
                gov["owner_term"] += 1
            continue
        if action == "transfer":
            if signer == current and p.get("new_owner_pub"):
                try:
                    new_oid = _owner_id_for_pub(base64.b64decode(p["new_owner_pub"]))
                except Exception:
                    continue
                current = new_oid
                owner_pubs[new_oid] = p["new_owner_pub"]
                owner_act[new_oid] = _ts          # the handoff is the successor's term-start activity
                owner_timeline.append((_ts, str(_nid), _seq, current))
                nominations.clear()
                gov["owner_term"] += 1
            continue

        # Everything below is authorized only by the owner CURRENT at this log position.
        if signer != current:
            continue
        if action == "owner-escrow" and p.get("envelope"):
            escrows.append({"ref": (str(_nid), _seq), "ts": _ts, "nid": str(_nid), "seq": _seq,
                            "env": p["envelope"], "revoked": False})
        elif action == "revoke-escrow":
            target = p.get("escrow_ref")
            for esc in escrows:                # tombstone matching escrows seen SO FAR (positional)
                if (target == "all"
                        or (isinstance(target, (list, tuple)) and tuple(target) == esc["ref"])
                        or target == f"{esc['nid']}:{esc['seq']}"):
                    esc["revoked"] = True
        elif action == "admit" and p.get("device_id"):
            # A later admit re-admits a revoked device and clears a prior deny. Purge is a final
            # tombstone — admit does NOT clear it (a purged device cannot be resurrected here).
            gov["admitted"].add(p["device_id"])
            gov["denied"].discard(p["device_id"])
            if p.get("principal"):
                gov["principals"][p["device_id"]] = p["principal"]
        elif action == "revoke" and p.get("device_id"):
            gov["admitted"].discard(p["device_id"])   # reversible: a later admit restores it
        elif action == "deny" and p.get("device_id"):
            gov["denied"].add(p["device_id"])          # drop a pending join-request (admit overrides)
        elif action == "change" and p.get("device_id") and p.get("principal"):
            if p["device_id"] in gov["admitted"]:      # re-tag principal without changing admission
                gov["principals"][p["device_id"]] = p["principal"]
        elif action == "purge" and p.get("device_id"):
            gov["admitted"].discard(p["device_id"])    # final tombstone (see _governed_side / ingest)
            gov["purged"].add(p["device_id"])
        elif action == "standby" and p.get("device_id"):
            # Advisory: a device the owner sanctions to also hold the owner key and act while the
            # owner is offline. No authority is granted here (the key is the authority) — this just
            # records intent so `hv whoami`/`owner show`/`doctor` can surface who may act.
            if p.get("enabled", True):
                gov["standbys"].add(p["device_id"])
            else:
                gov["standbys"].discard(p["device_id"])
        elif action == "set-config":
            key, raw = p.get("key"), p.get("value")
            try:
                if key in ("same_device_lambda", "cap_self", "dead_man_days"):
                    gov["config"][key] = float(raw)
                elif key == "quorum_m":
                    gov["config"][key] = int(raw)
                elif key == "quorum_by" and raw in ("device", "principal"):
                    gov["config"][key] = raw
                elif key == "capsule_putters" and raw in ("owner", "fertile"):
                    gov["config"][key] = raw
            except (TypeError, ValueError):
                pass

    # The owner the chain resolved to (term-0 owner if no succession/election happened). owner_ts/
    # hive_id stay the term-0 values — they mark when governance BEGAN (grandfathers pre-owner forgets).
    gov["owner_id"], gov["owner_pub"] = current, owner_pubs.get(current)
    gov["owner_timeline"] = sorted(owner_timeline)    # ascending by position for `_owner_at`
    gov["nominations"] = nominations
    gov["escrows"] = sorted(((e["ts"], e["nid"], e["seq"], e["env"]) for e in escrows
                             if not e["revoked"]), key=lambda x: (x[0], x[1], x[2]))
    # Stage C summary for display (owner show / elections / doctor). `armed`/`crossed` are recomputed
    # against the FINAL owner's liveness, so an open proposal shows whether it would install now.
    final_la = owner_act.get(current, gov["owner_ts"])
    qm = int(gov["config"].get("quorum_m", 0) or 0)
    dmd = float(gov["config"].get("dead_man_days", GOV_DEAD_MAN_DAYS) or 0)
    gov["elections"] = sorted(
        ({"proposal_id": pid, "new_owner_id": pr["new_oid"], "basis_ts": pr["basis_ts"],
          "votes": len(pr["voters"]), "quorum_m": qm, "installed": pr["installed"],
          "crossed": qm > 0 and len(pr["voters"]) >= qm,
          "armed": bool(final_la and pr["basis_ts"] > final_la
                        and _days_between(final_la, pr["basis_ts"]) >= dmd)}
         for pid, pr in proposals.items()),
        key=lambda x: x["proposal_id"])
    return gov


def _local_hive_id():
    """This device's hive_id (from the established owner declaration), or '' if no owner yet. Used by
    the sync layer to refuse merging journals across hives — two hives on one tailnet stay separate."""
    return _governance_state(merkle.read_all_entries(JOURNAL_DIR)).get("hive_id", "")


def _owner_declaration(entries):
    """The owner-signed genesis governance payload that established the hive (for /hive/info, so a
    joiner can verify the queen bee). None if no owner."""
    gov = _governance_state(entries)
    if not gov["owner_id"]:
        return None
    for e in entries:
        if e.get("type") == "governance":
            p = e.get("payload", {})
            if (p.get("action") == "owner" and p.get("owner_id") == gov["owner_id"]
                    and _verify_governance(p) == gov["owner_id"]):
                return p
    return None


def _probe_hive(ip, port, timeout=3):
    """GET /hive/info from ip:port and return it only if it's a GENUINE hive — a verifiable signed
    genesis whose owner matches the claimed owner_id. Rejects a non-hive service squatting the port."""
    try:
        import requests
        info = requests.get(f"http://{ip}:{port}/hive/info", timeout=timeout).json()
    except Exception:
        return None
    gen = info.get("genesis")
    if not info.get("hive_id") or not gen:
        return None
    if _verify_governance(gen) != info.get("owner_id"):
        return None
    return info


def _content_evidence(entries, gov=None):
    """content -> {'pos': {id: weight}, 'neg': {id: weight}, 'forget': bool, 'last_ts': str}.
    Facts add positive identity-evidence; `retract` entries add negative (peer) evidence or set
    owner-forget (governance, decisive). last_ts = most-recent fact/retract timestamp (drives
    decay). Pure projection over the journal.

    Owner-forget authority: once an owner is established, a forget is honored only if it is
    OWNER-SIGNED by that owner, or it predates the owner (grandfathered). Before any owner exists,
    the legacy source-tag forget (`owner:owner/owner`) is honored — so existing forgets are never
    resurrected, and after `hv owner init` a forged unsigned forget no longer carries authority."""
    gov = gov or _DEFAULT_GOV
    out = {}
    seq_content = {}                       # (node_id, seq) of a fact entry -> its content
    for e in entries:
        if e.get("type") != "fact":
            continue
        p = e.get("payload", {})
        content = p.get("content")
        if content is None:
            continue
        seq_content[(e.get("node_id"), e.get("seq"))] = content
        ev = out.setdefault(content, {"pos": {}, "neg": {}, "forget": False, "last_ts": ""})
        key, w = _identity_weight(e.get("node_id"), p.get("source", "manual"))
        if w > ev["pos"].get(key, 0.0):
            ev["pos"][key] = w
        ts = e.get("timestamp", "")
        if ts > ev["last_ts"]:
            ev["last_ts"] = ts
    for e in entries:
        if e.get("type") != "retract":
            continue
        p = e.get("payload", {})
        ref = p.get("retracts_ref")
        content = seq_content.get(tuple(ref)) if ref else None
        if content is None or content not in out:
            continue
        ev = out[content]
        app, ctx, instance, _sess = _parse_source(p.get("source", "manual"))
        if app in OWNER_APPS or ctx == "owner":
            if gov["owner_id"]:
                # Owner established: honor only an owner-signed forget from that owner, or one that
                # predates the owner (grandfathered). An unsigned/forged owner-forget is ignored.
                signer = _verify_governance(p) if "owner_sig" in p else None
                if signer == gov["owner_id"] or e.get("timestamp", "") < gov["owner_ts"]:
                    ev["forget"] = True
            else:
                ev["forget"] = True   # pre-governance: legacy source-tag forget honored
        else:
            key = (e.get("node_id"), app, instance)
            w = SRC_CLASS_WEIGHT.get(ctx, 1.0)
            if w > ev["neg"].get(key, 0.0):
                ev["neg"][key] = w
        ts = e.get("timestamp", "")
        if ts > ev["last_ts"]:
            ev["last_ts"] = ts
    return out


_DEFAULT_GOV = {"owner_id": None, "owner_ts": "", "admitted": set(), "denied": set(), "purged": set(),
                "standbys": set(), "nominations": set(), "escrows": [], "elections": [], "owner_term": 0,
                "principals": {},
                "config": {"same_device_lambda": CONF_SAME_DEVICE_LAMBDA, "cap_self": CONF_CAP_SELF,
                           "quorum_m": GOV_QUORUM_M, "quorum_by": GOV_QUORUM_BY,
                           "dead_man_days": GOV_DEAD_MAN_DAYS}}


def _governed_side(weights, gov):
    """Collapse identity weights {(device_id, app, instance): w} into a single governed total.
    (D0-v2) ADMISSION: once an owner is established, only admitted devices count. SAME-DEVICE
    DISCOUNT: each device contributes its strongest identity in full plus λ·(its others), since
    agents on one machine are correlated, not independent. Returns (total, set_of_device_ids)."""
    has_owner, admitted = gov["owner_id"] is not None, gov["admitted"]
    purged = gov.get("purged", set())
    lam = gov["config"]["same_device_lambda"]
    by_dev = {}
    for (dev, _app, _inst), w in weights.items():
        if has_owner and (dev not in admitted or dev in purged):
            continue
        by_dev.setdefault(dev, []).append(w)
    total = 0.0
    for ws in by_dev.values():
        ws.sort(reverse=True)
        total += ws[0] + lam * sum(ws[1:])
    return total, set(by_dev.keys())


def _content_confidence(ev, gov=None):
    """Time-INVARIANT base confidence for one content: a SIGNED, GOVERNED projection. forget ->
    FORGET_FLOOR. Else net = governed(pos) - governed(neg) -> _confidence_for, then CAP_self clamps
    positive confidence when every contributing device shares one principal (self-reinforcement).
    Pure over (journal facts + governance) -> identical on every node. Decay applied at query time."""
    if ev.get("forget"):
        return FORGET_FLOOR
    gov = gov or _DEFAULT_GOV
    pos, pos_devs = _governed_side(ev["pos"], gov)
    neg, _ = _governed_side(ev["neg"], gov)
    base = _confidence_for(pos - neg)
    if base > 0 and pos_devs:
        prins = [gov["principals"].get(d) for d in pos_devs]
        if all(p is not None for p in prins) and len(set(prins)) == 1:
            base = min(base, gov["config"]["cap_self"])
    return base


def _apply_content_confidence(conn, content, ev, gov=None):
    """Write base confidence + contested flag + last-evidence ts for one content."""
    contested = 1 if (not ev.get("forget") and ev.get("pos") and ev.get("neg")) else 0
    conn.execute(
        "UPDATE facts SET confidence = ?, contested = ?, last_evidence_at = ? WHERE content = ?",
        (_content_confidence(ev, gov), contested, ev.get("last_ts") or None, content),
    )


def _recompute_confidence(conn, entries):
    """The ONLY writer of facts.confidence/contested/last_evidence_at. Pure SIGNED, GOVERNED
    projection over the journal (corroborators MINUS retractors, weighted, admitted-and-discounted;
    owner-retract forgets). Time-invariant — decay at query time."""
    gov = _governance_state(entries)
    for content, ev in _content_evidence(entries, gov).items():
        _apply_content_confidence(conn, content, ev, gov)


def _to_dt(s):
    from datetime import datetime
    try:
        return datetime.fromisoformat(s.strip().replace("Z", "+00:00")).replace(tzinfo=None)
    except Exception:
        return None


def _days_between(ts_a, ts_b):
    """Whole+fractional days from ts_a to ts_b (ISO-8601), or 0.0 if either is unparseable. Used by
    the dead-man switch (Stage C) to measure owner inactivity against a proposal's basis_ts."""
    a, b = _to_dt(ts_a), _to_dt(ts_b)
    if a is None or b is None:
        return 0.0
    return (b - a).total_seconds() / 86400.0


def _age_days(ts):
    """Whole days since ISO-8601 `ts`, or None if unparseable. The staleness signal for `hv peers`
    and the dashboard /api/peers (a device idle > 14d is a purge candidate)."""
    try:
        import datetime
        t = datetime.datetime.fromisoformat((ts or "").replace("Z", "+00:00"))
        return (datetime.datetime.now(datetime.timezone.utc) - t).days
    except Exception:
        return None


def _election_id(new_owner_pub_b64, basis_ts):
    """Content-addressed election proposal id: derived from WHAT is proposed (the new owner pubkey
    + the proposer's basis timestamp). So every device's vote/re-proposal for the same intent shares
    one id and merges deterministically, and a proposal can't be re-pointed at a different key."""
    return "e1:" + hashlib.sha256(_canonical({"new_owner_pub": new_owner_pub_b64,
                                              "basis_ts": basis_ts})).hexdigest()[:16]


def _effective_confidence(base, last_evidence_at, now):
    """Query-time confidence: base decayed by recency. Owner-forget (FORGET_FLOOR) does NOT
    decay (stays gone). Deterministic given (base, last_evidence_at, now) — `now` is injectable
    via $HIVE_NOW so every node computes identical effective confidence for the same instant."""
    if base == FORGET_FLOOR or not last_evidence_at:
        return base
    a, b = _to_dt(last_evidence_at), _to_dt(now)
    if a is None or b is None:
        return base
    age_days = max(0.0, (b - a).total_seconds() / 86400.0)
    return round(base * (0.5 ** (age_days / HALFLIFE_DAYS)), 6)


def persist_decision(conn, entry):
    payload = entry["payload"]
    ts = entry.get("timestamp", _now_iso())
    cur = conn.cursor()
    cur.execute("""
        INSERT INTO decisions (content, rationale, source_agent, created_at, tags)
        VALUES (?, ?, ?, ?, ?)
    """, (
        payload["content"],
        payload.get("rationale"),
        payload.get("source", "manual"),
        payload.get("created_at", ts),
        json.dumps(payload.get("tags", [])),
    ))
    did = cur.lastrowid
    _record_index(conn, entry, "decision", did)
    return {"id": did}


def persist_entity(conn, entry):
    payload = entry["payload"]
    ts = entry.get("timestamp", _now_iso())
    cur = conn.cursor()
    attrs = payload.get("attributes", {})
    attrs_json = attrs if isinstance(attrs, str) else json.dumps(attrs)
    cur.execute("""
        INSERT INTO entities (name, type, attributes, first_seen, last_updated)
        VALUES (?, ?, ?, ?, ?)
        ON CONFLICT(name) DO UPDATE SET
            type = excluded.type,
            attributes = excluded.attributes,
            last_updated = excluded.last_updated
    """, (
        payload["name"],
        payload.get("type", "unknown"),
        attrs_json,
        payload.get("created_at", ts),
        ts,
    ))
    eid = cur.execute("SELECT id FROM entities WHERE name = ?", (payload["name"],)).fetchone()[0]
    _record_index(conn, entry, "entity", eid)
    return {"id": eid, "name": payload["name"], "type": payload.get("type", "unknown")}


_PASS1 = {
    "fact": persist_fact,
    "decision": persist_decision,
    "entity": persist_entity,
}


def persist_entry(conn, entry):
    """Pass 1: apply a row-producing journal entry (fact/decision/entity)."""
    fn = _PASS1.get(entry["type"])
    return fn(conn, entry) if fn else None


def _resolve_ref(conn, ref):
    """Map a journal-identity reference [node_id, seq] to a local row id."""
    if not ref:
        return None
    r = conn.execute(
        "SELECT local_id FROM journal_index WHERE node_id = ? AND seq = ?",
        (ref[0], ref[1]),
    ).fetchone()
    return r["local_id"] if r else None


def resolve_entity_fact(conn, entry):
    """Pass 2: wire an entity_fact link via journal-identity refs (falling back
    to legacy local-id fields for pre-Phase-2 journals)."""
    p = entry["payload"]
    eid = _resolve_ref(conn, p.get("entity_ref"))
    if eid is None:
        eid = p.get("entity_id")        # legacy
    fid = _resolve_ref(conn, p.get("fact_ref"))
    if fid is None:
        fid = p.get("fact_id")          # legacy
    if eid is None or fid is None:
        return
    conn.execute(
        "INSERT OR REPLACE INTO entity_facts (entity_id, fact_id, confidence) VALUES (?, ?, ?)",
        (eid, fid, p.get("confidence", 1.0)),
    )


def resolve_supersedes(conn, entry):
    """Pass 2: mark the decision this entry supersedes (by journal identity,
    falling back to a legacy local-id field)."""
    p = entry["payload"]
    old = _resolve_ref(conn, p.get("supersedes_ref"))
    if old is None:
        old = p.get("supersedes")       # legacy
    if not old:
        return
    new = _resolve_ref(conn, [entry.get("node_id"), entry.get("seq")])
    if new is None:
        return
    conn.execute("UPDATE decisions SET superseded_by = ? WHERE id = ?", (new, old))


def resolve_resolves(conn, entry):
    """Pass 2: record on the NEW fact row which prior fact it resolves (`facts.resolves`
    -> the resolved fact's local id). The actual confidence effect rides on the separate
    `retract` entry `remember --resolves` emits; this link is provenance ("what did fact X
    resolve") and lets the audit/search show the chain. New-row direction, unlike decision
    supersedes which marks the old row."""
    p = entry["payload"]
    old = _resolve_ref(conn, p.get("resolves_ref"))
    if not old:
        return
    new = _resolve_ref(conn, [entry.get("node_id"), entry.get("seq")])
    if new is None:
        return
    conn.execute("UPDATE facts SET resolves = ? WHERE id = ?", (old, new))


def _index_lookup(conn, kind, local_id):
    """Reverse map: local row id -> its journal identity [node_id, seq]."""
    r = conn.execute(
        "SELECT node_id, seq FROM journal_index WHERE kind = ? AND local_id = ? LIMIT 1",
        (kind, local_id),
    ).fetchone()
    return [r["node_id"], r["seq"]] if r else None


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

# Salience Layer 2 (structural gate). CONSERVATIVE + CONTENT-NEUTRAL: it rejects clear
# non-knowledge FORMS (trivially short, bare questions, short greetings) and passes
# everything else — explicit writes are intentional. It is NOT a learned/importance
# classifier (that would reintroduce a capturable authority); the rich judgment of "is
# this a decision/outcome/correction worth keeping" stays with the AGENT (its rubric).
# Opt-in via `remember --gate`; the shared core hosts it so every agent gates identically.
_GREETINGS = ("hi ", "hi,", "hi!", "hello", "hey ", "thanks", "thank you",
              "greetings", "good morning", "good afternoon", "good evening", "yo ")


def _is_salient(content):
    c = (content or "").strip()
    if len(c) < 15:                                   # trivially short → noise
        return False
    if c.endswith("?") and "." not in c:              # a bare question is not a fact
        return False
    cl = c.lower()
    if len(c) < 60 and any(cl.startswith(g) for g in _GREETINGS):  # short pleasantry
        return False
    return True


# Structural markers of a TRANSIENT operational-status claim — a state that will change, so the
# audit should RE-CHECK it (volatile) rather than trust it indefinitely. Deliberately HIGH-PRECISION
# and content-NEUTRAL: it matches the claim FORM (a liveness predicate / freshness marker), never the
# topic. Better to miss a volatile fact than to mislabel a durable one. `is up` excludes "up to date".
_VOLATILE_RE = re.compile(
    r"\b(is|are|stays?|remains?)\s+(currently\s+|now\s+)?"
    r"(running|up(?!\s+to\s+date)|down|online|offline|reachable|unreachable|listening|"
    r"stopped|healthy|unhealthy|degraded|failing|connected|disconnected|available|unavailable)\b"
    r"|\bas of (today|now|\d{4}-\d{2}-\d{2})\b"
    r"|\bport\s+\d+\s+(is\s+)?(open|closed|listening)\b",
    re.IGNORECASE,
)
# NOTE: bare freshness adverbs ("currently", "right now") are deliberately NOT triggers — they
# fire on durable prose ("currently agents don't ...") too. They only count when attached to a
# status above ("is currently down"). High precision: better to miss than to mislabel.


def _detect_volatile(content):
    """True if `content` asserts a transient operational status (see _VOLATILE_RE). Conservative."""
    try:
        return bool(_VOLATILE_RE.search(content or ""))
    except Exception:
        return False


# A fact written as a correction usually names what it contravenes in prose, e.g.
# "resolves #119" / "CORRECTION to fact #275". The audit parses these so it can flag a
# correction whose target is still live (the agent appended but never reconciled).
_REFERENCE_RE = re.compile(r"(?:resolves|supersedes|obsoletes|corrects?|correction to)\s+(?:fact\s+)?#(\d+)",
                           re.IGNORECASE)


def _parse_fact_references(content):
    """Local fact ids this content claims to resolve/supersede/obsolete/correct (see _REFERENCE_RE)."""
    try:
        return [int(m) for m in _REFERENCE_RE.findall(content or "")]
    except Exception:
        return []


def remember(args):
    """Store a fact. Confidence is DERIVED from the number of distinct sources that
    asserted identical content (not from repetition) — see _recompute_confidence.
    Transient operational-status claims are auto-tagged `volatile` so the audit re-checks them.
    `--resolves N` links this write to a prior fact it corrects and soft-retracts N (deliberate
    negative evidence, reversible) so the corpus reconciles instead of asserting both at once."""
    if getattr(args, "gate", False) and not _is_salient(args.content):
        print(f"Skipped (low salience): {args.content[:60]}")
        return
    tags = args.tags.split(",") if args.tags else []
    tl = [t.strip().lower() for t in tags]
    detected = _detect_volatile(args.content)
    already = "volatile" in tl or any(t.startswith("ttl:") for t in tl)
    opted_out = getattr(args, "no_volatile", False)
    auto_volatile = detected and not already and not opted_out
    if auto_volatile:
        tags.append("volatile")
    elif detected and not already and opted_out:
        tags.append("durable")   # record the opt-out so audit-time detection honors it

    source = args.source or os.environ.get("HERMES_AGENT", "manual")

    # --resolves: resolve the target fact's journal identity + content up front (like
    # `decide --supersedes`). A missing target is a warning, not an error — never lose content.
    resolves_ref = resolved_content = None
    if getattr(args, "resolves", None):
        conn0 = get_conn()
        resolves_ref = _index_lookup(conn0, "fact", args.resolves)
        row0 = conn0.execute("SELECT content FROM facts WHERE id = ?", (args.resolves,)).fetchone()
        conn0.close()
        if resolves_ref is None or row0 is None:
            print(f"  ⚠ no fact #{args.resolves} to resolve — writing the fact without a resolve link")
            resolves_ref = None
        else:
            resolved_content = row0["content"]

    payload = {
        "content": args.content,
        "tags": tags,
        "importance": args.importance,
        "source": source,
    }
    if resolves_ref:
        payload["resolves_ref"] = resolves_ref
    entry = append_journal("fact", payload)

    conn = get_conn()
    res = persist_fact(conn, entry)
    if resolves_ref:
        resolve_resolves(conn, entry)
        # Soft retract of the resolved fact: deliberate negative evidence, NOT an owner-forget.
        append_journal("retract", {
            "retracts_ref": resolves_ref,
            "reason": f"resolved by fact #{res['id']}",
            "source": source,
        })

    # Read the journal ONCE after both appends, then reproject confidence per affected content
    # (keeps the live path consistent with rebuild without a full rebuild).
    all_entries = merkle.read_all_entries(JOURNAL_DIR)
    gov = _governance_state(all_entries)
    cev = _content_evidence(all_entries, gov)
    ev = cev.get(args.content, {"pos": {}, "neg": {}, "forget": False, "last_ts": ""})
    n = len(ev["pos"])
    conf = _content_confidence(ev, gov)
    _apply_content_confidence(conn, args.content, ev, gov)
    if resolved_content is not None:
        ev2 = cev.get(resolved_content, {"pos": {}, "neg": {}, "forget": False, "last_ts": ""})
        _apply_content_confidence(conn, resolved_content, ev2, gov)
    conn.commit()
    conn.close()

    src_word = "identity" if n == 1 else "identities"
    if res["inserted"]:
        print(f"Remembered as fact #{res['id']} (confidence {conf:.2f}, {n} {src_word})")
    else:
        print(f"Corroborated fact #{res['id']} (confidence {conf:.2f}, {n} {src_word})")
    if resolves_ref:
        print(f"  ↩ resolved fact #{args.resolves} (soft retract — reversible; "
              f"`hv retract {args.resolves} --owner` to forget it decisively)")
    if auto_volatile:
        print("  ↻ tagged volatile (transient status — the audit will flag it to re-check; "
              "use --no-volatile to opt out)")


def retract(args):
    """Record NEGATIVE evidence against a fact (soft-forget). Confidence stays a derived
    projection: a peer retract counts negative (can drive 'rejected'); --owner forgets it
    (governance — to the forget floor, regardless of corroboration). Never a self-set number.
    The journal keeps the fact + the retract (auditable; reversible by re-corroboration)."""
    conn = get_conn()
    ref = _index_lookup(conn, "fact", args.fact_id)
    row = conn.execute("SELECT content FROM facts WHERE id = ?", (args.fact_id,)).fetchone()
    conn.close()
    if ref is None or row is None:
        print(f"No fact #{args.fact_id}")
        return
    content = row["content"]
    if args.owner:
        # Owner-forget. Once an owner is established it must be cryptographically authorized:
        # require the owner key and sign the retract, so a bare `--owner` source tag can no longer
        # forge governance. Before any owner exists, the legacy unsigned forget still works.
        gov0 = _governance_state(merkle.read_all_entries(JOURNAL_DIR))
        owner_seed = _owner_seed()
        if gov0["owner_id"] and owner_seed is None:
            print("Owner-forget now requires the owner key (an owner is established). "
                  "Run this on the owner machine.")
            return
        payload = {"retracts_ref": ref, "reason": args.reason or "", "source": "owner:owner/owner"}
        if owner_seed is not None:
            payload = _sign_governance_payload(payload, owner_seed, _ed25519.pub_from_seed(owner_seed))
        append_journal("retract", payload)
    else:
        source = args.source or os.environ.get("HERMES_AGENT", "manual")
        append_journal("retract", {"retracts_ref": ref, "reason": args.reason or "", "source": source})

    conn = get_conn()
    all_entries = merkle.read_all_entries(JOURNAL_DIR)
    gov = _governance_state(all_entries)
    ev = _content_evidence(all_entries, gov).get(
        content, {"pos": {}, "neg": {}, "forget": False, "last_ts": ""})
    conf = _content_confidence(ev, gov)
    _apply_content_confidence(conn, content, ev, gov)
    conn.commit()
    conn.close()
    kind = "FORGOTTEN (owner)" if args.owner else "retracted"
    print(f"Fact #{args.fact_id} {kind} → confidence {conf:.2f}")


def _fts_query(raw):
    """Turn arbitrary user input into a safe FTS5 MATCH expression: each term
    becomes a quoted token (implicit AND), so punctuation can't be parsed as an
    operator. Returns None if there are no terms."""
    terms = raw.split()
    if not terms:
        return None
    return " ".join('"' + t.replace('"', '""') + '"' for t in terms)


_FACT_COLS = "id, content, tags, confidence, contested, last_evidence_at, source_agent, created_at"


def _query_facts(conn, query, limit=200):
    """Facts matching `query` via FTS5 (falling back to LIKE when FTS is unavailable or the query
    has no tokens). The shared read used by `hv search` and the dashboard /api/search."""
    fts_expr = _fts_query(query)
    if fts_expr is not None:
        try:
            return conn.execute(
                f"SELECT {', '.join('f.' + c for c in _FACT_COLS.split(', '))} "
                f"FROM facts f JOIN facts_fts ON f.id = facts_fts.rowid "
                f"WHERE facts_fts MATCH ? LIMIT ?", (fts_expr, limit)).fetchall()
        except sqlite3.OperationalError:
            pass  # FTS unavailable — fall back
    return conn.execute(f"SELECT {_FACT_COLS} FROM facts WHERE content LIKE ? LIMIT ?",
                        (f"%{query}%", limit)).fetchall()


def _query_decisions(conn, query, limit=10):
    """Decisions matching `query` (LIKE over content/rationale/tags), newest-first. No FTS /
    confidence projection — the table is small. Superseded ones are included (flagged by caller)."""
    like = f"%{query}%"
    return conn.execute(
        "SELECT id, content, rationale, tags, source_agent, created_at, superseded_by "
        "FROM decisions WHERE content LIKE ? OR rationale LIKE ? OR tags LIKE ? "
        "ORDER BY created_at DESC LIMIT ?", (like, like, like, limit)).fetchall()


def search(args):
    """Search facts AND decisions. Facts rank/filter by EFFECTIVE confidence (the time-invariant base
    projection decayed by recency, computed at query time with $HIVE_NOW) and surface contested claims.
    Decisions have no confidence projection, so they match by content/rationale/tags (newest-first,
    superseded ones flagged) — finding a decision by tag/text is the stable alternative to citing its
    node-local `#id`."""
    conn = get_conn()
    now = os.environ.get("HIVE_NOW") or _now_iso()
    rows = _query_facts(conn, args.query)
    dec_rows = _query_decisions(conn, args.query)
    conn.close()

    # Decay + threshold + rank in Python (effective confidence depends on `now`).
    scored = [(_effective_confidence(r["confidence"], r["last_evidence_at"], now), r) for r in rows]
    scored = [(eff, r) for eff, r in scored if eff >= args.min_confidence]
    scored.sort(key=lambda x: (x[0], x[1]["created_at"]), reverse=True)
    scored = scored[:10]

    if args.format == "json":
        # Stays a flat list (back-compat) with a new `kind` discriminator; decisions carry no
        # confidence, so a min_confidence>0 consumer naturally drops them.
        out = [{**dict(r), "kind": "fact", "effective_confidence": eff} for eff, r in scored]
        out += [{**dict(r), "kind": "decision"} for r in dec_rows]
        print(json.dumps(out, indent=2))
    else:
        for eff, r in scored:
            tags = json.loads(r["tags"]) if r["tags"] else []
            flag = "  ⚠ CONTESTED" if r["contested"] else ""
            print(f"[{r['id']}] {r['content']}")
            print(f"     Tags: {', '.join(tags)}  Conf: {eff:.2f}  From: {r['source_agent']}{flag}")
            print()
        if dec_rows:
            print("Decisions:")
            for r in dec_rows:
                dtags = json.loads(r["tags"]) if r["tags"] else []
                tagstr = f"  [{', '.join(dtags)}]" if dtags else ""
                sup = "  ⚠ SUPERSEDED" if r["superseded_by"] else ""
                print(f"  #{r['id']} {r['content']}{tagstr}{sup}")
                if r["rationale"]:
                    print(f"       ↳ {r['rationale']}")
            print()


def decide(args):
    """Record a decision. `--tags` scopes it (e.g. by project) and is journaled in the
    decision payload, so the decision is findable by `hv search` alongside facts — the stable
    alternative to citing a decision by its node-local, rebuild-unstable `#id`."""
    # Resolve --supersedes (a local id) to a journal-identity reference so the
    # supersedes link survives rebuilds and cross-node merges.
    supersedes_ref = None
    if args.supersedes:
        conn0 = get_conn()
        supersedes_ref = _index_lookup(conn0, "decision", args.supersedes)
        conn0.close()

    tags = [t.strip() for t in args.tags.split(",")] if getattr(args, "tags", None) else []
    tags = [t for t in tags if t]
    payload = {
        "content": args.content,
        "rationale": args.rationale,
        "supersedes_ref": supersedes_ref,
        "tags": tags,
        "source": os.environ.get("HERMES_AGENT", "manual"),
    }
    entry = append_journal("decision", payload)

    conn = get_conn()
    res = persist_decision(conn, entry)
    if supersedes_ref:
        resolve_supersedes(conn, entry)
    conn.commit()
    conn.close()

    tagnote = f"  [{', '.join(tags)}]" if tags else ""
    print(f"Decided as decision #{res['id']}{tagnote}")


# ── Dashboard read API (operator-facing; reused by the sync daemon's /api/* and by `hv dash`) ──
# Pure read functions returning JSON-able dicts. They reuse the same projections the CLI uses
# (confidence decay, governance, search), so the dashboard never drifts from `hv`. Read-only:
# they never write the journal or store.db. The daemon already serves the corpus over the tailnet
# via /sync/chunk, so /api/* exposes nothing the sync surface doesn't already.
def _is_self_owner(gov):
    """True iff THIS device holds the owner key AND is the established owner (same test the
    boot-time pending-admissions notice uses). Best-effort; False when no owner key is present."""
    try:
        if _ed25519 is None or _owner_seed() is None:
            return False
        return gov.get("owner_id") == _owner_id_for_pub(_ed25519.pub_from_seed(_owner_seed()))
    except Exception:
        return False


def _short_root(root):
    disp = root if (root or "").startswith("sha256:") else ("sha256:" + root if root else "")
    return (disp[:18] + "…" + disp[-8:]) if len(disp) > 30 else (disp or "?")


def api_overview():
    """Header + counts for the dashboard Overview. Cheap: counts + one merkle root, no network."""
    entries = merkle.read_all_entries(JOURNAL_DIR)
    gov = _governance_state(entries)
    conn = get_conn()
    nf = conn.execute("SELECT count(*) FROM facts").fetchone()[0]
    nd = conn.execute("SELECT count(*) FROM decisions").fetchone()[0]
    contested = conn.execute("SELECT count(*) FROM facts WHERE contested = 1").fetchone()[0]
    conn.close()
    root = merkle.merkle_root(merkle.chunk_hashes(entries))
    return {
        "node": NODE_LABEL, "node_id": NODE_ID,
        "hive": gov.get("hive_id"), "owner_id": gov.get("owner_id"),
        "role": "OWNER" if _is_self_owner(gov) else "MEMBER",
        "contract": CONTRACT_VERSION,
        "facts": nf, "decisions": nd, "contested": contested,
        "nodes": len(gov.get("admitted") or set()),
        "address": _self_address() or "",
        "merkle": _short_root(root), "merkle_full": root,
    }


def api_search(query="", tag=None, kind="all", min_confidence=0.0,
               limit=50, offset=0, sort="salience", status="all"):
    """Facts + decisions for `query`, mirroring `hv search` but PAGINATED and sortable/filterable.
    `sort`: salience (effective confidence, default) | recency (created). `status` (facts): all (live,
    >= min_confidence) | contested | forgotten (owner-forgotten, normally hidden) | volatile. Returns
    the page slice plus `*_total` so the UI can page; empty query browses everything."""
    conn = get_conn()
    now = os.environ.get("HIVE_NOW") or _now_iso()
    facts, decisions, facts_total, dec_total = [], [], 0, 0
    if kind != "decision":
        matched = []
        for r in _query_facts(conn, query or "", limit=10000):
            base = r["confidence"]
            eff = _effective_confidence(base, r["last_evidence_at"], now)
            tags = json.loads(r["tags"]) if r["tags"] else []
            if tag and tag not in tags:
                continue
            tl = [str(t).lower() for t in tags]
            if status == "contested":
                if not r["contested"]:
                    continue
            elif status == "forgotten":
                if base > FORGET_FLOOR:
                    continue
            elif status == "volatile":
                if not ("volatile" in tl or any(t.startswith("ttl:") for t in tl)):
                    continue
            else:  # all live facts at/above the floor (forgotten ones stay hidden here)
                if eff < min_confidence:
                    continue
            matched.append({"id": r["id"], "content": r["content"], "tags": tags,
                            "confidence": round(eff, 2), "contested": bool(r["contested"]),
                            "forgotten": base <= FORGET_FLOOR,
                            "source": r["source_agent"], "created": (r["created_at"] or "")[:10]})
        if sort == "recency":
            matched.sort(key=lambda f: (f["created"], f["confidence"]), reverse=True)
        else:  # salience
            matched.sort(key=lambda f: (f["confidence"], f["created"]), reverse=True)
        facts_total = len(matched)
        facts = matched[offset:offset + limit]
    if kind != "fact":
        dmatched = []
        for r in _query_decisions(conn, query or "", limit=10000):
            tags = json.loads(r["tags"]) if r["tags"] else []
            if tag and tag not in tags:
                continue
            dmatched.append({"id": r["id"], "content": r["content"], "rationale": r["rationale"] or "",
                             "tags": tags, "superseded": bool(r["superseded_by"]),
                             "created": (r["created_at"] or "")[:10]})
        dec_total = len(dmatched)
        decisions = dmatched[offset:offset + limit]
    conn.close()
    return {"facts": facts, "decisions": decisions,
            "facts_total": facts_total, "decisions_total": dec_total,
            "offset": offset, "limit": limit}


def api_tags():
    """All distinct tags across facts + decisions, sorted. Lets the dashboard tag filter stay
    COMPLETE even when the result lists are paginated (the page only carries its own rows' tags)."""
    conn = get_conn()
    tags = set()
    for tbl in ("facts", "decisions"):
        try:
            rows = conn.execute(f"SELECT tags FROM {tbl} WHERE tags IS NOT NULL AND tags != ''").fetchall()
        except Exception:
            continue
        for r in rows:
            try:
                for t in (json.loads(r[0]) if r[0] else []):
                    t = str(t).strip()
                    if t:
                        tags.add(t)
            except Exception:
                continue
    conn.close()
    return {"tags": sorted(tags)}


def api_related(kind, item_id, limit=25):
    """Facts related to a fact/decision by SHARED TAGS (the simple, robust signal) — powers the
    'Related facts' table in a detail view. Excludes the item itself; ranked by number of shared tags,
    then effective confidence. Empty when the source has no tags."""
    conn = get_conn()
    try:
        tbl = "decisions" if kind == "decision" else "facts"
        row = conn.execute(f"SELECT tags FROM {tbl} WHERE id = ?", (item_id,)).fetchone()
        src = set()
        if row and row["tags"]:
            try:
                src = {str(t).strip() for t in json.loads(row["tags"]) if str(t).strip()}
            except Exception:
                src = set()
        if not src:
            return {"related": [], "tags": []}
        now = os.environ.get("HIVE_NOW") or _now_iso()
        out = []
        for r in conn.execute(f"SELECT {_FACT_COLS} FROM facts").fetchall():
            if kind == "fact" and r["id"] == item_id:
                continue
            try:
                ftags = [str(t).strip() for t in (json.loads(r["tags"]) if r["tags"] else [])]
            except Exception:
                ftags = []
            shared = src & set(ftags)
            if not shared:
                continue
            eff = _effective_confidence(r["confidence"], r["last_evidence_at"], now)
            out.append({"id": r["id"], "content": r["content"], "tags": ftags,
                        "confidence": round(eff, 2), "contested": bool(r["contested"]),
                        "shared": sorted(shared), "shared_n": len(shared),
                        "source": r["source_agent"], "created": (r["created_at"] or "")[:10]})
        out.sort(key=lambda x: (x["shared_n"], x["confidence"]), reverse=True)
        return {"related": out[:limit], "tags": sorted(src)}
    finally:
        conn.close()


def api_audit():
    """The real `hv audit` signal as counts (+ a small sample per category) for the dashboard: re-check
    (volatile past freshness), stale (forgotten/contested/decayed), duplicate (same-source redundant +
    paraphrase), contravened (un-reconciled corrections). Light depth — cheap enough for a card."""
    a = _compute_audit(depth="light")

    def sample(items, n=8):
        out = []
        for it in items[:n]:
            r = it[0] if isinstance(it, tuple) else it
            try:
                out.append({"id": r["id"], "content": (r["content"] or "")[:140]})
            except Exception:
                continue
        return out

    return {
        "recheck": len(a["recheck"]),
        "stale": len(a["forgotten"]) + len(a["contested"]) + len(a["decayed"]),
        "duplicate": len(a["redundant"]) + len(a["paraphrase"]),
        "contravened": len(a["contravened"]),
        "samples": {
            "recheck": sample(a["recheck"]),
            "contested": sample(a["contested"]),
            "decayed": sample(a["decayed"]),
            "contravened": sample([c[0] for c in a["contravened"]]),
        },
    }


def _tel_recent_dict(r, node_name=None):
    """One telemetry session row → a JSON-able dict (the unit both views aggregate from)."""
    try:
        m = json.loads(r["models"]) if r["models"] else {}
    except Exception:
        m = {}
    return {"when": (r["started_at"] or r["updated_at"] or "")[:19],
            "session_id": r["session_id"], "started_at": r["started_at"], "updated_at": r["updated_at"],
            "agent": (f'{r["agent"]}:{r["agent_identity"]}'.rstrip(":")) or "-",
            "project": r["project"] or "-",
            "duration_s": r["duration_s"] or 0, "tokens_in": r["tokens_in"] or 0,
            "tokens_out": r["tokens_out"] or 0, "cost_usd": r["cost_usd"], "models": m,
            "node": r["node_id"], "node_name": node_name or NODE_LABEL}


def _tel_aggregate(recents, limit, offset, sort="recent", project=None, agent=None, node=None,
                   day=None, model=None):
    """Shared telemetry projection over a list of per-session dicts: compute `facets`, FILTER by
    node/project/agent/day/model, total + by-day + by-model over the FILTERED set, then SORT
    (recent|cost|tokens|duration) and paginate. `day`/`model` let the by-day bars and by-model rows
    drill in. Used by both the per-node and hive-combined views so they behave identically."""
    facets = {"projects": sorted({x["project"] for x in recents}),
              "agents": sorted({x["agent"] for x in recents}),
              "nodes": sorted({(x.get("node_name") or x.get("node") or "-") for x in recents})}

    def keep(x):
        if project and x["project"] != project:
            return False
        if agent and x["agent"] != agent:
            return False
        if node and (x.get("node_name") or x.get("node")) != node:
            return False
        if day and (x.get("when") or "")[:10] != day:
            return False
        if model and model not in (x.get("models") or {}):
            return False
        return True
    f = [x for x in recents if keep(x)]
    tot = {"sessions": len(f), "duration_s": 0.0, "tokens_in": 0, "tokens_out": 0, "cost_usd": 0.0, "priced": False}
    by_day, by_model = {}, {}
    for x in f:
        tot["duration_s"] += x["duration_s"] or 0
        tot["tokens_in"] += x["tokens_in"] or 0
        tot["tokens_out"] += x["tokens_out"] or 0
        if x["cost_usd"] is not None:
            tot["cost_usd"] += x["cost_usd"]
            tot["priced"] = True
        d = (x["when"] or "")[:10]
        if d:
            by_day[d] = by_day.get(d, 0) + 1
        for mname, mv in (x.get("models") or {}).items():
            pm = by_model.setdefault(mname, {"in": 0, "out": 0, "cost": 0.0, "priced": False})
            pm["in"] += mv.get("in", 0)
            pm["out"] += mv.get("out", 0)
            if "cost" in mv:
                pm["cost"] += mv["cost"]
                pm["priced"] = True
    if not tot["priced"]:
        tot["cost_usd"] = None
    keyf = {"cost": lambda x: x["cost_usd"] or 0,
            "tokens": lambda x: (x["tokens_in"] or 0) + (x["tokens_out"] or 0),
            "duration": lambda x: x["duration_s"] or 0}.get(sort, lambda x: x["when"] or "")
    f = sorted(f, key=keyf, reverse=True)
    return {"totals": tot, "recent": f[offset:offset + limit], "recent_total": len(f),
            "by_day": [{"day": d, "sessions": c} for d, c in sorted(by_day.items())][-21:],
            "by_model": by_model, "facets": facets}


def api_telemetry(limit=25, offset=0, sort="recent", project=None, agent=None, node=None,
                  day=None, model=None):
    """This node's session telemetry (LOCAL, never synced) — sortable, filterable, paginated. Read-only."""
    try:
        rows = _telemetry_rows("")
    except Exception:
        return {"available": False, "node": NODE_LABEL, "node_id": NODE_ID, "totals": {},
                "recent": [], "by_day": [], "by_model": {}, "facets": {}}
    agg = _tel_aggregate([_tel_recent_dict(r) for r in rows], limit, offset, sort, project, agent, node, day, model)
    return {"available": True, "node": NODE_LABEL, "node_id": NODE_ID, **agg}


def api_telemetry_hive(limit=25, offset=0, sort="recent", project=None, agent=None, node=None,
                       day=None, model=None, per_node_cap=2000, timeout=15):
    """COMBINED telemetry across the hive — the daemon fetches each REACHABLE admitted peer's
    /api/telemetry concurrently and merges with the local DB into one feed, then sorts/filters/paginates.
    Telemetry is local + unsynced, so an OFFLINE node contributes nothing: `nodes` lists EVERY admitted
    device with its reachability + session count, and `admitted`/`reachable` make the gap explicit rather
    than silent. (Offline-inclusive totals would need a synced rollup — a deliberate follow-up.)"""
    collected = [(NODE_LABEL, NODE_ID, api_telemetry(limit=per_node_cap, offset=0), True)]
    peers = api_peers(probe=True)

    def _live(p):   # reachable NOW (has an address AND its sync status isn't offline/stale)
        st = (p.get("status") or "").lower()
        return ":" in (p.get("addr") or "") and not any(x in st for x in ("offline", "stale", "no address"))
    targets = [(p["name"], p["device"], p["addr"]) for p in peers if not p["self"] and _live(p)]
    unreachable = [(p["name"], p["device"]) for p in peers if not p["self"] and not _live(p)]
    if targets:
        import concurrent.futures
        import requests

        def fetch(t):
            name, nid, addr = t
            try:
                tel = requests.get(f"http://{addr}/api/telemetry?limit={per_node_cap}&offset=0",
                                   timeout=timeout).json()
                return (name, nid, tel, True)
            except Exception:
                return (name, nid, None, False)
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(16, len(targets))) as ex:
            collected.extend(ex.map(fetch, targets))

    nodes, all_recent = [], []
    for i, (name, nid, tel, ok) in enumerate(collected):
        avail = bool(tel and tel.get("available") and "totals" in tel)
        # collected[0] is self; the rest came from `targets`, i.e. they ARE sync-reachable. So a peer
        # that answered sync but has no telemetry is ONLINE on older code, NOT offline.
        status = "self" if i == 0 else ("online" if avail else "no-telemetry")
        nodes.append({"node": name, "node_id": nid, "status": status, "reachable": avail,
                      "sessions": tel.get("totals", {}).get("sessions", 0) if avail else 0})
        if avail:
            for x in tel.get("recent", []):
                row = dict(x)
                row["node_name"] = name
                all_recent.append(row)
    for name, nid in unreachable:
        nodes.append({"node": name, "node_id": nid, "status": "offline", "reachable": False, "sessions": 0})
    order = {"self": 0, "online": 1, "no-telemetry": 2, "offline": 3}
    nodes.sort(key=lambda n: (order.get(n["status"], 9), n["node"]))
    agg = _tel_aggregate(all_recent, limit, offset, sort, project, agent, node, day, model)
    return {"available": True, "scope": "hive", "nodes": nodes, "admitted": len(nodes),
            "online": sum(1 for n in nodes if n["status"] != "offline"),
            "reporting": sum(1 for n in nodes if n["status"] in ("self", "online")),
            "reachable": sum(1 for n in nodes if n["reachable"]), **agg}


def _probe_peer_map(timeout=6):   # generous: mobile/Termux nodes over the tailnet can answer in 3-4s
    """Concurrently probe the local .peers.json peers — /sync/hello → node_id, /hive/info → label,
    /sync/merkle-root vs ours → in-sync|diverged. Returns {node_id: (address, status, label)}. Bounded
    by ONE short timeout (all probes run concurrently), so offline peers can't serialize into a long
    hang. Empty when `requests` or the peer list is unavailable. Same resolution `hv peers` uses, but
    parallel — this is what fills in a directly-admitted peer's name/address (the gregorius gap)."""
    try:
        import concurrent.futures
        import requests
        import sync_common
        peerlist = sync_common.load_peers().get("peers", []) or []
    except Exception:
        return {}
    if not peerlist:
        return {}
    local_root = merkle.merkle_root(merkle.chunk_hashes(merkle.read_all_entries(JOURNAL_DIR)))

    def probe(peer):
        url = str(peer.get("url", "")).rstrip("/")
        if not url:
            return None
        try:
            nid = requests.get(url + "/sync/hello", timeout=timeout).json().get("node_id")
        except Exception:
            return None
        if not nid:
            return None
        try:
            root = requests.get(url + "/sync/merkle-root", timeout=timeout).json().get("root_hash")
            st = "in sync" if root == local_root else "diverged"
        except Exception:
            st = "reachable"
        try:
            lbl = requests.get(url + "/hive/info", timeout=timeout).json().get("label", "")
        except Exception:
            lbl = ""
        # owner-supplied local name OVERRIDES the node's own label: a "label" on the .peers.json entry
        # wins over a node's self-reported label (e.g. an Android/Termux generic hostname like
        # "localhost-…"), so the owner can name a peer (zfold-6) and it stays consistent even when the
        # slow node's /hive/info probe times out.
        return (nid, url.replace("http://", "").replace("https://", ""), st, peer.get("label", "") or lbl)

    out = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(16, len(peerlist))) as ex:
        for res in ex.map(probe, peerlist):
            if res:
                out[res[0]] = (res[1], res[2], res[3])
    return out


_PEER_PROBE_CACHE = {"t": 0.0, "map": {}}


def _probe_peer_map_cached(ttl=5):
    """`_probe_peer_map` with a short TTL cache. The daemon is a long-lived process, so a Hive-tab view
    followed by a node drill-down (which each need the peer→address map) reuses one probe instead of
    re-probing every peer per request."""
    import time
    now = time.monotonic()
    if _PEER_PROBE_CACHE["map"] and (now - _PEER_PROBE_CACHE["t"]) < ttl:
        return _PEER_PROBE_CACHE["map"]
    m = _probe_peer_map()
    _PEER_PROBE_CACHE.update(t=now, map=m)
    return m


def api_node_addr(node_id):
    """The 'host:port' for an admitted, reachable peer (from the cached probe), or None. The ONLY way a
    node-scoped request resolves a target address — callers never pass a host — so the daemon's per-node
    proxy can't be pointed at an arbitrary address (no SSRF)."""
    if not node_id or node_id == NODE_ID:
        return None
    info = _probe_peer_map_cached().get(node_id)
    return info[0] if info else None


