_NUDGE_DEFAULTS = {
    "SAVE_EVERY": "0",       # save-nudge turn-cadence (0 = off; phrase-first by default, audit-on-boot is the floor)
    "MIN_GAP": "6",          # hard floor: no two save-nudges within N turns
    "SAVE_ON_PHRASE": "1",   # a matched phrase may trigger a save-nudge (still gated by MIN_GAP)
    "AUDIT_ON": "precompact,sessionend",
    "AUDIT_DEPTH": "light",
    "VOLATILE_TTL_HOURS": "24",   # default freshness window for facts tagged `volatile`
    # Seeds inferred from real session history (see scripts/infer-phrases.py).
    "HIVE_NUDGE_PHRASES": ("we need,we should,i want,idea,wait,before we,keep,"
                           "remember,decision,the issue,lesson,wrong"),
}


def load_nudge_config():
    """Read nudge.env (KEY=value) from HIVE_HOME, falling back to the repo root, then
    defaults. Same-named env vars OVERRIDE the file (test + future-telemetry seam).
    Mirrors sync_common.load_peers()'s per-node + ROOT-fallback pattern."""
    cfg = dict(_NUDGE_DEFAULTS)
    root = Path(__file__).resolve().parent
    for p in (HIVE_HOME / "nudge.env", root / "nudge.env"):
        try:
            if p.exists():
                for line in p.read_text().splitlines():
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, _, v = line.partition("=")
                    cfg[k.strip()] = v.strip()
                break
        except Exception:
            pass
    for k in list(cfg):
        if k in os.environ:
            cfg[k] = os.environ[k]
    return cfg


def _int(cfg, key, default):
    try:
        return int(str(cfg.get(key, default)).strip())
    except Exception:
        return default


def _nudge_phrases(cfg):
    return [p.strip().lower() for p in cfg.get("HIVE_NUDGE_PHRASES", "").split(",") if p.strip()]


def _nudge_state_path(session):
    safe = re.sub(r"[^A-Za-z0-9_-]", "_", session or "")[:80] or "_anon"
    d = HIVE_HOME / ".nudge_state"
    d.mkdir(parents=True, exist_ok=True)
    return d / f"{safe}.json"


def _read_state(path):
    try:
        return json.loads(path.read_text())
    except Exception:
        return {"turns": 0, "last_save_turn": 0}


def _write_state(path, state):
    try:
        path.write_text(json.dumps(state))
    except Exception:
        pass


# Nudge strings are HINTS — never auto-writes; the agent stays the salience judge.
_NUDGE_SAVE_CADENCE = ('[hive] Several turns in — if a decision, outcome, correction, or '
                       'constraint surfaced, consider: hv remember "..." --source claude-code '
                       '(search first; skip if already known).')
_NUDGE_SAVE_PHRASE = ('[hive] That sounded worth keeping — if it is a durable decision/outcome/'
                      'fact, consider hv remember "..." --source claude-code (your call).')
_NUDGE_AUDIT = ('[hive] Session winding down — consider running: hv audit '
                '(surfaces redundant / obsolete / missing facts to reconcile before you go).')


def _project_key(cwd):
    """Project identity for the startup digest: git origin basename, else cwd basename."""
    import subprocess
    try:
        url = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=3).stdout.strip()
        if url:
            base = url.rstrip("/").split("/")[-1]
            return base[:-4] if base.endswith(".git") else base
    except Exception:
        pass
    return os.path.basename(os.path.normpath(cwd)) if cwd else ""


def _print_digest(cwd, cap=1200):
    """SessionStart: print a short, project-scoped digest of top facts (injected into context)."""
    try:
        key = _project_key(cwd)
        if not key:
            return
        conn = get_conn()
        now = os.environ.get("HIVE_NOW") or _now_iso()
        cols = "id, content, confidence, last_evidence_at, created_at"
        rows = None
        expr = _fts_query(key)
        if expr is not None:
            try:
                rows = conn.execute(
                    f"SELECT {', '.join('f.' + c for c in cols.split(', '))} "
                    "FROM facts f JOIN facts_fts ON f.id = facts_fts.rowid "
                    "WHERE facts_fts MATCH ? LIMIT 200", (expr,)).fetchall()
            except sqlite3.OperationalError:
                rows = None
        if rows is None:
            rows = conn.execute(f"SELECT {cols} FROM facts WHERE content LIKE ? LIMIT 200",
                                (f"%{key}%",)).fetchall()
        conn.close()
        scored = [(_effective_confidence(r["confidence"], r["last_evidence_at"], now), r) for r in rows]
        scored = [t for t in scored if t[0] > 0]
        scored.sort(key=lambda x: (x[0], x[1]["created_at"]), reverse=True)
        if not scored:
            return
        lines = [f'[hive] Project context: {key}  (top facts; `hv search "<topic>"` for more)']
        for eff, r in scored[:5]:
            lines.append(f"  • [{r['id']}] {r['content'].splitlines()[0][:150]} (conf {eff:.2f})")
        print("\n".join(lines)[:cap])
    except Exception:
        return


def _pending_admissions(entries, gov):
    """Devices that asked to join (a `join-request`) but aren't admitted yet → [{device_id, label}].
    Deterministic; an admit for a device clears it. Empty before any owner exists."""
    if not gov.get("owner_id"):
        return []
    out = {}
    for e in entries:
        if e.get("type") == "governance" and e.get("payload", {}).get("action") == "join-request":
            p = e["payload"]
            d = p.get("device_id")
            if d and d not in gov["admitted"] and d not in gov.get("denied", set()):
                out[d] = p.get("label", "")
    return [{"device_id": d, "label": lbl} for d, lbl in out.items()]


def _print_pending_admissions():
    """SessionStart: on the OWNER node, surface pending join-requests into the agent's context, so
    admitting a teammate's device bubbles up like an interrupt. Silent on non-owner nodes."""
    try:
        if _ed25519 is None or _owner_seed() is None:
            return
        entries = merkle.read_all_entries(JOURNAL_DIR)
        gov = _governance_state(entries)
        if gov["owner_id"] != _owner_id_for_pub(_ed25519.pub_from_seed(_owner_seed())):
            return   # this device holds an owner key, but isn't the established owner
        pend = _pending_admissions(entries, gov)
        if pend:
            who = ", ".join(f"{r['label'] or r['device_id']} ({r['device_id']})" for r in pend[:5])
            print(f"[hive] {len(pend)} device(s) awaiting admission: {who}. "
                  "Review with `hv admit`; admit with `hv admit <device_id> --principal <name>`.")
    except Exception:
        return


def _self_membership(gov):
    """THIS device's standing in the established hive: returns (status, principal) where status is
    'owner' | 'fertile' | 'sterile' | 'no-hive'. Pure projection over governance — same on every node."""
    if not gov.get("owner_id"):
        return "no-hive", None
    if (_ed25519 is not None and _owner_seed() is not None
            and _owner_id_for_pub(_ed25519.pub_from_seed(_owner_seed())) == gov["owner_id"]):
        return "owner", gov["principals"].get(NODE_ID)
    if NODE_ID in gov["admitted"]:
        return "fertile", gov["principals"].get(NODE_ID)
    return "sterile", None


def _print_self_status():
    """SessionStart: tell THIS device its standing ONLY when there's something to act on — it's
    sterile (read-only) or has a request pending. Quiet when fertile/owner (no action needed; the
    owner separately gets the pending-admissions tickle). Mirrors the 'silent unless actionable' rule."""
    try:
        entries = merkle.read_all_entries(JOURNAL_DIR)
        gov = _governance_state(entries)
        if not gov["owner_id"]:
            return
        status, _principal = _self_membership(gov)
        if status != "sterile":
            return
        pending = any(r["device_id"] == NODE_ID for r in _pending_admissions(entries, gov))
        tail = ("a join request is pending — the owner will admit you" if pending
                else "run `hv join --principal <you>` to request write access")
        print(f"[hive] you are STERILE (read-only) in {gov['hive_id']} — {tail}. (`hv whoami` for details)")
    except Exception:
        return


def whoami_cmd(args):
    """Show THIS device's identity and membership standing in the hive (read-only; no side effects)."""
    entries = merkle.read_all_entries(JOURNAL_DIR)
    gov = _governance_state(entries)
    print(f"device:    {NODE_ID}  ({NODE_LABEL})")
    if not gov["owner_id"]:
        print("hive:      (none — no owner established yet)")
        print("status:    UNAFFILIATED  (`hv owner init` to start a hive, or sync one then `hv join`)")
        return
    status, principal = _self_membership(gov)
    print(f"hive:      {gov['hive_id']}")
    print(f"owner:     {gov['owner_id']}")
    desc = {
        "owner":   "OWNER — you hold the owner key (governance: admit / config / forget)",
        "fertile": "FERTILE — admitted; your writes land in the shared journal and count",
        "sterile": "STERILE — read-only; you read the whole hive but your content won't land until admitted",
    }[status]
    print(f"status:    {desc}")
    if principal:
        print(f"principal: {principal}")
    if status == "owner" and gov["nominations"]:
        sids = sorted(_owner_id_for_pub(base64.b64decode(c)) for c in gov["nominations"])
        print(f"           open succession nomination(s): {', '.join(sids)} (successor runs `hv owner claim`)")
    if gov["elections"] and status in ("owner", "fertile"):
        armed = sum(1 for e in gov["elections"] if e["armed"] and not e["installed"])
        tail = (" — heartbeat to defend (`hv owner heartbeat`)" if status == "owner" and armed
                else " (vote with `hv owner vote <id>`)" if status == "fertile" else "")
        print(f"           {len(gov['elections'])} open owner-election(s)"
              + (f", {armed} dead-man-armed" if armed else "") + tail)
    if status == "sterile":
        pending = any(r["device_id"] == NODE_ID for r in _pending_admissions(entries, gov))
        print("           " + (f"join request pending — owner runs `hv admit {NODE_ID}`" if pending
                               else "`hv join --principal <you>` to request write access"))


def _spec_update_check(agent):
    """§0 of the Agent Integration Spec: compare the running hv's CONTRACT_VERSION
    (SemVer MAJOR.MINOR) to what this agent last integrated against, and nudge to
    re-integrate ONLY on a MAJOR (breaking) bump. MINOR bumps are additive and
    backward-compatible → record silently, no action. Best-effort; marks once per
    version per agent."""
    try:
        cur = CONTRACT_VERSION
        cur_major = cur.split(".", 1)[0]
        safe = re.sub(r"[^A-Za-z0-9_.-]", "_", agent or "agent")[:60] or "agent"
        marker = HIVE_HOME / ".nudge_state" / f"{safe}.spec"
        marker.parent.mkdir(parents=True, exist_ok=True)
        prev = marker.read_text().strip() if marker.exists() else ""
        if prev == cur:
            return
        if prev and prev.split(".", 1)[0] != cur_major:   # MAJOR (breaking) bump only
            print(f"[hive] BREAKING: integration contract is now v{cur} (you integrated v{prev}) — "
                  "re-integrate per docs/AGENT_INTEGRATION.md; the previous major is deprecated.")
        # first run, or an additive MINOR bump (backward-compatible): record silently.
        marker.write_text(cur)
    except Exception:
        return


def _freshness_check():
    """Warn (read-only) if this checkout's adapter code is behind origin/main, so an agent never
    silently runs a stale adapter. We refresh the remote ref with a short, credential-less,
    throttled fetch and COUNT commits behind — we never pull, never touch the working tree, never
    block. Safe on a dev checkout (counting/fetch don't alter local files). Silent when current,
    offline, or not a git checkout."""
    try:
        root = str(HIVE_HOME)
        # Throttle the network fetch to ~once / 6h; counting always uses the (cached) ref.
        marker = HIVE_HOME / ".nudge_state" / ".last_fetch"
        do_fetch = True
        try:
            if marker.exists():
                last = _to_dt(marker.read_text().strip())
                if last and (datetime.now(timezone.utc).replace(tzinfo=None) - last).total_seconds() < 6 * 3600:
                    do_fetch = False
        except Exception:
            pass
        if do_fetch:
            try:
                subprocess.run(["git", "-C", root, "fetch", "--quiet", "origin", "main"],
                               env=dict(os.environ, GIT_TERMINAL_PROMPT="0"),
                               capture_output=True, timeout=4)
                marker.parent.mkdir(parents=True, exist_ok=True)
                marker.write_text(_now_iso())
            except Exception:
                pass  # offline / slow: fall back to the cached origin/main ref
        out = subprocess.run(["git", "-C", root, "rev-list", "--count", "HEAD..origin/main"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode != 0:
            return
        behind = int((out.stdout or "0").strip() or "0")
        if behind > 0:
            print(f"[hive] heads up: your hive-mind checkout is {behind} commit(s) behind origin/main. "
                  "Run `git pull` + restart to pick up the latest adapter.")
    except Exception:
        return


def nudge(args):
    """Best-effort save/audit nudge or startup digest. NEVER raises (swallow-all)."""
    try:
        cfg = load_nudge_config()
        event = args.event
        if event == "session-start":
            _print_digest(getattr(args, "cwd", "") or os.getcwd())
            _print_pending_admissions()
            _print_self_status()
            _spec_update_check(getattr(args, "agent", "agent") or "agent")
            _freshness_check()
            _audit_boot_summary()
            return
        if event in ("precompact", "sessionend"):
            on = [e.strip() for e in cfg.get("AUDIT_ON", "").split(",") if e.strip()]
            if event in on:
                print(_NUDGE_AUDIT)
            return
        if event == "user-prompt":
            save_every = _int(cfg, "SAVE_EVERY", 12)
            min_gap = _int(cfg, "MIN_GAP", 6)
            on_phrase = str(cfg.get("SAVE_ON_PHRASE", "1")).strip().lower() in ("1", "true", "yes")
            path = _nudge_state_path(args.session)
            st = _read_state(path)
            st["turns"] = int(st.get("turns", 0)) + 1
            _write_state(path, st)                       # advance counter first
            try:
                text = sys.stdin.read() or ""
            except Exception:
                text = ""
            tl = text.lower()
            phrase_hit = on_phrase and any(p in tl for p in _nudge_phrases(cfg))
            cadence_hit = save_every > 0 and st["turns"] % save_every == 0
            if not (phrase_hit or cadence_hit):
                return
            last_save = int(st.get("last_save_turn", 0))   # 0 = never fired → first nudge allowed
            if last_save and (st["turns"] - last_save) < min_gap:
                return
            st["last_save_turn"] = st["turns"]
            _write_state(path, st)
            print(_NUDGE_SAVE_PHRASE if (phrase_hit and not cadence_hit) else _NUDGE_SAVE_CADENCE)
    except Exception:
        return  # never break the session


def _compute_audit(depth=None, session=""):
    """Compute the audit buckets (read-only). One implementation shared by `hv audit` and the
    session-start boot summary. Returns lists + counts; callers format them."""
    cfg = load_nudge_config()
    depth = depth or cfg.get("AUDIT_DEPTH", "light")
    cap = {"light": 3, "normal": 8, "deep": 20}.get(depth, 3)
    now = os.environ.get("HIVE_NOW") or _now_iso()

    entries = merkle.read_all_entries(JOURNAL_DIR)
    counts = collections.Counter()
    idents = collections.defaultdict(set)
    for e in entries:
        if e.get("type") != "fact":
            continue
        p = e.get("payload", {})
        c = p.get("content")
        if c is None:
            continue
        counts[c] += 1
        key, _w = _identity_weight(e.get("node_id"), p.get("source", "manual"))
        idents[c].add(key)

    # REDUNDANT (a): one identity asserted the SAME content more than once.
    redundant = [(c, counts[c], len(idents[c])) for c in counts if counts[c] > len(idents[c])]
    redundant.sort(key=lambda x: x[1] - x[2], reverse=True)
    corroborated = [c for c in counts if len(idents[c]) >= 2]   # GOOD, never flagged

    # REDUNDANT (b): near-duplicate DISTINCT contents from a single shared author.
    paraphrase = []
    if depth in ("normal", "deep"):
        single = sorted([c for c in counts if len(idents[c]) == 1],
                        key=lambda c: counts[c], reverse=True)[:(200 if depth == "deep" else 80)]
        toks = {c: set(re.findall(r"[a-z0-9]{4,}", c.lower())) for c in single}
        thr = 0.5 if depth == "deep" else 0.6
        for i in range(len(single)):
            a = single[i]
            if not toks[a]:
                continue
            for j in range(i + 1, len(single)):
                b = single[j]
                if idents[a] != idents[b] or not toks[b]:
                    continue
                union = len(toks[a] | toks[b])
                if union and len(toks[a] & toks[b]) / union >= thr:
                    paraphrase.append((a, b, round(len(toks[a] & toks[b]) / union, 2)))

    # OBSOLETE + RECHECK: bucket by effective confidence; VOLATILE facts past their freshness
    # window go to RECHECK (re-verify) instead of the slow age-decay path.
    ttl_default = _int(cfg, "VOLATILE_TTL_HOURS", 24)
    conn = get_conn()
    frows = conn.execute(
        "SELECT id, content, confidence, contested, last_evidence_at, tags FROM facts").fetchall()
    conn.close()
    forgotten, contested, decayed, recheck = [], [], [], []
    volatile_contents = set()
    forgotten_contents = set()
    for r in frows:
        try:
            tl = [str(t).strip().lower() for t in (json.loads(r["tags"]) if r["tags"] else [])]
        except Exception:
            tl = []
        # Volatility is a DERIVED projection over content (like confidence): a fact is volatile if
        # tagged volatile/ttl OR its content reads as a transient operational-status claim — UNLESS
        # the owner opted out (`durable`). This retroactively covers facts written before auto-tagging.
        is_volatile = ("volatile" in tl or any(t.startswith("ttl:") for t in tl)
                       or (_detect_volatile(r["content"]) and "durable" not in tl))
        if is_volatile:
            volatile_contents.add(r["content"])
            a, b = _to_dt(r["last_evidence_at"]), _to_dt(now)
            age_h = max(0.0, (b - a).total_seconds() / 3600.0) if (a and b) else None
            ttl_h = _volatile_ttl_hours(tl, ttl_default)
            if age_h is None or age_h > ttl_h:
                recheck.append((r, age_h, ttl_h))
            continue
        base = r["confidence"]
        eff = _effective_confidence(base, r["last_evidence_at"], now)
        if base <= FORGET_FLOOR:
            forgotten_contents.add(r["content"])  # owner-forgotten: keep it out of EVERY bucket
            continue   # decisively settled, no action
        if base <= -0.4:
            forgotten.append((r, eff))
        elif r["contested"]:
            contested.append((r, eff))
        elif base > 0 and eff < 0.2:
            decayed.append((r, eff))
    decayed.sort(key=lambda x: x[1])
    recheck.sort(key=lambda x: (x[1] is not None, x[1] or 0), reverse=True)
    # Re-verifying a volatile fact refreshes its freshness; that is the point, not redundancy.
    # Owner-forgotten contents drop out of every bucket too (else the audit nags about cleared dups).
    redundant = [x for x in redundant if x[0] not in volatile_contents and x[0] not in forgotten_contents]
    paraphrase = [p for p in paraphrase if p[0] not in forgotten_contents and p[1] not in forgotten_contents]
    corroborated = [c for c in corroborated if c not in forgotten_contents]

    missing_note = None
    if session:
        st = _read_state(_nudge_state_path(session))
        gap = int(st.get("turns", 0)) - int(st.get("last_save_turn", 0))
        thresh = _int(cfg, "SAVE_EVERY", 0) or 10   # floor for the proxy when cadence is off
        if gap >= thresh:
            missing_note = (f"{gap} turns since your last hive write this session, "
                            "anything decided/learned worth keeping?")

    return {"depth": depth, "cap": cap, "redundant": redundant, "paraphrase": paraphrase,
            "corroborated": corroborated, "forgotten": forgotten, "contested": contested,
            "decayed": decayed, "recheck": recheck, "missing_note": missing_note}


def audit(args):
    """Surface REDUNDANT (same-source only), OBSOLETE (forgotten/contested/decayed), RECHECK
    (volatile past freshness), and (with --session) a MISSING proxy. Read-only."""
    a = _compute_audit(depth=args.depth, session=getattr(args, "session", ""))
    depth, cap = a["depth"], a["cap"]
    redundant, paraphrase, corroborated = a["redundant"], a["paraphrase"], a["corroborated"]
    forgotten, contested, decayed, recheck = a["forgotten"], a["contested"], a["decayed"], a["recheck"]
    missing_note = a["missing_note"]

    if args.format == "json":
        print(json.dumps({
            "depth": depth,
            "redundant": [{"content": c, "asserts": n, "identities": d} for c, n, d in redundant[:cap]],
            "paraphrase": [{"a": a, "b": b, "overlap": o} for a, b, o in paraphrase[:cap]],
            "obsolete": {
                "forgotten": [{"id": r["id"], "content": r["content"]} for r, _e in forgotten[:cap]],
                "contested": [{"id": r["id"], "content": r["content"]} for r, _e in contested[:cap]],
                "decayed": [{"id": r["id"], "content": r["content"], "eff": e} for r, e in decayed[:cap]],
            },
            "recheck": [{"id": r["id"], "content": r["content"],
                         "age_hours": (round(a, 1) if a is not None else None), "ttl_hours": t}
                        for r, a, t in recheck[:cap]],
            "well_corroborated": len(corroborated),
            "missing": missing_note,
        }, indent=2))
        return

    def short(s):
        return s.replace("\n", " ")[:90]
    print(f"hive audit (depth={depth})\n")
    print(f"REDUNDANT (same-source duplication) — {len(redundant)}")
    for c, n, d in redundant[:cap]:
        print(f'  "{short(c)}"  asserted {n}x by {d} identity(ies) → consider one canonical fact')
    for a, b, o in paraphrase[:cap]:
        print(f'  near-dup ({o}) same author: "{short(a)}" ~ "{short(b)}"')
    if not redundant and not paraphrase:
        print("  (none)")
    print(f"\nOBSOLETE — forgotten {len(forgotten)}, contested {len(contested)}, decayed {len(decayed)}")
    for r, _e in forgotten[:cap]:
        print(f"  [forgotten] #{r['id']} {short(r['content'])} → already soft-gone")
    for r, _e in contested[:cap]:
        print(f"  [contested] #{r['id']} {short(r['content'])} → needs adjudication")
    for r, e in decayed[:cap]:
        print(f"  [decayed eff {e:.2f}] #{r['id']} {short(r['content'])} → re-confirm or `hv retract {r['id']}`")
    if not (forgotten or contested or decayed):
        print("  (none)")
    if recheck:
        print(f"\nRECHECK (volatile facts past freshness) — {len(recheck)}")
        for r, a, t in recheck[:cap]:
            age = f"{a:.0f}h" if a is not None else "unknown"
            print(f"  #{r['id']} {short(r['content'])} (age {age} > ttl {t}h) → re-verify")
    if missing_note:
        print(f"\nMISSING (session proxy)\n  {missing_note}")
    print(f"\nwell-corroborated (good, no action): {len(corroborated)} fact(s) with >=2 independent sources")


def _audit_boot_summary():
    """Audit-on-boot: a one-line summary printed at session start. This is the reliable floor
    that catches what an in-session save-nudge may have missed, since session start fires on
    every runtime even when shutdown/per-turn hooks do not. Best-effort; silent when clean."""
    try:
        a = _compute_audit()
        parts = []
        if a["recheck"]:
            parts.append(f"{len(a['recheck'])} to re-check")
        n_obs = len(a["forgotten"]) + len(a["contested"]) + len(a["decayed"])
        if n_obs:
            parts.append(f"{n_obs} stale/contested")
        if a["redundant"]:
            parts.append(f"{len(a['redundant'])} duplicate")
        if parts:
            print(f"[hive] audit on boot: {', '.join(parts)}. Run `hv audit` to review and reconcile.")
    except Exception:
        return


def _volatile_ttl_hours(tags_lower, default):
    """Freshness window (hours) for a volatile fact: a `ttl:<n>h|d` tag overrides the default."""
    for t in tags_lower:
        m = re.match(r"ttl:(\d+)([hd])$", t)
        if m:
            n = int(m.group(1))
            return n * 24 if m.group(2) == "d" else n
    return default


def version_cmd(args):
    """Print the agent-facing contract version (SemVer). Adapters/installers can
    check this to confirm compatibility or pin to a major."""
    print(f"hv contract-version {CONTRACT_VERSION}")


_VERIFY_EXCLUDE_DIRS = {".git", "node_modules", "__pycache__", ".pytest_cache", ".nudge_state", "journal"}
# The trust artifacts are NOT part of the manifest they vouch for: verify.json holds the digest,
# verify.json.sig signs it, and hivemind.pub is the anchor (its integrity comes from the published
# copy at the canonical site, not from being self-listed). Listing any of them would be circular.
_VERIFY_EXCLUDE_NAMES = {"verify.json", "verify.json.sig", "hivemind.pub", "nudge.env",
                         ".peers.json", ".device-key", ".device-id", ".owner-key"}
_VERIFY_EXTS = {".py", ".sh", ".md", ".txt", ".json", ".mjs", ".yml", ".yaml", ".example", ".toml", ".cfg"}
OFFICIAL_VERIFY_URL = "https://raw.githubusercontent.com/projectmentor/hive-mind/main/verify.json"
# The trust anchor: the public key, served from our own TLS domain (a DIFFERENT origin than the
# code host). A fork can ship its own hivemind.pub, but it cannot change what this URL serves, so a
# bundled key that does not match this one is the tell. Keep this in sync with hivemind.pub on main.
OFFICIAL_PUBKEY_URL = os.environ.get(
    "HIVE_PUBKEY_URL", "https://hivemind.projectmentor.org/.well-known/hivemind.pub")
OFFICIAL_SOURCE = "github.com/projectmentor/hive-mind"


def _git_tracked(root):
    """The set of git-tracked files (relative paths), or None if not a git repo / git unavailable.
    Using the tracked set makes the manifest REPRODUCIBLE: it covers exactly the distributed source,
    so a local untracked file (e.g. .claude/settings.local.json) can never shift the digest."""
    try:
        out = subprocess.run(["git", "-C", str(root), "ls-files", "-z"],
                             capture_output=True, timeout=10)
        if out.returncode != 0:
            return None
        return [n.decode() for n in out.stdout.split(b"\x00") if n]
    except Exception:
        return None


def _source_manifest(root):
    """Deterministic fingerprint of the source code (the files that define behavior). Covers the
    git-tracked source (reproducible from any clean clone); excludes the trust artifacts themselves,
    runtime data, caches, and non-code files. Returns {version, files, digest}."""
    root = Path(root)
    tracked = _git_tracked(root)
    candidates = [root / t for t in tracked] if tracked is not None else list(root.rglob("*"))
    files = {}
    for p in sorted(candidates):
        if not p.is_file():
            continue
        rel = p.relative_to(root)
        if set(rel.parts) & _VERIFY_EXCLUDE_DIRS:
            continue
        if p.name in _VERIFY_EXCLUDE_NAMES or p.name.startswith("store.db") or ".bak" in p.name:
            continue
        if p.name != "hv" and p.suffix.lower() not in _VERIFY_EXTS:
            continue
        try:
            files[str(rel)] = hashlib.sha256(p.read_bytes()).hexdigest()
        except Exception:
            continue
    digest = hashlib.sha256("\n".join(f"{k}:{v}" for k, v in sorted(files.items())).encode()).hexdigest()
    return {"version": CONTRACT_VERSION, "files": files, "digest": digest}


def _b64bytes(s):
    try:
        return base64.b64decode("".join(str(s).split()), validate=False)
    except Exception:
        return None


def _fetch_official_pubkey():
    """Fetch the published public key from our own TLS domain (the trust anchor). Returns 32 raw
    bytes, or None if unreachable / not yet published. Best-effort; never raises.
    Sends a normal User-Agent: the default 'Python-urllib' UA is blocked (403) by the CDN."""
    try:
        req = urllib.request.Request(OFFICIAL_PUBKEY_URL, headers={
            "User-Agent": "Mozilla/5.0 (compatible; hivemind-verify/1.0; +https://hivemind.projectmentor.org)"})
        with urllib.request.urlopen(req, timeout=6) as r:
            return _b64bytes((r.read() or b"").decode("ascii", "ignore"))
    except Exception:
        return None


def _verify_status(root, check_anchor=True):
    """The integrity + authenticity verdict, as data (shared by `verify` and `doctor`).
    Three independent layers, strongest last:
      1. INTEGRITY  — local source fingerprint matches the bundled manifest (verify.json). Catches
         local edits and accidental drift.
      2. SIGNATURE  — the manifest carries a valid Ed25519 signature (verify.json.sig) under the
         bundled public key (hivemind.pub). Catches a fork that changed code: it cannot forge a
         signature without the private key.
      3. KEY ANCHOR — the bundled public key matches the key published at our own TLS domain
         (a different origin than the code host). Catches a fork that ships its OWN key + self-signed
         manifest: the bundled key will not match the one served from hivemind.projectmentor.org.
    Returns {level, version, ok, lines}. `ok` is True once integrity holds and the bundled signature
    (if any) is valid; the key-anchor layer only changes the headline, never `ok`. check_anchor=False
    skips the network layer (fast, offline-safe). Never raises and never blocks."""
    root = Path(root)
    local = _source_manifest(root)
    try:
        manifest_bytes = (root / "verify.json").read_bytes()
        bundled = json.loads(manifest_bytes)
    except Exception:
        manifest_bytes, bundled = None, None
    sig = _b64bytes((root / "verify.json.sig").read_text()) if (root / "verify.json.sig").exists() else None
    bundled_pub = _b64bytes((root / "hivemind.pub").read_text()) if (root / "hivemind.pub").exists() else None
    ver = (bundled or {}).get("version", "?")

    # Layer 1: integrity.
    if not bundled:
        return {"level": "no_manifest", "version": ver, "ok": False, "lines": [
            f"⚠ No manifest to verify against. Reinstall from the official source: {OFFICIAL_SOURCE}"]}
    if local["digest"] != bundled.get("digest"):
        return {"level": "modified", "version": ver, "ok": False, "lines": [
            "⚠ This install has been MODIFIED locally — your files differ from the signed manifest.",
            f"  If you did not edit it yourself, reinstall from the official source: {OFFICIAL_SOURCE}"]}

    # Layer 2: signature.
    if _ed25519 is None or sig is None or bundled_pub is None:
        return {"level": "integrity_only", "version": ver, "ok": True, "lines": [
            f"✓ Integrity OK: matches the bundled manifest for v{ver}. (No signature bundled yet — "
            "this build predates signed releases.)",
            f"  Confirm against {OFFICIAL_SOURCE} when online."]}
    if not _ed25519.verify(manifest_bytes, sig, bundled_pub):
        return {"level": "sig_invalid", "version": ver, "ok": False, "lines": [
            "⚠ SIGNATURE INVALID — the manifest is not signed by the HiveMind release key. This is "
            "a tampered or forged copy.",
            f"  Reinstall from the official source: {OFFICIAL_SOURCE}"]}
    if not check_anchor:
        return {"level": "signed", "version": ver, "ok": True, "lines": [
            f"✓ HiveMind v{ver}: integrity OK and the release signature is valid."]}

    # Layer 3: key anchor (does the bundled key match the one published on our domain?).
    official_pub = _fetch_official_pubkey()
    if official_pub is None:
        return {"level": "offline_ok", "version": ver, "ok": True, "lines": [
            f"✓ Official HiveMind v{ver}: integrity OK and the release signature is valid.",
            f"  Could not reach {OFFICIAL_PUBKEY_URL} to confirm the key is the published one (offline?)."]}
    if official_pub == bundled_pub:
        return {"level": "official", "version": ver, "ok": True, "lines": [
            f"✓ Official HiveMind v{ver} from ProjectMentor — verified.",
            "  Source integrity OK, release signature valid, and the signing key matches the one "
            "published at hivemind.projectmentor.org."]}
    return {"level": "fork", "version": ver, "ok": False, "lines": [
        "⚠ Signed, but with a key that does NOT match the official key published at "
        "hivemind.projectmentor.org. This is a fork or an impostor.",
        f"  Reinstall from the official source: {OFFICIAL_SOURCE}"]}


def verify_cmd(args):
    """Integrity + authenticity check (prints the layered verdict; see _verify_status)."""
    for line in _verify_status(Path(__file__).resolve().parent)["lines"]:
        print(line)


def _identity_show():
    """Show this device's device_id, pubkey + label (or its legacy hostname identity)."""
    seed = _device_seed()
    if seed is None:
        print("No device key — this device uses its legacy hostname identity.")
        print(f"  node_id: {NODE_ID}")
        print("  `hv config identity init` mints one on a fresh install; migrate an existing")
        print("  device with `hv migrate-device-identity`.")
        return
    pub = _ed25519.pub_from_seed(seed)
    print(f"device_id: {_device_id_for_pub(pub)}")
    print(f"pubkey:    {base64.b64encode(pub).decode()}")
    print(f"label:     {NODE_LABEL}")


def _identity_init(force):
    """Mint this device's Ed25519 device key (fresh install). Guards a populated journal unless forced."""
    if _ed25519 is None:
        print("ed25519 module unavailable; cannot create a device key.")
        return
    if DEVICE_KEY_PATH.exists() and not force:
        print(f"Device key already exists at {DEVICE_KEY_PATH}. Use --force to replace it.")
        return
    # Minting a key on a node that already authored entries under its hostname would split
    # its identity (old entries under the hostname, new ones under the device_id). On a
    # populated journal the migration is the correct path; only let init run on an empty one.
    if not force:
        mine = [e for e in merkle.read_all_entries(JOURNAL_DIR)
                if e.get("node_id") == socket.gethostname()]
        if mine:
            print(f"This device already has {len(mine)} entries under its hostname.")
            print("Use `hv migrate-device-identity` to re-stamp them (not `hv config identity init`).")
            print("Pass --force only if the journal is disposable.")
            return
    seed = os.urandom(32)
    HIVE_HOME.mkdir(parents=True, exist_ok=True)
    DEVICE_KEY_PATH.write_text(base64.b64encode(seed).decode() + "\n")
    pub = _ed25519.pub_from_seed(seed)
    did = _device_id_for_pub(pub)
    DEVICE_ID_PATH.write_text(did + "\n")
    try:
        os.chmod(DEVICE_KEY_PATH, 0o600)
    except Exception:
        pass
    print(f"Device key created. device_id: {did}")
    print(f"  pubkey: {base64.b64encode(pub).decode()}")
    print(f"  seed:   {DEVICE_KEY_PATH} (private — never commit or sync it)")
    print("  Share the device_id + pubkey with peers (add them to .peers.json).")


def key_cmd(args):
    """[alias of `hv config identity`] Show or create this device's Ed25519 device identity."""
    action = getattr(args, "key_action", None) or "show"
    if action == "init":
        _identity_init(getattr(args, "force", False))
    else:
        _identity_show()


def migrate_device_identity_cmd(args):
    """Re-stamp the journal from hostname node_ids to cryptographic device_ids. A one-time,
    coordinated, DETERMINISTIC transform: every node runs it with the SAME {hostname: device_id}
    map, so byte-for-byte identical re-stamped journals result and the peers stay converged
    (equal Merkle roots) with no content re-sync. Historical entries are re-stamped and their
    per-node hash chains recomputed; they stay UNSIGNED (they predate the keys, grandfathered on
    ingest). New writes after this are signed because the node now has a device key."""
    try:
        mapping = json.loads(Path(args.map).read_text())
    except Exception as e:
        print(f"Could not read --map {args.map}: {e}")
        return
    if not isinstance(mapping, dict) or not all(isinstance(v, str) for v in mapping.values()):
        print('Map must be a JSON object of {"hostname": "k1:device_id", ...} for every device.')
        return

    host = socket.gethostname()
    local_did = None
    if host in mapping:
        # This device is being re-stamped: it must already hold the key whose fingerprint the map
        # assigns it, so its future (signed) writes line up with its re-stamped history.
        seed = _device_seed()
        if seed is None:
            print("This device has no device key. Run `hv key init --force` first, then put its")
            print("device_id (from `hv key show`) in the map under this device's hostname.")
            return
        local_did = _device_id_for_pub(_ed25519.pub_from_seed(seed))
        if mapping[host] != local_did:
            print(f"Map mismatch: this device ({host}) holds device_id {local_did},")
            print(f"  but the map says {mapping[host]!r}. Every device must share one identical map.")
            return
    else:
        print(f"Note: this host ({host}) is not in the map; re-stamping the mapped devices only.")
        print("  Mint a key here with `hv key init` if this device should also sign its writes.")

    entries = merkle.read_all_entries(JOURNAL_DIR)
    if not entries:
        print("Empty journal — nothing to migrate (new writes will be signed).")
        return
    present = {e.get("node_id") for e in entries}
    if not (present & set(mapping.keys())):
        print("Journal already uses device_ids — nothing to migrate.")
        return

    def remap(nid):
        return mapping.get(nid, nid)

    migrated = []
    for e in entries:
        e = dict(e)
        e["node_id"] = remap(e.get("node_id"))
        p = dict(e.get("payload", {}))
        for refk in ("entity_ref", "fact_ref", "supersedes_ref"):
            r = p.get(refk)
            if isinstance(r, list) and len(r) == 2:
                p[refk] = [remap(r[0]), r[1]]
        e["payload"] = p
        e.pop("sig", None)            # node_id changed; historical entries become unsigned
        e.pop("pub", None)
        migrated.append(e)

    # Recompute each device's prev_hash chain from genesis (migrate_journal_v2 pattern).
    by_node = {}
    for e in migrated:
        by_node.setdefault(e["node_id"], []).append(e)
    for ents in by_node.values():
        ents.sort(key=lambda x: x["seq"])
        prev = "sha256:genesis"
        for e in ents:
            e["prev_hash"] = prev
            prev = compute_hash(e)

    migrated.sort(key=lambda e: (e["node_id"], e["seq"]))
    if args.dry_run:
        remapped = sum(1 for e in entries if e.get("node_id") in mapping)
        print(f"DRY RUN: would re-stamp {remapped}/{len(entries)} entries via {len(mapping)} mapping(s).")
        for src, did in sorted(mapping.items()):
            n = sum(1 for e in entries if e.get("node_id") == src)
            print(f"  {src} -> {did}   ({n} entries)")
        root_after = merkle.merkle_root(merkle.chunk_hashes(
            sorted(migrated, key=lambda e: (e["node_id"], e["seq"]))))
        print(f"  resulting Merkle root: {root_after}")
        return

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = JOURNAL_DIR.parent / f"journal.bak.device-id.{stamp}"
    JOURNAL_DIR.rename(backup)
    JOURNAL_DIR.mkdir(parents=True, exist_ok=True)
    by_date = {}
    for e in migrated:
        by_date.setdefault(e["timestamp"][:10], []).append(e)
    for date, ents in by_date.items():
        with open(JOURNAL_DIR / f"{date}.jsonl", "w") as f:
            for e in ents:
                f.write(json.dumps(e) + "\n")
    rebuild_db()

    # Rekey local-only telemetry shards (this host -> its device_id); never synced.
    try:
        if local_did and TELEMETRY_DB.exists():
            tconn = sqlite3.connect(TELEMETRY_DB)
            tconn.execute("UPDATE telemetry_sessions SET node_id=? WHERE node_id=?", (local_did, host))
            tconn.commit()
            tconn.close()
    except Exception:
        pass

    root = merkle.merkle_root(merkle.chunk_hashes(merkle.read_all_entries(JOURNAL_DIR)))
    print(f"Migrated {len(migrated)} entries to device identity. Backup: {backup}")
    if local_did:
        print(f"  this device is now {local_did} (was {host}).")
    print(f"  Merkle root: {root}")
    print("  Run the SAME map on every peer; then `hv merkle` should match and `hv sync now` = in sync.")


def _is_daemon_cmdline(toks):
    """True iff an argv (token list) is a real `<...>/hv sync daemon` daemon, NOT a shell or
    script that merely MENTIONS the string. The daemon's argv ENDS in `<path>/hv sync daemon`;
    a `bash -c '... hv sync daemon ...'` wrapper does not (its script body sits earlier in argv).
    This guard is load-bearing: `--fix` kills these PIDs, so it must never match an innocent shell."""
    if not (len(toks) >= 3 and toks[-2:] == ["sync", "daemon"]
            and (toks[-3].endswith("/hv") or toks[-3] == "hv")):
        return False
    head = toks[0].lower()
    return "python" in head or head.endswith("/hv") or head == "hv"


def _sync_daemon_pids():
    """PIDs of real hive sync-daemon processes (Linux/Mac via pgrep). [] on any failure; excludes
    our own PID. `pgrep -f` alone would also match this command's parent shell, so every hit is
    re-checked against _is_daemon_cmdline."""
    try:
        out = subprocess.run(["pgrep", "-af", "sync daemon"],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return []
    me = os.getpid()
    pids = []
    for line in out.splitlines():
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        if pid != me and _is_daemon_cmdline(parts[1].split()):
            pids.append(pid)
    return pids


def _systemd_hive_sync():
    """(unit_exists, main_pid) for the `--user` hive-sync unit. main_pid is set only when the unit
    is active; None if dead/missing. Returns (False, None) where systemd isn't available."""
    def _show(prop):
        return subprocess.run(["systemctl", "--user", "show", "-p", prop, "--value", "hive-sync"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    try:
        unit_exists = _show("LoadState") == "loaded"
        active = subprocess.run(["systemctl", "--user", "is-active", "hive-sync"],
                               capture_output=True, text=True, timeout=5).stdout.strip()
        mp = _show("MainPID")
        main_pid = int(mp) if (active == "active" and mp.isdigit() and mp != "0") else None
        return unit_exists, main_pid
    except Exception:
        return False, None


def _classify_orphans(pids, main_pid, unit_exists):
    """Which daemon PIDs are orphans, i.e. NOT the one systemd is supposed to manage. Pure (testable).
    - managed daemon present: any OTHER daemon process is an orphan (a second one outside systemd).
    - a systemd unit exists but isn't running these: all of them are unmanaged orphans (the gotcha
      where the unit is dead yet a stale daemon still holds the port).
    - no systemd unit at all (manual management): only flag extras beyond a single survivor."""
    if not pids:
        return []
    if main_pid and main_pid in pids:
        return [p for p in pids if p != main_pid]
    if unit_exists:
        return list(pids)
    return [p for p in pids if p != min(pids)] if len(pids) > 1 else []


def _orphan_daemons():
    """(orphan_pids, unit_exists) for the local sync daemon."""
    pids = _sync_daemon_pids()
    unit_exists, main_pid = _systemd_hive_sync()
    return _classify_orphans(pids, main_pid, unit_exists), unit_exists


def _kill_orphans(orphans):
    """SIGTERM then (after a beat) SIGKILL any survivors. Returns the PIDs we signalled."""
    for p in orphans:
        subprocess.run(["kill", str(p)], capture_output=True)
    if orphans:
        time.sleep(1.5)
        for p in orphans:
            subprocess.run(["kill", "-9", str(p)], capture_output=True)
    return list(orphans)


def _doctor_status():
    """Run the local health checks (READ-ONLY) and return a list of
    {name, status: 'ok'|'warn'|'fail', detail}. Shared by `hv doctor` text + json output.

    'fail' = something is broken and needs action (tampered source, corrupt journal, empty DB).
    'warn' = degraded or advisory (auto-sync off, a peer offline, hygiene to reconcile). A warn
    does not mean the node is unhealthy, so it does not set a non-zero exit on its own."""
    checks = []
    entries = []

    # 1. Authenticity — integrity + signature. Skip the slow network key-anchor layer so doctor
    #    stays fast and works offline; `hv verify` does the full three-layer check.
    try:
        v = _verify_status(Path(__file__).resolve().parent, check_anchor=False)
        headline = v["lines"][0].lstrip("✓⚠ ").strip()
        checks.append({"name": "authenticity", "status": "ok" if v["ok"] else "fail", "detail": headline})
    except Exception as e:
        checks.append({"name": "authenticity", "status": "warn", "detail": f"check error: {e}"})

    # 2. Journal — THIS node's hash chain is contiguous from genesis and each prev_hash links.
    #    A break means local corruption or tampering (foreign nodes may be partial, so only ours).
    try:
        entries = merkle.read_all_entries(JOURNAL_DIR)
        mine = sorted([e for e in entries if e.get("node_id") == NODE_ID], key=lambda e: e["seq"])
        broken, expect_prev, expect_seq = None, "sha256:genesis", 1
        for e in mine:
            if e["seq"] != expect_seq:
                broken = f"seq gap at {e['seq']} (expected {expect_seq})"
                break
            if e.get("prev_hash") != expect_prev:
                broken = f"hash chain breaks at seq {e['seq']}"
                break
            expect_prev, expect_seq = compute_hash(e), expect_seq + 1
        root_hash = merkle.merkle_root(merkle.chunk_hashes(entries))
        if broken:
            checks.append({"name": "journal", "status": "fail",
                           "detail": f"{broken} — local journal corruption or tampering"})
        else:
            checks.append({"name": "journal", "status": "ok",
                           "detail": f"{len(mine)} own entries chained from genesis, {len(entries)} total, root {root_hash[7:23]}"})
    except Exception as e:
        checks.append({"name": "journal", "status": "fail", "detail": f"unreadable: {e}"})

    # 3. Database — store.db (the derived index) is readable and in step with the journal.
    #    Content-duplicate facts collapse to one row, so rows <= journal fact-entries; the red flag
    #    is an empty DB over a non-empty journal (a missed rebuild).
    jfacts = sum(1 for e in entries if e.get("type") == "fact")
    try:
        conn = get_conn()
        nfacts = conn.execute("SELECT count(*) FROM facts").fetchone()[0]
        conn.close()
        if jfacts and nfacts == 0:
            checks.append({"name": "database", "status": "fail",
                           "detail": f"store.db has 0 facts but the journal has {jfacts} — run `hv doctor rebuild`"})
        else:
            checks.append({"name": "database", "status": "ok",
                           "detail": f"{nfacts} fact rows from {jfacts} journal fact-entries"})
    except Exception as e:
        checks.append({"name": "database", "status": "fail",
                       "detail": f"store.db unreadable ({e}) — run `hv doctor rebuild`"})

    # 3b. Owner — can governance still be signed, and is owner-key custody sane? Read-only, offline.
    #     ok    = this device holds the CURRENT owner key (governance is signable here).
    #     warn  = key absent (a declared standby may act / nobody can sign), key sprawl (>1 holder),
    #             or an open succession nomination awaiting a claim. Advisory — never 'fail'.
    try:
        gov = _governance_state(entries)
        if not gov["owner_id"]:
            checks.append({"name": "owner", "status": "ok", "detail": "no owner established yet (`hv owner init`)"})
        else:
            held = (_ed25519 is not None and _owner_seed() is not None
                    and _owner_id_for_pub(_ed25519.pub_from_seed(_owner_seed())) == gov["owner_id"])
            notes = []
            if gov["owner_term"]:
                notes.append(f"{gov['owner_term']} handoff(s) from genesis")
            if gov["nominations"]:
                notes.append(f"{len(gov['nominations'])} open nomination(s) awaiting claim")
            if gov["elections"]:
                armed = sum(1 for e in gov["elections"] if e["armed"] and not e["installed"])
                notes.append(f"{len(gov['elections'])} open election(s)"
                             + (f", {armed} dead-man-armed" if armed else ""))
            # Key sprawl: declared standbys each hold a copy, plus the owner device. >1 is advisory.
            holders = len(gov["standbys"]) + 1
            sprawl = holders > 1
            if held:
                status = "warn" if (gov["nominations"] or sprawl or gov["elections"]) else "ok"
                detail = "this device holds the current owner key"
                if sprawl:
                    notes.append(f"{holders} owner-key holders (owner + {len(gov['standbys'])} standby) — key sprawl")
            else:
                status = "warn"
                if gov["standbys"]:
                    detail = f"owner key absent here — declared standby(s) may act: {', '.join(sorted(gov['standbys']))}"
                else:
                    detail = "owner key absent here and no standby declared — governance unsignable until restored"
            if notes:
                detail += " (" + "; ".join(notes) + ")"
            checks.append({"name": "owner", "status": status, "detail": detail})
    except Exception as e:
        checks.append({"name": "owner", "status": "warn", "detail": f"owner check error: {e}"})

    # 4. Hygiene — duplicates / obsolete / re-check, as surfaced by the audit. Advisory only.
    try:
        a = _compute_audit(depth="light")
        red = len(a["redundant"])
        obs = len(a["forgotten"]) + len(a["contested"]) + len(a["decayed"])
        rec = len(a["recheck"])
        if red or obs or rec:
            checks.append({"name": "hygiene", "status": "warn",
                           "detail": f"{red} duplicate, {obs} obsolete, {rec} to re-check — run `hv audit`"})
        else:
            checks.append({"name": "hygiene", "status": "ok", "detail": "no duplicates or obsolete facts"})
    except Exception as e:
        checks.append({"name": "hygiene", "status": "warn", "detail": f"audit error: {e}"})

    # 5 + 6. Sync daemon liveness + peer reachability — best-effort network probes.
    try:
        import sync_common
        cfg = sync_common.load_peers()
        port, peers = cfg.get("port", 9876), cfg.get("peers", [])
    except Exception:
        port, peers = 9876, []
    try:
        import requests
    except Exception:
        requests = None

    orphans, _unit_exists = _orphan_daemons()
    if requests is None:
        status, detail = "warn", "python 'requests' not installed; cannot probe"
    else:
        try:
            r = requests.get(f"http://127.0.0.1:{port}/sync/merkle-root", timeout=3)
            r.raise_for_status()
            status, detail = "ok", f"responding on 127.0.0.1:{port}"
        except Exception:
            status, detail = "warn", f"no response on 127.0.0.1:{port} (auto-sync off?) — `systemctl --user start hive-sync`"
    if orphans:
        # A daemon is running outside systemd's control (e.g. the unit is dead but a stale process
        # still holds the port and serves old code). The port may answer, but it's not the managed one.
        status = "warn"
        detail += f"; {len(orphans)} orphan daemon(s) outside systemd (PID {', '.join(map(str, orphans))}) — `hv doctor --fix`"
    checks.append({"name": "sync-daemon", "status": status, "detail": detail, "orphans": orphans})

    if not peers:
        checks.append({"name": "peers", "status": "ok", "detail": "none configured"})
    elif requests is None:
        checks.append({"name": "peers", "status": "warn", "detail": f"{len(peers)} configured; cannot probe (no 'requests')"})
    else:
        local_root = merkle.merkle_root(merkle.chunk_hashes(entries))
        up, down, diverged = [], [], []
        for p in peers:
            base = str(p.get("url", "")).rstrip("/")
            pid = p.get("id", base)
            try:
                rr = requests.get(f"{base}/sync/merkle-root", timeout=5)
                rr.raise_for_status()
                (up if rr.json().get("root_hash") == local_root else diverged).append(pid)
            except Exception:
                down.append(pid)
        if down or diverged:
            bits = []
            if up:
                bits.append(f"{len(up)} in sync")
            if diverged:
                bits.append(f"diverged: {', '.join(diverged)} (run `hv sync now`)")
            if down:
                bits.append(f"unreachable: {', '.join(down)}")
            checks.append({"name": "peers", "status": "warn", "detail": "; ".join(bits)})
        else:
            checks.append({"name": "peers", "status": "ok", "detail": f"{len(up)} peer(s) reachable and in sync"})

    return checks


def doctor_cmd(args):
    """Aggregate local health check: authenticity, journal integrity, the derived DB, corpus
    hygiene, the sync daemon, and peer reachability. Read-only by default. `--fix` takes the one
    safe remedial action: kill orphan sync daemons (a stale process holding :9876 outside systemd)
    and restart the managed unit. Exits non-zero if any check FAILED; warnings keep a zero exit
    (so cron/monitors alert only on real breakage). Subcommands fold in the rarely-used device
    maintenance ops: `hv doctor rebuild` (reconstruct store.db from the journal), `hv doctor merkle`
    (sync diagnostic) and `hv doctor migrate-identity`."""
    action = getattr(args, "doctor_action", None)
    if action == "rebuild":
        rebuild(args)
        return
    if action == "merkle":
        merkle_cmd(args)
        return
    if action == "migrate-identity":
        migrate_device_identity_cmd(args)
        return
    checks = _doctor_status()
    fails = [c for c in checks if c["status"] == "fail"]
    warns = [c for c in checks if c["status"] == "warn"]

    if getattr(args, "format", "text") == "json":
        verdict = "fail" if fails else ("warn" if warns else "ok")
        print(json.dumps({"verdict": verdict, "node": NODE_ID, "checks": checks}, indent=2))
    else:
        glyph = {"ok": "✓", "warn": "•", "fail": "✗"}
        print(f"hive doctor — {NODE_ID}")
        for c in checks:
            print(f"  {glyph.get(c['status'], '?')} {c['name']:<13} {c['detail']}")
        if fails:
            print(f"\n{len(fails)} check(s) FAILED — see above.")
        elif warns:
            print(f"\nhealthy, with {len(warns)} advisory warning(s).")
        else:
            print("\nall checks passed.")

    if getattr(args, "fix", False):
        orphans = [p for c in checks for p in (c.get("orphans") or [])]
        if not orphans:
            print("\n--fix: no orphan daemons to clear.")
        else:
            print(f"\n--fix: killing {len(orphans)} orphan daemon(s): {', '.join(map(str, orphans))}")
            _kill_orphans(orphans)
            unit_exists, _ = _systemd_hive_sync()
            if unit_exists:
                subprocess.run(["systemctl", "--user", "restart", "hive-sync"], capture_output=True)
                time.sleep(2)
                print("  restarted the systemd hive-sync unit.")
            after = next((c for c in _doctor_status() if c["name"] == "sync-daemon"), None)
            print(f"  sync-daemon now: {after['detail'] if after else 'unknown'}")

    sys.exit(1 if fails else 0)


def _append_governance(action_payload):
    """Owner-sign and append a governance entry, then rebuild so confidence reflects it. Requires
    the owner key on this device. Returns the entry, or None if this device isn't the owner."""
    seed = _owner_seed()
    if seed is None:
        print("This device does not hold the owner key — run governance commands on the owner machine.")
        return None
    pub = _ed25519.pub_from_seed(seed)
    # $HIVE_NOW (when set) dates the entry, so owner-liveness vs. an election basis_ts is drivable
    # deterministically in tests; in production it is unset and the wall clock is used.
    entry = append_journal("governance", _sign_governance_payload(action_payload, seed, pub),
                           timestamp=os.environ.get("HIVE_NOW") or None)
    rebuild_db()
    return entry


def _append_governance_device(action_payload):
    """Append a DEVICE-signed governance entry (no owner_sig), then rebuild. For acts whose authority
    is the signer's hive membership rather than the owner key — election proposals and votes. Any
    device can run these; `_governance_state` counts them only from admitted devices. `append_journal`
    already attaches this device's signature. $HIVE_NOW dates the entry (test hook; see above)."""
    entry = append_journal("governance", action_payload, timestamp=os.environ.get("HIVE_NOW") or None)
    rebuild_db()
    return entry


def owner_cmd(args):
    """Show or create the governance owner identity (the root of trust for membership + config)."""
    action = getattr(args, "owner_action", None) or "show"
    entries = merkle.read_all_entries(JOURNAL_DIR)
    gov = _governance_state(entries)
    if action == "show":
        if not gov["owner_id"]:
            print("No owner established. Run `hv owner init` to mint the owner key and claim it.")
            return
        seed = _owner_seed()
        held = seed is not None and _owner_id_for_pub(_ed25519.pub_from_seed(seed)) == gov["owner_id"]
        print(f"owner: {gov['owner_id']}" + ("  (this device holds the owner key)" if held else ""))
        print(f"  hive_id: {gov['hive_id']}")
        print(f"  admitted devices: {len(gov['admitted'])}; principals tagged: {len(gov['principals'])}; "
              f"pending: {len(_pending_admissions(entries, gov))}; "
              f"denied: {len(gov['denied'])}; purged: {len(gov['purged'])}")
        print(f"  config: same_device_lambda={gov['config']['same_device_lambda']}, "
              f"cap_self={gov['config']['cap_self']}")
        qm = int(gov["config"].get("quorum_m", 0) or 0)
        if qm > 0:
            print(f"  quorum: {qm} {gov['config'].get('quorum_by')}(s) elect a new owner after "
                  f"{gov['config'].get('dead_man_days')}d of owner silence")
        if gov["elections"]:
            print(f"  open elections ({len(gov['elections'])}): "
                  + ", ".join(f"{e['proposal_id']}->{e['new_owner_id']} ({e['votes']}/{e['quorum_m']}"
                              + (", armed" if e['armed'] else "") + ")" for e in gov["elections"]))
        if gov["standbys"]:
            print(f"  standbys ({len(gov['standbys'])}): {', '.join(sorted(gov['standbys']))}")
        if gov["owner_term"]:
            print(f"  handoffs: {gov['owner_term']} (ownership succeeded from the genesis owner)")
        if gov["nominations"]:
            sids = sorted(_owner_id_for_pub(base64.b64decode(c)) for c in gov["nominations"])
            print(f"  open nominations ({len(sids)}): {', '.join(sids)}")
        if gov["escrows"]:
            print(f"  live escrows: {len(gov['escrows'])} (recover with `hv owner restore`)")
        if not held:
            extra = (" Declared standbys that hold a key copy may act: "
                     + ", ".join(sorted(gov["standbys"]))) if gov["standbys"] else ""
            print("  NOTE: this device does NOT hold the owner key — governance must run on the "
                  "owner device or a key holder." + extra)
        return
    if action == "export":
        seed = _owner_seed()
        if seed is None:
            print("This device does not hold the owner key — nothing to export.")
            return
        oid = _owner_id_for_pub(_ed25519.pub_from_seed(seed))
        out = Path(getattr(args, "out", None) or f"hive-owner-{oid}.key")
        env = {"hive_id": gov.get("hive_id", ""), "owner_id": oid}
        if getattr(args, "passphrase", False):
            pw = _read_passphrase("Passphrase to encrypt the owner key (blank line / Ctrl-C to cancel): ",
                                  confirm=True)
            if pw is None:
                print("Cancelled — nothing exported.")
                return
            env.update(_owner_seal(seed, pw))
        else:
            env["enc"] = "none"
            env["seed"] = base64.b64encode(seed).decode()
        out.write_text(json.dumps(env, indent=2) + "\n")
        try:
            os.chmod(out, 0o600)
        except Exception:
            pass
        print(f"Owner key exported to {out} (chmod 600).")
        if env.get("enc") == "none":
            print("  UNENCRYPTED — treat this like an SSH private key; anyone holding it is the owner.")
            print("  Re-run with --passphrase to encrypt it for transport.")
        return
    if action == "import":
        try:
            env = json.loads(Path(args.file).read_text())
        except Exception as e:
            print(f"Could not read {args.file}: {e}")
            return
        if env.get("enc", "none") == "none":
            seed = base64.b64decode(env.get("seed", ""))
        else:
            pp = _read_passphrase("Passphrase (blank line / Ctrl-C to cancel): ")
            if pp is None:
                print("Cancelled.")
                return
            try:
                seed = _owner_unseal(env, pp)
            except Exception as e:
                print(f"Could not decrypt: {e}")
                return
        if len(seed) != 32:
            print("Invalid owner key (bad length).")
            return
        imported = _owner_id_for_pub(_ed25519.pub_from_seed(seed))
        if gov["owner_id"] and imported != gov["owner_id"] and not getattr(args, "force", False):
            print(f"Refusing: this key is owner {imported}, but the journal's established owner is "
                  f"{gov['owner_id']}. Importing would create a disagreeing owner. Use --force to override.")
            return
        HIVE_HOME.mkdir(parents=True, exist_ok=True)
        OWNER_KEY_PATH.write_text(base64.b64encode(seed).decode() + "\n")
        try:
            os.chmod(OWNER_KEY_PATH, 0o600)
        except Exception:
            pass
        _stash_owner_key(seed)
        print(f"Owner key installed ({imported}). This device can now sign governance.")
        return
    if action == "standby":
        enabled = not getattr(args, "off", False)
        if _append_governance({"action": "standby", "device_id": args.device_id, "enabled": enabled}):
            if enabled:
                print(f"Declared standby: {args.device_id}")
                print("  It must hold a copy of the owner key to actually act — give it one with "
                      "`hv owner export` then `hv owner import` on that device.")
            else:
                print(f"Removed standby: {args.device_id}")
        return
    if action == "escrow":
        seed = _owner_seed()
        if seed is None:
            print("This device does not hold the owner key — nothing to escrow.")
            return
        print("This stores your owner key, passphrase-ENCRYPTED, INSIDE the hive journal.")
        print("  • It syncs to EVERY device that reads the hive (including read-only members) and is")
        print("    PERMANENT (append-only — it cannot be un-published). The passphrase is then your")
        print("    hive master key: anyone with hive read access can attempt to crack it offline,")
        print("    forever. Use a STRONG passphrase. (Your off-device `hv owner export` file covers")
        print("    the other case — not trusting the shared store.)")
        pw = _read_passphrase("Strong passphrase to encrypt the owner key (blank line / Ctrl-C to cancel): ",
                              confirm=True)
        if pw is None:
            print("Cancelled — the owner key was NOT escrowed.")
            return
        if len(pw) < 12:
            print("Refusing: passphrase too short (need ≥ 12 chars) — it guards a key readable by every node.")
            return
        oid = _owner_id_for_pub(_ed25519.pub_from_seed(seed))
        if _append_governance({"action": "owner-escrow", "owner_id": oid, "envelope": _owner_seal(seed, pw)}):
            print(f"Owner key escrowed to the hive (encrypted; owner {oid}).")
            print("  Recover on any synced device with:  hv owner restore")
        return
    if action == "restore":
        # gov["escrows"] is already owner-signed, revocation-filtered, and sorted (see
        # _governance_state) — a `revoke-escrow` tombstone drops a compromised blob from here.
        if not gov["escrows"]:
            print("No (live) owner-escrow found in the hive. Sync the hive first (`hv sync now`), or "
                  "recover from a file with `hv owner import <file>`.")
            return
        env = gov["escrows"][-1][3]          # latest live escrow wins
        pp = _read_passphrase("Passphrase (blank line / Ctrl-C to cancel): ")
        if pp is None:
            print("Cancelled.")
            return
        try:
            seed = _owner_unseal(env, pp)
        except Exception as e:
            print(f"Could not decrypt: {e}")
            return
        if len(seed) != 32:
            print("Invalid owner key (bad length).")
            return
        oid = _owner_id_for_pub(_ed25519.pub_from_seed(seed))
        if gov["owner_id"] and oid != gov["owner_id"]:
            print(f"Refusing: the escrowed key is owner {oid}, but the established owner is {gov['owner_id']}.")
            return
        HIVE_HOME.mkdir(parents=True, exist_ok=True)
        OWNER_KEY_PATH.write_text(base64.b64encode(seed).decode() + "\n")
        try:
            os.chmod(OWNER_KEY_PATH, 0o600)
        except Exception:
            pass
        _stash_owner_key(seed)
        print(f"Owner key recovered from the hive ({oid}). This device can now sign governance.")
        return
    if action == "nominate":
        cp = _canon_pub(args.successor_pub)
        if not cp:
            print("Not a valid owner pubkey (need base64 of a 32-byte ed25519 key, e.g. from "
                  "`hv owner claim --mint` on the successor device).")
            return
        sid = _owner_id_for_pub(base64.b64decode(cp))
        if _append_governance({"action": "nominate-successor", "successor_owner_pub": cp}):
            print(f"Nominated successor {sid}.")
            print("  The successor claims it with `hv owner claim` on the device that holds that key.")
        return
    if action == "unnominate":
        cp = _canon_pub(args.successor_pub)
        if not cp:
            print("Not a valid owner pubkey.")
            return
        if _append_governance({"action": "revoke-nomination", "successor_owner_pub": cp}):
            print(f"Revoked the nomination of {_owner_id_for_pub(base64.b64decode(cp))}.")
        return
    if action == "claim":
        if _ed25519 is None:
            print("ed25519 unavailable; cannot claim ownership.")
            return
        seed = _owner_seed()
        mint = getattr(args, "mint", False) or seed is None
        if mint:
            if seed is not None and not getattr(args, "force", False):
                # Holding a key already — minting a fresh one would discard it. Only refuse if it is
                # the live owner key (losing that is the dangerous case); otherwise allow the reuse.
                held_oid = _owner_id_for_pub(_ed25519.pub_from_seed(seed))
                if held_oid == gov["owner_id"]:
                    print("This device already holds the live owner key. `--force` to mint a NEW key anyway.")
                    return
            seed = os.urandom(32)
        pub = _ed25519.pub_from_seed(seed)
        oid = _owner_id_for_pub(pub)
        cp = _canon_pub(base64.b64encode(pub).decode())
        if oid == gov["owner_id"]:
            print(f"This device's key is already the established owner ({oid}). Nothing to claim.")
            return
        # Install the (possibly freshly minted) key locally so a later claim can reuse it.
        HIVE_HOME.mkdir(parents=True, exist_ok=True)
        OWNER_KEY_PATH.write_text(base64.b64encode(seed).decode() + "\n")
        try:
            os.chmod(OWNER_KEY_PATH, 0o600)
        except Exception:
            pass
        _stash_owner_key(seed)
        if cp not in gov["nominations"]:
            print(f"Prospective owner key ready on this device: {oid}")
            print(f"  pub: {cp}")
            print(f"  Have the current owner run:  hv owner nominate {cp}")
            print( "  then re-run `hv owner claim` here to take ownership.")
            return
        if _append_governance({"action": "claim-succession", "owner_id": oid}):
            print(f"Claimed ownership: {oid} is now the hive owner (term {gov['owner_term'] + 1}).")
            print("  The previous owner key can no longer sign governance.")
        return
    if action == "transfer":
        cp = _canon_pub(args.new_owner_pub)
        if not cp:
            print("Not a valid owner pubkey (base64 of a 32-byte ed25519 key).")
            return
        nid = _owner_id_for_pub(base64.b64decode(cp))
        if nid == gov["owner_id"]:
            print(f"{nid} is already the owner. Nothing to transfer.")
            return
        print(f"Immediate handoff: ownership moves to {nid}.")
        print("  WARNING: that device must already HOLD this key or governance becomes unsignable.")
        print("  (Use `hv owner nominate` + `hv owner claim` for the safer claim-based handoff.)")
        if _append_governance({"action": "transfer", "new_owner_pub": cp}):
            print(f"Transferred ownership to {nid} (term {gov['owner_term'] + 1}).")
        return
    if action == "revoke-escrow":
        ref = args.ref
        if ref != "all":
            ok = any(f"{nid}:{seq}" == ref for _ts, nid, seq, _env in gov["escrows"])
            if not ok:
                print(f"No live escrow {ref!r}. Live escrows (node_id:seq):")
                for _ts, nid, seq, _env in gov["escrows"]:
                    print(f"  {nid}:{seq}")
                if not gov["escrows"]:
                    print("  (none)")
                print("  Use `all` to tombstone every escrow.")
                return
        if _append_governance({"action": "revoke-escrow", "escrow_ref": ref}):
            print(f"Tombstoned escrow {ref} — `hv owner restore` will skip it.")
            print("  NOTE: the ciphertext stays in the append-only journal forever. If the passphrase")
            print("  leaked, ROTATE the owner key (`hv owner nominate`+`claim`, or `transfer`) so the")
            print("  old escrow blob unlocks a key that is no longer the owner.")
        return
    if action == "heartbeat":
        if _owner_seed() is None:
            print("This device does not hold the owner key — heartbeat must run on a key holder.")
            return
        if _append_governance({"action": "heartbeat"}):
            print("Heartbeat recorded — owner liveness refreshed (resets the dead-man timer).")
        return
    if action == "propose-election":
        if not gov["owner_id"]:
            print("No owner established — nothing to elect.")
            return
        if int(gov["config"].get("quorum_m", 0) or 0) <= 0:
            print("Quorum elections are OFF (quorum_m=0). The owner must enable them first:")
            print("  hv config quorum set quorum_m <N>")
            return
        if NODE_ID not in gov["admitted"]:
            print("Only an ADMITTED device can propose an election (you are not admitted here).")
            return
        if _ed25519 is None:
            print("ed25519 unavailable; cannot propose an election.")
            return
        if getattr(args, "mint", False):
            seed = os.urandom(32)
            HIVE_HOME.mkdir(parents=True, exist_ok=True)
            OWNER_KEY_PATH.write_text(base64.b64encode(seed).decode() + "\n")
            try:
                os.chmod(OWNER_KEY_PATH, 0o600)
            except Exception:
                pass
            _stash_owner_key(seed)
            new_pub = _canon_pub(base64.b64encode(_ed25519.pub_from_seed(seed)).decode())
            print(f"Minted a prospective owner key on this device ({_owner_id_for_pub(_ed25519.pub_from_seed(seed))}).")
        else:
            new_pub = _canon_pub(getattr(args, "pub", "") or "")
            if not new_pub:
                print("Provide the proposed owner key: `--mint` (mint one here) or `--pub <base64>`.")
                return
        basis_ts = os.environ.get("HIVE_NOW") or _now_iso()
        pid = _election_id(new_pub, basis_ts)
        new_oid = _owner_id_for_pub(base64.b64decode(new_pub))
        if _append_governance_device({"action": "propose-election", "proposal_id": pid,
                                      "new_owner_pub": new_pub, "basis_ts": basis_ts}):
            qm = int(gov["config"].get("quorum_m"))
            dmd = gov["config"].get("dead_man_days")
            print(f"Proposed election {pid}: new owner {new_oid} (basis {basis_ts}).")
            print(f"  Other admitted devices vote with:  hv owner vote {pid}")
            print(f"  Installs once {qm} device(s) endorse it AND the owner is silent for {dmd} day(s).")
        return
    if action == "vote":
        if NODE_ID not in gov["admitted"]:
            print("Only an ADMITTED device can vote.")
            return
        pid = args.proposal_id
        match = next((e for e in gov["elections"] if e["proposal_id"] == pid), None)
        if not match:
            print(f"No known election {pid}. List open elections with `hv owner elections` (sync first).")
            return
        if _append_governance_device({"action": "vote-election", "proposal_id": pid}):
            print(f"Voted for election {pid} (would install owner {match['new_owner_id']}).")
            tail = "dead-man armed" if match["armed"] else "owner still active — will not install yet"
            print(f"  ~{match['votes'] + 1}/{match['quorum_m']} votes after sync; {tail}.")
        return
    if action == "elections":
        qm = int(gov["config"].get("quorum_m", 0) or 0)
        if not gov["elections"]:
            print("No open elections." + ("" if qm > 0 else "  (Quorum is OFF — quorum_m=0.)"))
            return
        print(f"Elections (quorum_m={qm}, dead_man_days={gov['config'].get('dead_man_days')}, "
              f"by={gov['config'].get('quorum_by')}):")
        for e in gov["elections"]:
            flags = (["INSTALLED"] if e["installed"]
                     else (["quorum-reached"] if e["crossed"] else [f"{e['votes']}/{e['quorum_m']} votes"]))
            if not e["installed"]:
                flags.append("dead-man armed" if e["armed"] else "owner active")
            print(f"  {e['proposal_id']}  ->  {e['new_owner_id']}   [{', '.join(flags)}]")
        return
    if action == "init":
        if _ed25519 is None:
            print("ed25519 unavailable; cannot create an owner key.")
            return
        if OWNER_KEY_PATH.exists() and not args.force:
            print(f"Owner key already exists at {OWNER_KEY_PATH}. Use --force to replace it.")
            return
        if gov["owner_id"] and not args.force:
            print(f"An owner is already established ({gov['owner_id']}). Use --force to override "
                  "(risks governance disagreement across nodes).")
            return
        seed = os.urandom(32)
        HIVE_HOME.mkdir(parents=True, exist_ok=True)
        OWNER_KEY_PATH.write_text(base64.b64encode(seed).decode() + "\n")
        try:
            os.chmod(OWNER_KEY_PATH, 0o600)
        except Exception:
            pass
        pub = _ed25519.pub_from_seed(seed)
        oid = _owner_id_for_pub(pub)
        # The genesis owner declaration also mints the hive_id: a public, owner-attested identifier
        # that scopes sync, so two hives on one tailnet never merge their journals. Random (no key).
        hive_id = "h1:" + os.urandom(8).hex()
        append_journal("governance", _sign_governance_payload(
            {"action": "owner", "owner_id": oid, "hive_id": hive_id}, seed, pub),
            timestamp=os.environ.get("HIVE_NOW") or None)
        rebuild_db()
        stashed = _stash_owner_key(seed)
        print(f"Owner established: {oid}")
        print(f"  hive_id: {hive_id}")
        print(f"  key: {OWNER_KEY_PATH} (private — never commit or sync it)")
        if stashed:
            print(f"  backup: {stashed} (auto-stash; `hv owner export` for a portable copy)")
        print("  Admit your devices next: `hv admit <device_id> --principal <name>`")


def _self_sync_url():
    """This device's reachable sync URL (Tailscale IPv4 : configured port) — carried in a
    join-request so the owner can peer back on admit. Best-effort; '' if the IP is unknown."""
    try:
        import sync_common
        port = sync_common.load_peers().get("port", 9876)
    except Exception:
        port = 9876
    try:
        out = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=5).stdout
        ip = (out.strip().splitlines() or [""])[0].strip()
    except Exception:
        ip = ""
    return f"http://{ip}:{port}" if ip else ""


def _join_request_url(device_id):
    """The reachable URL a device advertised in its join-request (last one wins), or '' if none."""
    url = ""
    for e in merkle.read_all_entries(JOURNAL_DIR):
        if e.get("type") == "governance":
            p = e.get("payload", {})
            if p.get("action") == "join-request" and p.get("device_id") == device_id and p.get("url"):
                url = p["url"]
    return url


def _add_peer(url, label):
    """Idempotently add {url} to this node's .peers.json (skips self + duplicates). Returns True if
    added. This is how admission SEEDS reciprocal peering — connectivity stays a separate concern
    from the trust grant (admit confers no governance), and the peer list remains editable."""
    if not url or url.rstrip("/") == _self_sync_url().rstrip("/"):
        return False
    path = HIVE_HOME / ".peers.json"
    try:
        cfg = json.loads(path.read_text()) if path.exists() else {}
    except Exception:
        cfg = {}
    peers = cfg.get("peers") or []
    if any(str(p.get("url", "")).rstrip("/") == url.rstrip("/") for p in peers):
        return False
    peers.append({"url": url, "id": label or url})
    cfg["peers"] = peers
    cfg.setdefault("self", NODE_ID)
    cfg.setdefault("bind", "0.0.0.0")
    cfg.setdefault("port", 9876)
    try:
        path.write_text(json.dumps(cfg, indent=2) + "\n")
    except Exception:
        return False
    return True


def admit_cmd(args):
    """Admit a device into the corroboration set and optionally tag its principal (owner-only).
    With no device_id, LIST the devices awaiting admission (their pending join-requests).
    On admit, the owner also SEEDS a reciprocal peer from the join-request's advertised URL, so
    sync is symmetric (the owner syncs to the member, not only the member to the owner)."""
    if not getattr(args, "device_id", None):
        entries = merkle.read_all_entries(JOURNAL_DIR)
        pend = _pending_admissions(entries, _governance_state(entries))
        if not pend:
            print("No devices awaiting admission.")
            return
        print(f"Devices awaiting admission ({len(pend)}):")
        for r in pend:
            print(f"  {r['device_id']}  ({r['label'] or '?'})  →  hv group admit {r['device_id']} --principal <name>")
        return
    if args.device_id in _governance_state(merkle.read_all_entries(JOURNAL_DIR))["purged"]:
        print(f"{args.device_id} is purged (tombstoned) — purge is permanent; it cannot be re-admitted.")
        return
    payload = {"action": "admit", "device_id": args.device_id}
    if args.principal:
        payload["principal"] = args.principal
    if _append_governance(payload):
        print(f"Admitted {args.device_id}" + (f" (principal: {args.principal})" if args.principal else ""))
        if _add_peer(_join_request_url(args.device_id), args.principal or args.device_id):
            print("  + reciprocal peer added from its join-request URL — the owner now syncs to "
                  "this device too (daemon picks it up next cycle, or `hv sync now`).")


def _group_change(action, device_id, principal=None):
    """Append an owner-signed membership action (revoke/deny/change/purge) + confirm. Owner-only;
    `_append_governance` signs and rebuilds so confidence re-derives over the new governance."""
    payload = {"action": action, "device_id": device_id}
    if principal:
        payload["principal"] = principal
    if not _append_governance(payload):
        return
    msg = {
        "revoke": f"Revoked {device_id} — returned to STERILE (re-admit to restore).",
        "deny":   f"Denied {device_id} — dropped from pending join-requests (a later admit overrides).",
        "change": f"Re-tagged {device_id} → principal: {principal}.",
        "purge":  f"Purged {device_id} (tombstoned) — its entries stay in the journal but no longer "
                  f"count; permanent (cannot be re-admitted).",
    }.get(action, f"{action} {device_id}")
    print(msg)


def _group_list():
    """Print the full membership roster: owner, admitted (+principals), pending, denied, purged."""
    entries = merkle.read_all_entries(JOURNAL_DIR)
    gov = _governance_state(entries)
    if not gov["owner_id"]:
        print("No owner established yet — no membership to list. Run `hv owner init`.")
        return
    print(f"hive {gov['hive_id']} — owner {gov['owner_id']}")
    print(f"admitted ({len(gov['admitted'])}):")
    for d in sorted(gov["admitted"]):
        prin = gov["principals"].get(d)
        print(f"  {d}" + (f"  (principal: {prin})" if prin else ""))
    pend = _pending_admissions(entries, gov)
    if pend:
        print(f"pending ({len(pend)}):")
        for r in pend:
            print(f"  {r['device_id']}  ({r['label'] or '?'})  →  hv group admit {r['device_id']} --principal <name>")
    if gov["denied"]:
        print(f"denied ({len(gov['denied'])}):")
        for d in sorted(gov["denied"]):
            print(f"  {d}")
    if gov["purged"]:
        print(f"purged ({len(gov['purged'])}):")
        for d in sorted(gov["purged"]):
            print(f"  {d}")


def group_cmd(args):
    """Membership lifecycle (owner-only): admit / revoke / deny / change / purge / list.
    admit reuses admit_cmd (no arg → pending list, + reciprocal-peer seeding)."""
    action = getattr(args, "group_action", None)
    if action in (None, "list"):
        _group_list()
        return
    if action == "admit":
        admit_cmd(args)
        return
    gov = _governance_state(merkle.read_all_entries(JOURNAL_DIR))
    dev = args.device_id
    if action in ("revoke", "change") and dev not in gov["admitted"]:
        print(f"{dev} is not an admitted device — nothing to {action}.")
        return
    if action == "change":
        _group_change("change", dev, args.principal)
    else:
        _group_change(action, dev)


def _config_set(key, value):
    """Set a journaled, owner-signed tunable parameter (same on every node). Owner-only. Covers the
    confidence knobs (same_device_lambda, cap_self) and the quorum-election knobs (quorum_m,
    quorum_by, dead_man_days)."""
    coercers = {"same_device_lambda": float, "cap_self": float,
                "quorum_m": int, "quorum_by": str, "dead_man_days": float}
    if key not in coercers:
        print(f"unknown config key {key!r} (known: {', '.join(sorted(coercers))})")
        return
    try:
        val = coercers[key](value)
    except (TypeError, ValueError):
        print(f"bad value for {key}: {value!r}")
        return
    if key == "quorum_by" and val not in ("device", "principal"):
        print("quorum_by must be 'device' or 'principal'")
        return
    if key == "quorum_m" and val < 0:
        print("quorum_m must be >= 0 (0 disables elections)")
        return
    if _append_governance({"action": "set-config", "key": key, "value": val}):
        print(f"set {key} = {val}")


def config_cmd(args):
    """Settings: `hv config identity show|init` (this device's key) and
    `hv config confidence set <param> <value>` (owner-signed hive params).
    `hv config set …` is kept as a silent alias for `config confidence set`."""
    action = getattr(args, "config_action", None)
    if action == "identity":
        sub = getattr(args, "config_identity_action", None) or "show"
        if sub == "init":
            _identity_init(getattr(args, "force", False))
        else:
            _identity_show()
    elif action == "confidence":
        if getattr(args, "config_confidence_action", None) == "set":
            _config_set(args.key, args.value)
        else:
            print("usage: hv config confidence set <same_device_lambda|cap_self> <value>")
    elif action == "quorum":
        if getattr(args, "config_quorum_action", None) == "set":
            _config_set(args.key, args.value)
        else:
            print("usage: hv config quorum set <quorum_m|quorum_by|dead_man_days> <value>")
    elif action == "set":            # silent back-compat alias for `config confidence set`
        _config_set(args.key, args.value)
    else:
        print("usage: hv config identity show|init  |  hv config confidence set <key> <value>  |  "
              "hv config quorum set <key> <value>")


def discover_cmd(args):
    """Scan the tailnet (via `tailscale status`) for hives — every device running a hive daemon.
    Tailscale is the device directory; a `/hive/info` probe identifies which devices run a hive."""
    try:
        out = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=10).stdout
        status = json.loads(out)
    except Exception as e:
        print(f"Could not read `tailscale status`: {e}")
        return
    ips = list(status.get("Self", {}).get("TailscaleIPs", []) or [])
    for p in (status.get("Peer") or {}).values():
        ips += p.get("TailscaleIPs", []) or []
    ips = [ip for ip in ips if ":" not in ip]   # IPv4 only for the probe
    try:
        import sync_common
        port = sync_common.load_peers().get("port", 9876)
    except Exception:
        port = 9876
    # Probe every (device, port) concurrently so the scan is bounded by one short timeout, not the
    # sum — otherwise each offline tailnet device costs a full timeout and the scan appears to hang.
    import concurrent.futures
    candidates = [(ip, p) for ip in ips for p in range(port, port + 5)]
    found = {}
    if candidates:
        print(f"  probing {len(ips)} tailnet device(s)…", file=sys.stderr)
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(32, len(candidates))) as ex:
            for ip, p, info in ex.map(lambda c: (c[0], c[1], _probe_hive(c[0], c[1], timeout=3)), candidates):
                if info and info["hive_id"] not in found:
                    found[info["hive_id"]] = {
                        "hive_id": info["hive_id"], "owner_id": info.get("owner_id"),
                        "label": info.get("label"), "node_count": info.get("node_count"),
                        "ip": ip, "port": p}
    hives = list(found.values())
    if getattr(args, "format", "text") == "json":
        print(json.dumps(hives))
        return
    if not hives:
        print(f"No hives found on this tailnet (probed {len(ips)} device(s) on :{port}).")
        return
    print(f"Hives on this tailnet ({len(hives)}):")
    local = _local_hive_id()
    for h in hives:
        mine = "  (this hive)" if h["hive_id"] == local else ""
        print(f"  {h['label'] or '?'} — hive {h['hive_id']}, owner {h['owner_id']}, "
              f"{h['node_count']} node(s), at {h['ip']}:{h['port']}{mine}")


def join_cmd(args):
    """Request to join this device's hive: emit a self-signed join-request the owner can admit.
    Non-blocking — you're already syncing the hive; your writes simply do not count toward
    confidence until the owner admits you. The request is device-signed (not owner-signed), so it
    carries no authority — it's only a visible, pending ask."""
    gov = _governance_state(merkle.read_all_entries(JOURNAL_DIR))
    if not gov["owner_id"]:
        print("No owner is established in this hive yet (have you synced it?). Nothing to join.")
        return
    if NODE_ID in gov["admitted"]:
        print(f"This device ({NODE_ID}) is already admitted.")
        return
    payload = {"action": "join-request", "device_id": NODE_ID, "label": NODE_LABEL}
    if args.principal:
        payload["requested_principal"] = args.principal
    _url = _self_sync_url()                  # advertise where we're reachable so the owner can peer back
    if _url:
        payload["url"] = _url
    append_journal("governance", payload)   # device-signed by append_journal; NOT owner-signed
    rebuild_db()
    print(f"Join request sent for {NODE_ID}. Ask the hive owner to admit you:")
    print(f"  hv admit {NODE_ID}" + (f" --principal {args.principal}" if args.principal else ""))


# --------------------------------------------------------------------------
# Telemetry — a LOCAL-ONLY observability lane, deliberately OUTSIDE the journal
# --------------------------------------------------------------------------
# Session telemetry (who/where/when + token usage + cost) is observability, NOT
# knowledge. It must never enter the facts journal/merkle: that would pollute the
# corpus, inflate confidence, and sync as "knowledge". So it lives in its own
# SQLite file under .telemetry/ that `hv rebuild` never touches and sync never sees.
# node_id is part of the primary key, so per-node stores are non-colliding shards
# that a future release can union for cross-node aggregation with no schema change.

TELEMETRY_DIR = HIVE_HOME / ".telemetry"
TELEMETRY_DB = TELEMETRY_DIR / "telemetry.db"

# Best-effort default pricing ($ per 1M tokens). Override per-node via
# .telemetry/pricing.json: {"model": {"in":N,"out":N,"cache_read":N,"cache_creation":N}}.
# cache_read defaults to ~0.1x input, cache_creation to ~1.25x input (Anthropic ratios).
_TELEMETRY_PRICES = {
    "claude-opus-4-8":   {"in": 15.0, "out": 75.0},
    "claude-sonnet-4-6": {"in": 3.0,  "out": 15.0},
    "claude-haiku-4-5":  {"in": 1.0,  "out": 5.0},
}


def telemetry_conn():
    """Open (and lazily create) the local-only telemetry DB. Separate file from store.db so
    `hv rebuild` never wipes it and sync never sees it."""
    TELEMETRY_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(TELEMETRY_DB)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    init_telemetry_db(conn)
    return conn


def init_telemetry_db(conn):
    """Idempotent telemetry schema. One row per session, keyed by the composite identity so two
    same-named agents (e.g. two `hermes`) never collapse, and so node shards merge cleanly later."""
    conn.executescript("""
    CREATE TABLE IF NOT EXISTS telemetry_sessions (
        node_id        TEXT NOT NULL,
        session_id     TEXT NOT NULL,
        agent          TEXT NOT NULL,
        agent_identity TEXT NOT NULL DEFAULT '',
        os_user        TEXT,
        ip             TEXT,
        project        TEXT,
        cwd            TEXT,
        started_at     TEXT,
        ended_at       TEXT,
        duration_s     REAL,
        tokens_in      INTEGER DEFAULT 0,
        tokens_out     INTEGER DEFAULT 0,
        cache_read     INTEGER DEFAULT 0,
        cache_creation INTEGER DEFAULT 0,
        cost_usd       REAL,
        models         TEXT,
        updated_at     TEXT,
        PRIMARY KEY (node_id, session_id, agent, agent_identity)
    );
    CREATE INDEX IF NOT EXISTS idx_tel_started ON telemetry_sessions(started_at);
    CREATE INDEX IF NOT EXISTS idx_tel_project ON telemetry_sessions(project);
    """)
    conn.commit()


def _node_ip():
    """Best-effort machine IP for telemetry: prefer the Tailscale IP, else the first `hostname -I`
    address, else ''. Never raises."""
    for cmd in (["tailscale", "ip", "-4"], ["hostname", "-I"]):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=4)
            if out.returncode == 0 and out.stdout.split():
                return out.stdout.split()[0].strip()
        except Exception:
            continue
    return ""


def _os_user():
    try:
        import getpass
        return getpass.getuser()
    except Exception:
        return os.environ.get("USER") or os.environ.get("USERNAME") or ""


def _project_for(cwd):
    """Project key: git remote basename, else cwd basename."""
    cwd = cwd or os.getcwd()
    try:
        out = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                             capture_output=True, text=True, timeout=4)
        if out.returncode == 0 and out.stdout.strip():
            base = out.stdout.strip().rstrip("/").split("/")[-1]
            return base[:-4] if base.endswith(".git") else base
    except Exception:
        pass
    return Path(cwd).name


def _locate_transcript(session_id, explicit=""):
    """Find the Claude Code transcript jsonl for a session id (or honor an explicit path)."""
    if explicit:
        p = Path(explicit).expanduser()
        return p if p.is_file() else None
    if not session_id:
        return None
    try:
        hits = list((Path.home() / ".claude" / "projects").glob(f"*/{session_id}.jsonl"))
        return hits[0] if hits else None
    except Exception:
        return None


def _sum_transcript_usage(path):
    """Sum message.usage per model from a transcript jsonl. Returns {model: {in,out,cache_read,
    cache_creation}}. Best-effort; skips the synthetic model and malformed lines."""
    models = {}
    try:
        with open(path, "r", errors="ignore") as fh:
            for line in fh:
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                msg = o.get("message") or {}
                u = msg.get("usage") or {}
                model = msg.get("model") or ""
                if not u or not model or model == "<synthetic>":
                    continue
                m = models.setdefault(model, {"in": 0, "out": 0, "cache_read": 0, "cache_creation": 0})
                m["in"] += int(u.get("input_tokens", 0) or 0)
                m["out"] += int(u.get("output_tokens", 0) or 0)
                m["cache_read"] += int(u.get("cache_read_input_tokens", 0) or 0)
                m["cache_creation"] += int(u.get("cache_creation_input_tokens", 0) or 0)
    except Exception:
        pass
    return models


def _telemetry_prices():
    prices = {k: dict(v) for k, v in _TELEMETRY_PRICES.items()}
    try:
        f = TELEMETRY_DIR / "pricing.json"
        if f.is_file():
            prices.update(json.loads(f.read_text()))
    except Exception:
        pass
    return prices


def _estimate_cost(models):
    """Best-effort $ estimate from a {model: {in,out,...}} breakdown. Returns (total or None,
    models_with_cost). Unknown models contribute nothing; total is None if NOTHING was priced."""
    prices = _telemetry_prices()
    total, priced = 0.0, False
    out = {}
    for model, t in (models or {}).items():
        entry = dict(t)
        p = prices.get(model)
        if p:
            cin = p.get("in", 0.0)
            c = (t.get("in", 0) * cin
                 + t.get("out", 0) * p.get("out", 0.0)
                 + t.get("cache_read", 0) * p.get("cache_read", cin * 0.1)
                 + t.get("cache_creation", 0) * p.get("cache_creation", cin * 1.25)) / 1_000_000.0
            entry["cost"] = round(c, 4)
            total += c
            priced = True
        out[model] = entry
    return (round(total, 4) if priced else None), out


def telemetry_cmd(args):
    """Local-only observability lane. Best-effort: never raises, never blocks a caller."""
    action = getattr(args, "telemetry_action", None)
    try:
        if action == "record":
            _telemetry_record(args)
        elif action == "list":
            _telemetry_list(args)
        else:
            _telemetry_report(args)   # default
    except Exception:
        pass


def _telemetry_record(args):
    now = _now_iso()
    node, sid = NODE_ID, (args.session or "_anon")
    agent, ident = (args.agent or "agent"), (args.identity or "")
    key = (node, sid, agent, ident)
    cwd = args.cwd or os.getcwd()
    conn = telemetry_conn()
    conn.execute(
        "INSERT OR IGNORE INTO telemetry_sessions (node_id, session_id, agent, agent_identity, "
        "os_user, ip, project, cwd, updated_at) VALUES (?,?,?,?,?,?,?,?,?)",
        (node, sid, agent, ident, _os_user(), _node_ip(), _project_for(cwd), cwd, now))
    if args.event == "start":
        conn.execute("UPDATE telemetry_sessions SET started_at=COALESCE(started_at, ?), updated_at=? "
                     "WHERE node_id=? AND session_id=? AND agent=? AND agent_identity=?", (now, now, *key))
    elif args.event == "end":
        r = conn.execute("SELECT started_at FROM telemetry_sessions WHERE node_id=? AND session_id=? "
                         "AND agent=? AND agent_identity=?", key).fetchone()
        a = _to_dt(r["started_at"]) if (r and r["started_at"]) else None
        b = _to_dt(now)
        dur = max(0.0, (b - a).total_seconds()) if (a and b) else None
        tp = _locate_transcript(sid, getattr(args, "transcript", "") or "")
        models = _sum_transcript_usage(tp) if tp else {}
        cost, models_cost = _estimate_cost(models)
        conn.execute(
            "UPDATE telemetry_sessions SET ended_at=?, duration_s=?, tokens_in=?, tokens_out=?, "
            "cache_read=?, cache_creation=?, cost_usd=?, models=?, updated_at=? "
            "WHERE node_id=? AND session_id=? AND agent=? AND agent_identity=?",
            (now, dur,
             sum(m["in"] for m in models.values()), sum(m["out"] for m in models.values()),
             sum(m["cache_read"] for m in models.values()), sum(m["cache_creation"] for m in models.values()),
             cost, json.dumps(models_cost), now, *key))
    conn.commit()
    conn.close()


def _parse_since(s):
    """'7d'|'24h'|'30m'|'2w' -> ISO cutoff (UTC), or '' for all-time. Best-effort."""
    s = (s or "").strip().lower()
    if not s:
        return ""
    try:
        from datetime import timedelta
        hours = {"d": 24, "h": 1, "w": 168, "m": 1 / 60.0}[s[-1]]
        cut = datetime.now(timezone.utc) - timedelta(hours=int(s[:-1]) * hours)
        return cut.isoformat(timespec="milliseconds")
    except Exception:
        return ""


def _telemetry_rows(since=""):
    conn = telemetry_conn()
    q = "SELECT * FROM telemetry_sessions"
    p = ()
    if since:
        q += " WHERE COALESCE(started_at, updated_at) >= ?"
        p = (since,)
    q += " ORDER BY COALESCE(started_at, updated_at) DESC"
    rows = conn.execute(q, p).fetchall()
    conn.close()
    return rows


def _fmt_dur(s):
    if not s:
        return "-"
    s = int(s)
    h, m = s // 3600, (s % 3600) // 60
    return f"{h}h{m:02d}m" if h else f"{m}m"


def _fmt_cost(c):
    return f"~${c:,.2f}" if c is not None else "n/a"


def _telemetry_report(args):
    since = _parse_since(getattr(args, "since", "") or "")
    by = getattr(args, "by", None)
    rows = _telemetry_rows(since)
    tot = {"sessions": len(rows), "dur": 0.0, "in": 0, "out": 0, "cost": 0.0, "priced": False}
    permodel, groups = {}, {}
    for r in rows:
        tot["dur"] += r["duration_s"] or 0
        tot["in"] += r["tokens_in"] or 0
        tot["out"] += r["tokens_out"] or 0
        if r["cost_usd"] is not None:
            tot["cost"] += r["cost_usd"]; tot["priced"] = True
        try:
            mm = json.loads(r["models"]) if r["models"] else {}
        except Exception:
            mm = {}
        for model, t in mm.items():
            pm = permodel.setdefault(model, {"in": 0, "out": 0, "cost": 0.0, "priced": False})
            pm["in"] += t.get("in", 0); pm["out"] += t.get("out", 0)
            if "cost" in t:
                pm["cost"] += t["cost"]; pm["priced"] = True
        if by in ("project", "agent", "node"):
            k = (r["project"] if by == "project" else
                 (f'{r["agent"]}:{r["agent_identity"]}'.rstrip(":") if by == "agent" else r["node_id"])) or "(unknown)"
            g = groups.setdefault(k, {"sessions": 0, "dur": 0.0, "in": 0, "out": 0, "cost": 0.0, "priced": False})
            g["sessions"] += 1; g["dur"] += r["duration_s"] or 0
            g["in"] += r["tokens_in"] or 0; g["out"] += r["tokens_out"] or 0
            if r["cost_usd"] is not None:
                g["cost"] += r["cost_usd"]; g["priced"] = True

    if getattr(args, "format", "text") == "json":
        print(json.dumps({"since": since or "all", "node": NODE_ID, "totals": tot,
                          "by_model": permodel, "by": by, "groups": groups}, indent=2, default=str))
        return
    print(f"hive telemetry — {('since ' + getattr(args, 'since', '')) if since else 'all time'}  (node: {NODE_ID})")
    print(f"  sessions: {tot['sessions']}   time: {_fmt_dur(tot['dur'])}   "
          f"tokens: {tot['in']:,} in / {tot['out']:,} out   cost: {_fmt_cost(tot['cost'] if tot['priced'] else None)}")
    for model, pm in sorted(permodel.items(), key=lambda kv: -(kv[1]['in'] + kv[1]['out'])):
        print(f"    {model:22s} {pm['in']:>12,} in / {pm['out']:>10,} out   {_fmt_cost(pm['cost'] if pm['priced'] else None)}")
    if by in ("project", "agent", "node") and groups:
        print(f"  by {by}:")
        for k, g in sorted(groups.items(), key=lambda kv: -kv[1]['cost']):
            print(f"    {k:24s} {g['sessions']} sess  {_fmt_dur(g['dur'])}  {_fmt_cost(g['cost'] if g['priced'] else None)}")
    if not rows:
        print("  (no telemetry recorded yet)")


def _telemetry_list(args):
    rows = _telemetry_rows("")[:(getattr(args, "limit", 0) or 20)]
    if not rows:
        print("(no telemetry recorded yet)")
        return
    for r in rows:
        who = f'{r["agent"]}:{r["agent_identity"]}'.rstrip(":")
        print(f'{(r["started_at"] or r["updated_at"] or "")[:19]}  {who}  {r["project"] or "-"}  '
              f'{_fmt_dur(r["duration_s"])}  {r["tokens_in"] or 0}/{r["tokens_out"] or 0} tok  '
              f'{_fmt_cost(r["cost_usd"])}  [{r["node_id"]}]')


