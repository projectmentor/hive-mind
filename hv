    config_conf_set = config_conf_sub.add_parser("set", help="Set same_device_lambda or cap_self")
    config_conf_set.add_argument("key", help="same_device_lambda | cap_self")
    config_conf_set.add_argument("value", help="numeric value")
    config_quorum = config_sub.add_parser("quorum", help="Set an owner-signed quorum-election parameter")
