    nudge_parser.add_argument("--session", default="", help="Session id (debounce state)")
    nudge_parser.add_argument("--cwd", default="", help="cwd for the session-start project digest")
    nudge_parser.add_argument("--agent", default="agent", help="stable agent label for the spec-update marker")

    audit_parser = subparsers.add_parser("audit", help="Surface redundant/obsolete/missing facts")
    audit_parser.add_argument("--depth", choices=["light", "normal", "deep"], default=None)
    audit_parser.add_argument("--session", default="", help="Session id (enables the MISSING proxy)")
    audit_parser.add_argument("--format", choices=["text", "json"], default="text")

    sync_parser = subparsers.add_parser("sync", help="Sync with peers (P2P)")
    sync_subparsers = sync_parser.add_subparsers(dest="sync_action")
    sync_subparsers.add_parser("now", help="One-shot bidirectional sync with all peers")
    sync_subparsers.add_parser("daemon", help="Run the sync daemon (serve + periodic sync)")

    tel_parser = subparsers.add_parser("telemetry", help="Local-only session telemetry (observability, NOT facts)")
    tel_sub = tel_parser.add_subparsers(dest="telemetry_action")
    tel_rec = tel_sub.add_parser("record", help="Record a session start/end event (for hooks)")
    tel_rec.add_argument("--event", required=True, choices=["start", "end"])
    tel_rec.add_argument("--agent", default="agent", help="agent name, e.g. claude-code, hermes")
    tel_rec.add_argument("--identity", default="", help="stable agent-instance id (keeps same-named agents distinct)")
    tel_rec.add_argument("--session", default="", help="session id")
    tel_rec.add_argument("--cwd", default="", help="working dir (for project + transcript lookup)")
    tel_rec.add_argument("--transcript", default="", help="explicit transcript path (else auto-located by session)")
    tel_rep = tel_sub.add_parser("report", help="Aggregate telemetry (this device)")
    tel_rep.add_argument("--since", default="", help="window, e.g. 7d, 24h, 30m (default: all)")
    tel_rep.add_argument("--by", choices=["project", "agent", "node"], default=None)
    tel_rep.add_argument("--format", choices=["text", "json"], default="text")
    tel_lst = tel_sub.add_parser("list", help="Recent sessions")
    tel_lst.add_argument("--limit", type=int, default=20)

    return parser


def main():
    parser = build_parser()
    # Back-compat: the old top-level `hv merkle` and `hv migrate-device-identity` now live under
    # `hv doctor` (denser surface). Rewrite their argv to the canonical subcommand so the old
    # invocations keep working without cluttering the top-level help.
    argv = sys.argv[1:]
    if argv[:1] == ["merkle"]:
        argv = ["doctor", "merkle"] + argv[1:]
    elif argv[:1] == ["migrate-device-identity"]:
        argv = ["doctor", "migrate-identity"] + argv[1:]
    elif argv[:1] == ["rebuild"]:                       # folded into `hv doctor rebuild`
        argv = ["doctor", "rebuild"] + argv[1:]
    args = parser.parse_args(argv)

    # Idempotent; also auto-migrates older DBs missing tables/indexes.
    init_db()

    if args.command == "remember":
        remember(args)
    elif args.command == "search":
        search(args)
    elif args.command == "decide":
        decide(args)
    elif args.command == "retract":
        retract(args)
    elif args.command == "entity":
        entity(args)
    elif args.command == "stats":
        stats(args)
    elif args.command == "version":
        version_cmd(args)
    elif args.command == "verify":
        verify_cmd(args)
    elif args.command == "doctor":
        doctor_cmd(args)
    elif args.command == "key":
        key_cmd(args)
    elif args.command == "owner":
        owner_cmd(args)
    elif args.command == "admit":
        admit_cmd(args)
    elif args.command == "group":
        group_cmd(args)
    elif args.command == "join":
        join_cmd(args)
    elif args.command == "config":
        config_cmd(args)
    elif args.command == "discover":
        discover_cmd(args)
    elif args.command == "nudge":
        nudge(args)
    elif args.command == "audit":
        audit(args)
    elif args.command == "sync":
        sync_cmd(args)
    elif args.command == "telemetry":
        telemetry_cmd(args)
    elif args.command == "whoami":
        whoami_cmd(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
